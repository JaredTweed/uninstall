def detect_conda(query: str) -> list[Match]:
    found: list[Match] = []
    executable = find_executable(query) if Path(query).name == query else None
    resolved = str(Path(executable).resolve()) if executable else ""
    for manager, profile in conda_environments():
        try:
            payload = json.loads(capture([
                manager, "list", "--json", "--prefix", profile,
            ]))
        except (json.JSONDecodeError, TypeError):
            continue
        if not isinstance(payload, list):
            continue
        owns_command = bool(
            resolved and path_is_within(Path(resolved), Path(profile)))
        for package in payload:
            if not isinstance(package, dict):
                continue
            ident = str(package.get("name") or "")
            if not ident:
                continue
            command_owner = owns_command and (
                Path(resolved).name == ident
                or Path(resolved).name.startswith(ident + "-"))
            if relevant(query, ident) or command_owner:
                found.append(Match(
                    "Conda", ident, ident,
                    str(package.get("version") or ""), "user",
                    provides=(str(Path(executable).absolute())
                              if command_owner and executable else ""),
                    origin=str(package.get("channel") or ""),
                    profile=profile,
                ))
    return found


