@synchronized_lru_cache(maxsize=1)
def apt_inventory() -> tuple[AptPackageRecord, ...]:
    fmt = (
        "${db:Status-Abbrev}\\t${binary:Package}\\t${Version}\\t"
        "${binary:Summary}\\t${Installed-Size}\\t${Depends}\\t"
        "${Pre-Depends}\\t${Provides}\\n"
    )
    records: list[AptPackageRecord] = []
    for line in capture(["dpkg-query", "-W", "-f=" + fmt]).splitlines():
        fields = line.split("\t", 7)
        if len(fields) == 6 and fields[0] == "P":
            status, ident, depends, pre_depends, provides = fields[1:]
            if len(status) > 1 and status[1] == "i" and ident:
                records.append(AptPackageRecord(
                    ident, "", "", None,
                    depends, pre_depends, provides,
                ))
            continue
        if len(fields) == 4:
            status, ident, version, summary = fields
            if len(status) > 1 and status[1] == "i" and ident:
                records.append(AptPackageRecord(
                    ident, version, summary, None))
            continue
        installed = fields and len(fields[0]) > 1 and fields[0][1] == "i"
        if not installed or len(fields) != 8:
            continue
        records.append(AptPackageRecord(
            ident=fields[1],
            version=fields[2],
            summary=fields[3],
            size_bytes=(int(fields[4]) * 1024
                        if fields[4].isdigit() else None),
            depends=fields[5],
            pre_depends=fields[6],
            provides=fields[7],
        ))
    return tuple(records)


@synchronized_lru_cache(maxsize=1)
def apt_inventory_by_name() -> dict[str, AptPackageRecord]:
    return {record.ident: record for record in apt_inventory()}


def detect_dpkg(query: str) -> list[Match]:
