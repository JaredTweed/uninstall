def parse_slackware_size(value: str) -> int | None:
    parsed = parse_size(value)
    if parsed is not None:
        return parsed
    match = re.search(r"(?i)(\d+(?:\.\d+)?)\s*([KMGT])\b", value)
    if not match:
        return None
    return int(float(match.group(1)) * (1024 ** ("KMGT".index(
        match.group(2).upper()) + 1)))


def split_slackware_pkgname(value: str) -> tuple[str, str]:
    fields = value.rsplit("-", 3)
    return (fields[0], fields[1]) if len(fields) == 4 else (value, "")


def parse_slackware_package_log(
        text: str, fallback_name: str,
) -> PackageRecord:
    package_line = next((
        line.partition(":")[2].strip()
        for line in text.splitlines()
        if line.startswith("PACKAGE NAME:")
    ), fallback_name)
    name, version = split_slackware_pkgname(package_line)
    size_line = next((
        line.partition(":")[2].strip()
        for line in text.splitlines()
        if line.startswith("UNCOMPRESSED PACKAGE SIZE:")
    ), "")
    description = ""
    file_lines: list[str] = []
    in_description = False
    in_files = False
    for line in text.splitlines():
        if line == "PACKAGE DESCRIPTION:":
            in_description, in_files = True, False
            continue
        if line == "FILE LIST:":
            in_description, in_files = False, True
            continue
        if in_description and not description and ":" in line:
            description = line.split(":", 1)[1].strip()
        elif in_files and line and not line.endswith("/"):
            file_lines.append("/" + line.lstrip("./"))
    return PackageRecord(
        name, version, description, parse_slackware_size(size_line),
        files=tuple(file_lines),
    )


