@lru_cache(maxsize=64)
def npm_install_source(ident: str) -> str:
    root = npm_global_root()
    if not root:
        return ""
    lock_path = Path(root) / ".package-lock.json"
    try:
        payload = json.loads(lock_path.read_text(
            encoding="utf-8", errors="replace"))
    except (OSError, json.JSONDecodeError, TypeError):
        return ""
    packages = payload.get("packages", {}) if isinstance(payload, dict) else {}
    key = f"node_modules/{ident}"
    details = packages.get(key, {}) if isinstance(packages, dict) else {}
    return str(details.get("resolved") or "") if isinstance(details, dict) else ""


