    if not shutil.which("removepkg"):
        return ()
    roots = (Path("/var/lib/pkgtools/packages"), Path("/var/log/packages"))
    root = next((candidate for candidate in roots if candidate.is_dir()), None)
    if root is None:
        return ()
    try:
        paths = tuple(root.iterdir())
    except OSError:
        return ()
    records: list[PackageRecord] = []
    for path in paths:
        if not path.is_file():
            continue
        text = read_first(path)
        records.append(parse_slackware_package_log(text, path.name))
    return tuple(records)


