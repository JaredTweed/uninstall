def read_first(path: Path) -> str:
    try:
        return path.read_text(
            encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def portage_prefix() -> Path:
    return Path(os.environ.get("EPREFIX") or "/")


def portage_scope() -> str:
    prefix = portage_prefix().expanduser().absolute()
    return "user" if path_is_within(prefix, Path.home()) else "system"


def parse_portage_vdb(root: Path) -> tuple[PackageRecord, ...]:
    records: list[PackageRecord] = []
    try:
        categories = tuple(root.iterdir())
    except OSError:
        return ()
    for category in categories:
        if not category.is_dir():
            continue
        try:
            packages = tuple(category.iterdir())
        except OSError:
            continue
        for package in packages:
            if not package.is_dir():
                continue
            package_full = read_first(package / "PF") or package.name
            name = read_first(package / "PN")
            version = read_first(package / "PVR")
            if not name:
                match = re.match(r"^(.+)-([0-9].*)$", package_full)
                if match:
                    name, inferred_version = match.groups()
                    version = version or inferred_version
            elif not version and package_full.startswith(name + "-"):
                version = package_full[len(name) + 1:]
            if not name:
                continue
            raw_size = read_first(package / "SIZE")
            records.append(PackageRecord(
                ident=f"{category.name}/{name}",
                version=version,
                summary=read_first(package / "DESCRIPTION"),
                size_bytes=int(raw_size) if raw_size.isdigit() else None,
                origin=read_first(package / "repository"),
                files=(str(package / "CONTENTS"),),
            ))
    return tuple(records)


