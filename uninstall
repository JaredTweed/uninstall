def explicit_install_reason(item: Match) -> str:
    target = package_base(item.ident)
    if item.kind == "DNF":
        record = dnf_install_record(target)
        if record:
            if record.reason.casefold() not in {
                    "user", "external user", "external"}:
                return (
                    "currently marked explicitly installed by DNF; "
                    f"originally installed in DNF transaction "
                    f"{record.transaction_id}: "
                    f"{compact_history_command(record.command)} "
                    f"(recorded reason: {record.reason})"
                )
            source = (
                f" from {record.repository}"
                if record.repository and not record.repository.startswith("@")
                else ""
            )
            return (
                f"explicitly installed{source}; "
                f"DNF transaction {record.transaction_id}: "
                f"{compact_history_command(record.command)}"
            )
        if not shutil.which("dnf5") and shutil.which("dnf"):
            event = legacy_rpm_history_event("dnf", target)
            if event:
                return (
                    f"marked explicitly installed by DNF; "
                    f"DNF transaction {event[0]}: "
                    f"{compact_history_command(event[1])}"
                )
        return (
            "marked explicitly installed by DNF; "
            "original installation command unavailable"
        )
    if item.kind == "APT":
        return recorded_event(
            "marked manually installed by APT",
            apt_history_event(target),
        ).replace("recorded", "APT history", 1)
    if item.kind == "Pacman":
        return recorded_event(
            "Pacman marks it explicitly installed",
            pacman_history_event(target),
        ).replace("recorded", "pacman log", 1)
    if item.kind == "APK":
        constraint = apk_explicit_causes().get(item.ident, item.ident)
        if constraint == item.ident:
            return (
                "listed explicitly in /etc/apk/world; "
                "original APK command unavailable"
            )
        return (
            f"installed to satisfy explicit /etc/apk/world constraint "
            f"{constraint}; original APK command unavailable"
        )
    if item.kind == "OPKG":
        return (
            "marked as a user-installed package in the OPKG status database; "
            "original command unavailable"
        )
    if item.kind == "XBPS":
        return (
            "marked manually installed in the XBPS package database; "
            "original install command unavailable"
        )
    if item.kind == "Portage":
        source = f" from {item.origin}" if item.origin else ""
        return (
            f"selected explicitly in the Portage @world set{source}; "
            "original emerge command unavailable"
        )
    if item.kind == "Eopkg":
        return (
            "marked as explicitly installed by Eopkg; "
            "original command unavailable"
        )
    if item.kind == "Swupd":
        return (
            "explicitly tracked as an installed Clear Linux bundle; "
            "original swupd command unavailable"
        )
    if item.kind == "Zypper":
        return recorded_event(
            "marked explicitly installed by Zypper",
            zypper_history_event(target),
        ).replace("recorded", "Zypper history", 1)
    if item.kind == "YUM":
        event = legacy_rpm_history_event("yum", target)
        if event:
            return (
                f"marked explicitly installed by YUM; "
                f"YUM transaction {event[0]}: "
                f"{compact_history_command(event[1])}"
            )
        return (
            "marked explicitly installed by YUM; "
            "original installation command unavailable"
        )
    if item.kind == "RPM":
        date, vendor = rpm_install_metadata(item.ident)
        when = f" on {date}" if date else ""
        source = f"; package vendor {vendor}" if vendor else ""
        return (
            f"installed directly in the RPM database{when}{source}; "
            "original command and reason were not recorded"
        )
    if item.kind == "RPM-OSTree":
        return (
            "explicitly layered in the current rpm-ostree deployment; "
            "original command unavailable"
        )
    if item.kind == "Flatpak":
        remote, event = flatpak_install_evidence(
            item.ident, item.scope, item.installation)
        source = f" from {remote}" if remote else ""
        base = (
            f"explicitly installed{source} as a {item.scope} Flatpak"
            + (f" in installation {item.installation}" if item.installation else "")
        )
        return f"{base}; {event}" if event else (
            f"{base}; original install event unavailable")
    if item.kind == "Snap":
        tracking, publisher, change = snap_install_evidence(item.ident)
        details = ["installed from the Snap Store"]
        if tracking:
            details.append(f"{tracking} channel")
        if publisher:
            details.append(f"published by {publisher}")
        base = ", ".join(details)
        return f"{base}; {change}" if change else (
            f"{base}; original install change unavailable")
    if item.kind in {"Homebrew", "Homebrew Cask"}:
        tap, requested = homebrew_install_evidence(item.kind, item.ident)
        label = "Homebrew Cask" if item.kind == "Homebrew Cask" else "Homebrew"
        source = f" from {tap}" if tap else ""
        state = (
            "records it as installed on request"
            if requested is True else
            "does not retain a reliable original-request record"
        )
        return f"installed with {label}{source}; Homebrew {state}"
    if item.kind == "Nix":
        metadata = nix_profile_metadata(item.profile).get(item.ident, {})
        original = str(
            metadata.get("originalUrl")
            or metadata.get("original_url")
            or "")
        attribute = str(
            metadata.get("attrPath")
            or metadata.get("attr_path")
            or "")
        source = original + (f"#{attribute}" if attribute else "")
        return (
            f"explicit Nix profile entry from {source}; "
            + (f"profile {item.profile}" if item.profile else "current Nix profile")
            if source else
            f"explicit entry in Nix profile {item.profile or 'current'}; "
            "original source unavailable"
        )
    if item.kind == "Nix Legacy":
        source = f" at {item.origin}" if item.origin else ""
        return (
            f"explicit entry in the legacy Nix user profile{source}; "
            "original nix-env command unavailable"
        )
    if item.kind == "Guix":
        return (
            f"explicit entry in Guix profile {item.origin}; "
            "original Guix transaction command unavailable"
        )
    if item.kind == "Cargo":
        source = cargo_install_source(item.ident)
        return (
            "explicitly installed with Cargo from "
            f"{friendly_cargo_source(source)}; crate {item.ident}"
            if source else
            f"explicitly installed with Cargo; crate {item.ident}; "
            "recorded source unavailable"
        )
    if item.kind == "Pipx":
        source = pipx_install_source(item.ident, item.scope)
        if source:
            origin = (
                f"PyPI package {source}"
                if re.fullmatch(r"[A-Za-z0-9_.-]+", source)
                else source
            )
            return (
                f"explicitly installed with pipx from {origin}; "
                f"environment {item.ident}"
            )
        return (
            f"top-level pipx environment {item.ident}; "
            "original package source unavailable"
        )
    if item.kind == "UV Tool":
        return (
            f"explicitly installed as uv tool {item.ident}; isolated tool "
            "environment; original package specification unavailable"
        )
    if item.kind == "NPM":
        source = npm_install_source(item.ident)
        return (
            f"top-level global npm package resolved from {source}; "
            "original install command unavailable"
            if source else
            "present as a top-level global npm package; "
            "original install command and registry unavailable"
        )
    if item.kind == "Gear Lever":
        source = f"; update source {item.origin}" if item.origin else ""
        unavailable = "" if item.origin else "; original download source unavailable"
        return (
            f"managed by Gear Lever at {item.path or item.ident}"
            f"{source}{unavailable}"
        )
    if item.kind == "AppImage":
        return (
            f"standalone AppImage at {item.path or item.ident}; "
            "no package manager or installation history found"
        )
    if item.kind == "Container Export":
        return (
            f"exported to the host from {item.origin}; the application is "
            "installed inside that container"
        )
    if item.kind == "Swupd 3rd-party":
        return (
            f"explicitly installed from Swupd third-party repository "
            f"{item.origin}; original bundle-add command unavailable"
        )
    if item.kind == "Standalone":
        return (
            f"unmanaged executable at {item.path or item.ident}; "
            "no supported installer owns it and its original source is unknown"
        )
    return (
        f"top-level {item.kind} installation; "
        "original installation source unavailable"
    )


def dependency_install_reason(item: Match) -> str:
    if item.kind == "Eopkg":
        ok, automatic = eopkg_automatic_packages()
        parent = automatic.get(item.ident, "") if ok else ""
        if parent:
            return (
                f"installed automatically for {parent}; "
                "original Eopkg command unavailable"
            )
    report = dependency_report(item)
    cause = compact_dependency_cause(report)
    if not cause:
        cause = (
            "no installed package currently requires it"
            if report.complete else
            "installed automatically as an optional dependency"
            if item.role == "weak dependency" else
            "installed automatically as a dependency"
        )
    if item.kind == "DNF" and report.history_reason:
        return f"{cause}; {report.history_reason}"
    if item.kind == "DNF" and not shutil.which("dnf5") \
            and shutil.which("dnf"):
        event = legacy_rpm_history_event(
            "dnf", package_base(item.ident))
        if event:
            return (
                f"{cause}; DNF transaction {event[0]}: "
                f"{compact_history_command(event[1])}"
            )
    if item.kind == "YUM":
        event = legacy_rpm_history_event(
            "yum", package_base(item.ident))
        if event:
            return (
                f"{cause}; YUM transaction {event[0]}: "
                f"{compact_history_command(event[1])}"
            )
    if item.kind == "APT":
        event = apt_history_event(package_base(item.ident))
        detail = (
            f"; APT history{f' {event[0]}' if event and event[0] else ''}: "
            f"{compact_history_command(event[1])}" if event else
            "; APT marks it automatically installed; "
            "original install event unavailable"
        )
        return cause + detail
    if item.kind == "Pacman":
        event = pacman_history_event(package_base(item.ident))
        detail = (
            f"; pacman log{f' {event[0]}' if event and event[0] else ''}: "
            f"{compact_history_command(event[1])}" if event else
            "; Pacman records it as a dependency; "
            "original install event unavailable"
        )
        return cause + detail
    if item.kind == "APK":
        return (
            f"{cause}; absent from /etc/apk/world and therefore managed "
            "automatically by APK; original install command unavailable"
        )
    if item.kind == "OPKG":
        return (
            f"{cause}; OPKG marks it automatically installed; "
            "original install command unavailable"
        )
    if item.kind == "XBPS":
        return (
            f"{cause}; XBPS marks it automatically installed; "
            "original install command unavailable"
        )
    if item.kind == "Portage":
        return (
            f"{cause}; absent from the Portage @world set; "
            "original emerge command unavailable"
        )
    if item.kind == "Eopkg":
        return (
            f"{cause}; Eopkg marks it automatically installed; "
            "original command unavailable"
        )
    if item.kind == "Zypper":
        event = zypper_history_event(package_base(item.ident))
        detail = (
            f"; Zypper history{f' {event[0]}' if event and event[0] else ''}: "
            f"{compact_history_command(event[1])}" if event else
            "; Zypper records it as a dependency; "
            "original install event unavailable"
        )
        return cause + detail
    if item.kind == "Homebrew":
        tap, _requested = homebrew_install_evidence(
            item.kind, item.ident)
        source = f" from {tap}" if tap else ""
        return (
            f"{cause}; installed with Homebrew{source} as a dependency; "
            "original command unavailable"
        )
    return (
        f"{cause}; {item.kind} records it as a dependency; "
        "original install event unavailable"
    )


def archive_evidence(item: Match, reason: str) -> str:
    if not item.archive:
        return reason
    archive = display(item.archive)
    if archive in reason or item.archive.name in reason:
        return reason
    return (
        f"{reason}; supplied archive {archive} matches this installed package "
        "but is not proven to be its original source"
    )


def install_reason(item: Match) -> str:
    if item.role == "explicit":
        return archive_evidence(item, explicit_install_reason(item))
    if item.role == "external":
        if item.kind == "DNF":
            record = dnf_install_record(package_base(item.ident))
            if record:
                original = (
                    "installed from a local or external RPM"
                    if record.reason.casefold() in {
                        "external", "external user"}
                    else
                    "currently marked as externally installed by DNF; "
                    f"original recorded reason: {record.reason}"
                )
                return archive_evidence(
                    item,
                    f"{original}; "
                    f"DNF transaction {record.transaction_id}: "
                    f"{compact_history_command(record.command)}",
                )
            date, vendor = rpm_install_metadata(item.ident)
            metadata = (
                f"; RPM database install time {date}" if date else "")
            metadata += f"; package vendor {vendor}" if vendor else ""
            return archive_evidence(
                item,
                "DNF records it as installed by an external tool"
                f"{metadata}; original tool and source unavailable",
            )
        return archive_evidence(
            item,
            f"installed outside {item.kind}; original source unavailable",
        )
    if item.role == "group":
        return archive_evidence(item, (
            dnf_group_install_reason(package_base(item.ident))
            if item.kind == "DNF"
            else "installed as part of a package group"
        ))
    if item.role not in {"dependency", "weak dependency"}:
        if item.kind == "RPM":
            date, vendor = rpm_install_metadata(item.ident)
            metadata = (
                f"RPM database install time {date}" if date else
                "present in the RPM database"
            )
            metadata += f"; package vendor {vendor}" if vendor else ""
            return archive_evidence(
                item,
                f"{metadata}; RPM does not record whether it was explicitly "
                "requested; original command and source unavailable",
            )
        if item.kind == "Slackware":
            return archive_evidence(
                item,
                "registered in the Slackware pkgtools database; pkgtools "
                "does not record explicit/dependency state or the original source",
            )
        if item.kind == "Eopkg":
            return archive_evidence(
                item,
                "registered in the Eopkg package database; a reliable "
                "explicit-install marker and original command are unavailable",
            )
        if item.kind == "OPKG":
            return archive_evidence(
                item,
                "present in the OPKG base image or installed database; "
                "explicit/dependency state and original command are unavailable",
            )
        if item.kind == "Conda":
            channel = f" from channel {item.origin}" if item.origin else ""
            return archive_evidence(
                item,
                f"installed in Conda environment {item.profile}{channel}; "
                "Conda metadata does not retain whether it was directly "
                "requested or the original command",
            )
        if item.kind in {"URPMI", "APT-RPM"}:
            date, vendor = rpm_install_metadata(item.ident)
            detail = f" on {date}" if date else ""
            source = f"; package vendor {vendor}" if vendor else ""
            return archive_evidence(
                item,
                f"present in the RPM database{detail}{source}; this frontend "
                "did not expose reliable install-reason history",
            )
        return archive_evidence(
            item,
            f"{item.kind} did not record an installation reason; "
            "original source unavailable",
        )
    return archive_evidence(item, dependency_install_reason(item))


def add_install_reasons(matches: list[Match]) -> list[Match]:
    tasks: list[Callable[[], object]] = []
    dnf_items = [item for item in matches if item.kind == "DNF"]
    if dnf_items:
        targets = tuple(package_base(item.ident) for item in dnf_items)
        tasks.append(lambda: prefetch_dnf_install_records(targets))
        if any(item.role == "group" for item in dnf_items):
            tasks.extend((
                dnf_installed_group_inventory,
                dnf_installed_environment_inventory,
            ))
    for scope, installation in {
            (item.scope, item.installation)
            for item in matches if item.kind == "Flatpak"}:
        tasks.append(lambda scope=scope, installation=installation:
                     flatpak_history_entries(scope, installation))
    kinds = {item.kind for item in matches}
    if "Snap" in kinds:
        tasks.append(snap_changes)
    if "APT" in kinds:
        tasks.append(apt_history_index)
    if "Pacman" in kinds:
        tasks.append(pacman_history_index)
    if "Zypper" in kinds:
        tasks.append(zypper_history_index)
    if tasks:
        with ThreadPoolExecutor(max_workers=min(4, len(tasks))) as executor:
            futures = [executor.submit(task) for task in tasks]
            for future in futures:
                future.result()
    if len(matches) < 2:
        return [replace(item, reason=install_reason(item)) for item in matches]
    with ThreadPoolExecutor(max_workers=min(4, len(matches))) as executor:
        reasons = executor.map(install_reason, matches)
        return [
            replace(item, reason=reason)
            for item, reason in zip(matches, reasons)
        ]


def decorate_matches(matches: list[Match]) -> list[Match]:
    """Add provenance and sizes concurrently while retaining result order."""
    with ThreadPoolExecutor(max_workers=2) as executor:
        reasons_future = executor.submit(add_install_reasons, matches)
        sizes_future = executor.submit(add_installed_sizes, matches)
        reasoned = reasons_future.result()
        sized = sizes_future.result()
    return [
        replace(item, size_bytes=size.size_bytes)
        for item, size in zip(reasoned, sized)
    ]


def parse_dnf_preview(output: str) -> tuple[list[str], list[str]]:
    removals: list[str] = []
    orphans: list[str] = []
    section = ""
    for raw_line in output.splitlines():
        line = raw_line.strip()
        lowered = line.casefold()
        if lowered in {
            "removing:", "removing dependent packages:",
            "removing unused dependencies:",
        }:
            section = lowered
            continue
        if not line:
            if section:
                section = ""
            continue
        if not section or lowered.startswith(("package ", "transaction ")):
            continue
        package = line.split()[0]
        if package and package not in {"Removing:", "After"}:
            removals.append(package)
            if section == "removing unused dependencies:":
                orphans.append(package)
    return list(dict.fromkeys(removals)), list(dict.fromkeys(orphans))


def parse_zypper_preview(output: str) -> list[str]:
    """Read Zypper's stable XML transaction summary."""
    try:
        root = ET.fromstring(output)
    except ET.ParseError:
        return []
    removals: list[str] = []
    for section in root.iter("to-remove"):
        for solvable in section.iter("solvable"):
            if solvable.attrib.get("type", "package") != "package":
                continue
            name = solvable.attrib.get("name", "").strip()
            architecture = solvable.attrib.get("arch", "").strip()
            if name:
                removals.append(
                    f"{name}.{architecture}" if architecture else name)
    return list(dict.fromkeys(removals))


def native_removal_preview(
        selected: list[Match], cleanup_kinds: set[str] | None = None,
) -> PreviewResult:
    cleanup_kinds = cleanup_kinds or set()
    planned: list[str] = []
    orphans: list[str] = []
    available = True
    notes: list[str] = []
    blockers: list[str] = []
    statuses: list[PreviewStatus] = []
    by_kind: dict[tuple[str, str, str, str], list[str]] = defaultdict(list)
    for item in selected:
        by_kind[(
            item.kind, item.scope, item.installation, item.profile,
        )].append(item.ident)
    for (kind, _scope, _installation, _profile), identifiers in by_kind.items():
        immutable_model, immutable_note = immutable_host()
        if kind == "Pacman" and immutable_model == "SteamOS" \
                and os.environ.get("UNINSTALL_ALLOW_EPHEMERAL_HOST_CHANGES") != "1":
            statuses.append(PreviewStatus.BLOCKED)
            notes.append(
                immutable_note + " Use the image-supported workflow, or set "
                "UNINSTALL_ALLOW_EPHEMERAL_HOST_CHANGES=1 if you deliberately "
                "accept an ephemeral host change."
            )
            continue
        if kind in {"DNF", "YUM"}:
            manager = (dnf_binary() or "dnf") if kind == "DNF" else "yum"
            code, output = capture_any(
                [manager, "--assumeno", "remove"] + identifiers)
            removed, unused = parse_dnf_preview(output)
            if removed:
                planned.extend(removed)
                orphans.extend(unused)
                statuses.append(PreviewStatus.EXACT)
            else:
                available = False
                statuses.append(
                    PreviewStatus.FAILED if code not in {0, 1}
                    else PreviewStatus.UNKNOWN)
                notes.append(f"{kind} could not produce a removal transaction preview.")
            if code == 124:
                notes.append(f"{kind} preview timed out.")
        elif kind in {"APT", "APT-RPM"}:
            action = "purge" if "APT" in cleanup_kinds else "remove"
            code, output = capture_any(
                ["apt-get", "--simulate", action] + identifiers)
            removed = [
                line.split()[1] for line in output.splitlines()
                if line.startswith("Remv ") and len(line.split()) > 1
            ]
            if code == 0:
                planned.extend(removed or identifiers)
                statuses.append(PreviewStatus.EXACT)
                if os.geteuid() != 0:
                    notes.append(
                        "APT warns that a non-root simulation can miss unreadable configuration."
                    )
            else:
                available = False
                statuses.append(PreviewStatus.FAILED)
                notes.append("APT simulation failed; its final prompt remains authoritative.")
        elif kind == "Pacman":
            code, output = capture_any(
                ["pacman", "-R", "--print", "--print-format", "%n"] + identifiers)
            removed = [
                line.strip() for line in output.splitlines()
                if line.strip() and " " not in line.strip()
            ]
            if code == 0:
                planned.extend(removed or identifiers)
                statuses.append(PreviewStatus.EXACT)
            else:
                available = False
                statuses.append(PreviewStatus.BLOCKED)
                notes.append(
                    "Pacman rejected the preview, usually because another package requires the target."
                )
        elif kind == "APK":
            code, output = capture_any(
                ["apk", "del", "--simulate"] + identifiers)
            removed = [
                match.group(1)
                for line in output.splitlines()
                for match in [re.search(
                    r"\b(?:Purging|Removing)\s+([A-Za-z0-9+_.-]+)",
                    line,
                )]
                if match
            ]
            if code == 0 and removed:
                planned.extend(removed)
                orphans.extend(
                    name for name in removed if name not in identifiers)
                statuses.append(PreviewStatus.EXACT)
            elif code == 0:
                available = False
                blocked_patterns = (
                    r"(?i)(?:required|needed) by\s+([^\n.]+)",
                    r"(?i)not (?:being )?removed[^\n]*because\s+([^\n.]+)",
                    r"(?i)([^:\n]+):\s*(?:breaks|is required by|required by)\s+([^\n]+)",
                )
                for pattern in blocked_patterns:
                    for match in re.finditer(pattern, output):
                        blockers.append(" ".join(match.groups()).strip())
                if blockers or re.search(
                        r"(?i)(not removed|cannot remove|breaks:|required by)",
                        output):
                    statuses.append(PreviewStatus.BLOCKED)
                    notes.append(
                        "APK will not remove the requested package because an "
                        "installed package still requires it."
                    )
                else:
                    statuses.append(PreviewStatus.NOOP)
                    notes.append(
                        "APK completed the simulation without scheduling any removal."
                    )
            else:
                available = False
                statuses.append(PreviewStatus.BLOCKED)
                notes.append("APK rejected the simulated removal.")
        elif kind == "OPKG":
            code, output = capture_any(
                ["opkg", "--noaction", "remove"] + identifiers)
            removed = [
                match.group(1)
                for line in output.splitlines()
                for match in [re.search(
                    r"\bRemoving package ([A-Za-z0-9+_.-]+)", line)]
                if match
            ]
            if code == 0 and removed:
                planned.extend(removed)
                statuses.append(PreviewStatus.EXACT)
            elif code == 0:
                planned.extend(identifiers)
                available = False
                statuses.append(PreviewStatus.UNKNOWN)
                notes.append(
                    "OPKG completed a no-action test, but its removal output "
                    "could not be parsed reliably."
                )
            else:
                available = False
                statuses.append(PreviewStatus.BLOCKED)
                notes.append(
                    "OPKG rejected the no-action removal, usually because "
                    "another package requires the target."
                )
        elif kind == "XBPS":
            code, output = capture_any(
                ["xbps-remove", "--dry-run", "--recursive"] + identifiers)
            removed: list[str] = []
            for line in output.splitlines():
                fields = line.split()
                if len(fields) >= 2 and fields[1].casefold() in {
                        "remove", "removed", "uninstall"}:
                    removed.append(split_xbps_pkgver(fields[0])[0])
            if code == 0 and removed:
                planned.extend(removed)
                orphans.extend(
                    name for name in removed if name not in identifiers)
                statuses.append(PreviewStatus.EXACT)
            elif code == 0:
                planned.extend(identifiers)
                available = False
                statuses.append(PreviewStatus.UNKNOWN)
                notes.append(
                    "XBPS completed a dry-run, but its additional removals "
                    "could not be parsed reliably."
                )
            else:
                available = False
                statuses.append(PreviewStatus.BLOCKED)
                notes.append(
                    "XBPS rejected the dry-run, usually because reverse "
                    "dependencies prevent removal."
                )
        elif kind == "Portage":
            atoms = [
                "=" + item.ident + (f"-{item.version}" if item.version else "")
                for item in selected if item.kind == kind
            ]
            code, _output = capture_any([
                "emerge", "--pretend", "--verbose", "--depclean", *atoms,
            ])
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNKNOWN)
            notes.append(
                "Portage completed a dependency-aware depclean preview, but "
                "its removal set is intentionally left to emerge's final output."
                if code == 0 else
                "Portage rejected the dependency-aware depclean preview."
            )
        elif kind == "Slackware":
            code, _output = capture_any(
                ["removepkg", "-warn"] + identifiers)
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNKNOWN)
            notes.append(
                "Slackware previewed package files, but pkgtools does not "
                "track dependency impact."
                if code == 0 else "Slackware's removepkg preview failed."
            )
        elif kind == "Eopkg":
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNKNOWN)
            action = ["eopkg", "--no-color", "remove", "--dry-run"]
            if "Eopkg" in cleanup_kinds:
                action.append("--purge")
            code, _output = capture_any([
                *action, *identifiers,
            ])
            notes.append(
                "Eopkg completed a dry-run, but its removal set could not be "
                "parsed reliably."
                if code == 0 else "Eopkg's dry-run failed."
            )
        elif kind == "Swupd":
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNSUPPORTED)
            notes.append(
                "Swupd checks installed bundle dependents during removal but "
                "does not expose a read-only removal transaction."
            )
        elif kind == "Swupd 3rd-party":
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNSUPPORTED)
            notes.append(
                "Swupd checks third-party bundle removal at execution time; "
                "no read-only transaction is available."
            )
        elif kind == "Zypper":
            code, output = capture_any(
                [
                    "zypper", "--xmlout", "--non-interactive",
                    "remove", "--dry-run",
                ]
                + identifiers)
            removed = parse_zypper_preview(output)
            if code == 0 and removed:
                planned.extend(removed)
                statuses.append(PreviewStatus.EXACT)
                if immutable_note:
                    notes.append(immutable_note)
            else:
                available = False
                statuses.append(
                    PreviewStatus.FAILED if code else PreviewStatus.UNKNOWN)
                notes.append(
                    "Zypper dry-run failed."
                    if code else
                    "Zypper completed a dry-run, but its XML removal set "
                    "could not be parsed reliably."
                )
        elif kind == "URPMI":
            code, _output = capture_any([
                "urpme", "--test", *identifiers,
            ])
            planned.extend(identifiers)
            available = False
            statuses.append(
                PreviewStatus.UNKNOWN if code == 0 else PreviewStatus.BLOCKED)
            notes.append(
                "URPMI accepted its test transaction, but did not expose a "
                "stable machine-readable removal set."
                if code == 0 else "URPMI rejected the test removal."
            )
        elif kind == "RPM-OSTree":
            code, _output = capture_any(
                ["rpm-ostree", "uninstall", "--dry-run"] + identifiers)
            if code == 0:
                planned.extend(identifiers)
                statuses.append(PreviewStatus.EXACT)
                if immutable_note:
                    notes.append(immutable_note)
            else:
                available = False
                statuses.append(PreviewStatus.FAILED)
                notes.append("rpm-ostree did not provide a usable dry-run.")
        elif kind == "RPM":
            code, _output = capture_any(
                ["rpm", "-e", "--test"] + identifiers)
            if code == 0:
                planned.extend(identifiers)
                statuses.append(PreviewStatus.EXACT)
            else:
                available = False
                statuses.append(PreviewStatus.BLOCKED)
                notes.append(
                    "RPM's test transaction rejected the removal, usually because "
                    "another package requires the target."
                )
        elif kind == "Snap":
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNSUPPORTED)
            notes.append(
                "Snap bases and content providers are checked by snapd only during removal."
            )
        elif kind == "Flatpak":
            planned.extend(identifiers)
            statuses.append(PreviewStatus.EXACT)
            notes.append(
                "Flatpak can also remove app-specific related extensions; "
                "shared runtimes are not removed by this command."
            )
        elif kind in {"Nix", "Nix Legacy", "Guix"}:
            planned.extend(identifiers)
            statuses.append(PreviewStatus.EXACT)
            notes.append(
                "Guix removes profile entries by creating a new profile "
                 "generation; store items remain until garbage collection."
                 if kind == "Guix" else
                 "Nix removes the profile entries; unreachable store paths "
                 "remain until garbage collection."
            )
        elif kind == "Conda":
            manager = "conda" if shutil.which("conda") else "micromamba"
            code, output = capture_any([
                manager, "remove", "--dry-run", "--json", "--prefix",
                _profile, *identifiers,
            ])
            try:
                payload = json.loads(output)
            except (json.JSONDecodeError, TypeError):
                payload = {}
            actions = payload.get("actions", {}) if isinstance(payload, dict) else {}
            unlink = actions.get("UNLINK", []) if isinstance(actions, dict) else []
            removed = [
                str(entry.get("name")) for entry in unlink
                if isinstance(entry, dict) and entry.get("name")
            ] if isinstance(unlink, list) else []
            if code == 0 and removed:
                planned.extend(removed)
                orphans.extend(
                    name for name in removed if name not in identifiers)
                statuses.append(PreviewStatus.EXACT)
            elif code == 0:
                statuses.append(PreviewStatus.NOOP)
                notes.append("Conda did not schedule any package removal.")
            else:
                statuses.append(PreviewStatus.FAILED)
                notes.append("Conda could not produce a removal preview.")
        elif kind in {
            "Homebrew Cask", "Cargo", "Pipx",
            "UV Tool", "NPM", "AppImage", "Gear Lever",
        }:
            planned.extend(identifiers)
            statuses.append(PreviewStatus.EXACT)
            if kind == "Gear Lever":
                notes.append(
                    "Gear Lever will trash the AppImage when possible and remove its "
                    "desktop entry, icon, and update metadata."
                )
        elif kind == "Homebrew":
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNKNOWN)
            notes.append("Homebrew will perform its installed-dependent check during removal.")
        elif kind == "Standalone":
            planned.extend(identifiers)
            available = False
            statuses.append(PreviewStatus.UNSUPPORTED)
            notes.append("Standalone files have no package dependency metadata.")
        elif kind == "Container Export":
            statuses.append(PreviewStatus.BLOCKED)
            notes.append(
                "This is a host export of software installed inside a container. "
                "Remove it with that container's package manager, then unexport it."
            )
        else:
            available = False
            statuses.append(PreviewStatus.UNSUPPORTED)
            notes.append(f"No read-only transaction preview is available for {kind}.")
    unique_planned = tuple(dict.fromkeys(planned))
    unique_orphans = tuple(dict.fromkeys(orphans))
    precedence = (
        PreviewStatus.BLOCKED, PreviewStatus.FAILED, PreviewStatus.NOOP,
        PreviewStatus.UNKNOWN, PreviewStatus.UNSUPPORTED, PreviewStatus.EXACT,
    )
    status = next(
        (candidate for candidate in precedence if candidate in statuses),
        PreviewStatus.EXACT if available else PreviewStatus.UNKNOWN,
    )
    fingerprint_source = json.dumps({
        "status": status.value,
        "planned": unique_planned,
        "orphans": unique_orphans,
        "blockers": sorted(set(blockers)),
        "cleanup": sorted(cleanup_kinds),
    }, sort_keys=True)
    return PreviewResult(
        status, unique_planned, unique_orphans,
        tuple(dict.fromkeys(notes)), tuple(dict.fromkeys(blockers)),
        hashlib.sha256(fingerprint_source.encode("utf-8")).hexdigest(),
    )


@lru_cache(maxsize=1)
def apt_held_packages() -> set[str]:
    if not shutil.which("apt-mark"):
        return set()
    ok, names = command_lines(["apt-mark", "showhold"])
    return {package_base(name) for name in names} if ok else set()


@lru_cache(maxsize=1)
def dnf_protected_patterns() -> set[str]:
    patterns = {
        "dnf", "dnf5", "rpm", "systemd", "systemd-udev",
        "kernel", "kernel-core", "kernel-modules", "glibc",
    }
    for directory in (Path("/etc/dnf/protected.d"), Path("/etc/yum/protected.d")):
        if not directory.is_dir():
            continue
        try:
            for config in directory.glob("*.conf"):
                for line in config.read_text(
                        encoding="utf-8", errors="replace").splitlines():
                    value = line.strip()
                    if value and not value.startswith("#"):
                        patterns.add(value)
        except OSError:
            continue
    return patterns


@lru_cache(maxsize=16)
def runtime_protected_packages(kind: str) -> set[str]:
    """Resolve the packages behind the running init, kernel, and manager."""
    candidates: list[Path] = []
    try:
        candidates.append(Path("/proc/1/exe").resolve())
    except OSError:
        pass
    release = os.uname().release
    for kernel_path in (
            Path("/lib/modules") / release,
            Path("/usr/lib/modules") / release,
            Path("/boot") / f"vmlinuz-{release}"):
        if kernel_path.exists():
            candidates.append(kernel_path)
    manager_names = {
        "APT": ("apt-get", "dpkg"),
        "DNF": (dnf_binary(), "rpm"), "YUM": ("yum", "rpm"),
        "RPM": ("rpm",), "RPM-OSTree": ("rpm-ostree", "rpm"),
        "Zypper": ("zypper", "rpm"), "Pacman": ("pacman",),
        "URPMI": ("urpme", "rpm"), "APT-RPM": ("apt-get", "rpm"),
        "APK": ("apk",), "OPKG": ("opkg",), "XBPS": ("xbps-remove",),
    }
    for command in manager_names.get(kind, ()):
        if command:
            resolved = shutil.which(command)
            if resolved:
                candidates.append(Path(resolved).resolve())
    protected: set[str] = set()
    for path in dict.fromkeys(candidates):
        if kind in {"DNF", "YUM", "RPM", "RPM-OSTree", "Zypper", "URPMI", "APT-RPM"}:
            output = capture([
                "rpm", "-qf", "--qf", "%{NAME}\n", "--", str(path),
            ])
            protected.update(output.splitlines())
        elif kind == "APT":
            output = capture(["dpkg-query", "-S", str(path)])
            for line in output.splitlines():
                package, separator, _owned = line.partition(": ")
                if separator:
                    protected.add(package_base(package))
        elif kind == "Pacman":
            output = capture(["pacman", "-Qo", str(path)])
            match = re.search(r" is owned by (\S+)", output)
            if match:
                protected.add(match.group(1))
        elif kind == "APK":
            output = capture(["apk", "info", "--who-owns", str(path)])
            match = re.match(r"(.+?)-\d[^ ]* is owned by", output)
            if match:
                protected.add(match.group(1))
    return {package_base(name.strip()) for name in protected if name.strip()}


def protection_reason(kind: str, name: str) -> str:
    base = package_base(name)
    short_name = base.rsplit("/", 1)[-1]
    universal_core = {
        "aaa_base", "aaa_glibc-solibs", "aaa_libraries", "apk-tools", "apt",
        "base-files", "base-passwd", "base-system", "basesystem",
        "bash", "busybox", "coreutils", "dnf", "dnf5", "doas", "dpkg",
        "eopkg", "filesystem", "glibc", "glibc-solibs", "init", "libc6",
        "login", "musl", "openrc", "pacman", "passwd", "pkgtools", "portage",
        "os-core", "rpm", "setup", "shadow", "swupd",
        "shadow-utils", "sudo", "systemd", "systemd-udev", "util-linux", "opkg",
        "transactional-update", "xbps", "xbps-install", "yum", "zypper",
    }
    if short_name in universal_core or short_name.startswith("kernel"):
        return "core system package"
    if base in runtime_protected_packages(kind):
        return "owns a running core component or package-manager executable"
    if kind == "APT":
        if base in apt_held_packages():
            return "held by APT"
        details = capture([
            "dpkg-query", "-W", "-f=${Essential}\\t${Priority}", name,
        ]).strip().split("\t", 1)
        if details and details[0].casefold() == "yes":
            return "Essential package"
        if len(details) > 1 and details[1].casefold() == "required":
            return "required-priority package"
    if kind in {"DNF", "YUM", "RPM", "RPM-OSTree", "URPMI", "APT-RPM"}:
        for pattern in dnf_protected_patterns():
            if fnmatch.fnmatchcase(base, pattern):
                return "protected/core RPM package"
    if kind == "Pacman":
        try:
            text = Path("/etc/pacman.conf").read_text(
                encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        for line in text.splitlines():
            if line.strip().startswith("HoldPkg") and "=" in line:
                held = line.split("=", 1)[1].split()
                if any(fnmatch.fnmatchcase(base, pattern) for pattern in held):
                    return "held by Pacman configuration"
    return ""


def build_removal_plan(
        selected: list[Match], cleanup_kinds: set[str] | None = None,
) -> RemovalPlan:
    with ThreadPoolExecutor(max_workers=2) as executor:
        reports_future = executor.submit(
            lambda: [dependency_report(item) for item in selected])
        preview_future = (
            executor.submit(native_removal_preview, selected, cleanup_kinds)
            if cleanup_kinds is not None else
            executor.submit(native_removal_preview, selected)
        )
        reports = reports_future.result()
        preview_value = preview_future.result()
    if isinstance(preview_value, PreviewResult):
        planned = list(preview_value.planned)
        orphans = list(preview_value.orphans)
        preview_available = preview_value.available
        notes = list(preview_value.notes)
        preview_status = preview_value.status
        preview_fingerprint = preview_value.fingerprint
        blockers = list(preview_value.blockers)
    else:
        planned, orphans, preview_available, notes = preview_value
        preview_status = (
            PreviewStatus.EXACT if preview_available else PreviewStatus.UNKNOWN)
        preview_fingerprint = ""
        blockers = []
    requested = {package_base(item.ident) for item in selected}
    additional = [
        name for name in planned
        if package_base(name) not in requested
    ]
    protected_items: list[str] = []
    kinds = {item.kind for item in selected}
    selected_kinds = {
        package_base(item.ident): item.kind for item in selected
    }
    for name in planned:
        package_kind = selected_kinds.get(package_base(name))
        candidate_kinds = [package_kind] if package_kind else sorted(kinds)
        for kind in candidate_kinds:
            reason = protection_reason(kind or "", name)
            if reason:
                protected_items.append(f"{name} ({reason})")
                break
    has_dependents = any(
        report.direct_dependents or report.root_paths for report in reports)
    uncertain_kinds = {
        "APT", "DNF", "YUM", "Zypper", "RPM", "Pacman", "RPM-OSTree",
        "URPMI", "APT-RPM",
        "APK", "OPKG", "XBPS", "Portage", "Slackware", "Eopkg",
        "Swupd", "Homebrew", "Snap", "Standalone",
    }
    if preview_status in {PreviewStatus.BLOCKED, PreviewStatus.NOOP}:
        level = "BLOCKED"
    elif (protected_items or has_dependents
            or any(name not in orphans for name in additional)):
        level = "HIGH"
    elif not preview_available and any(
            item.kind in uncertain_kinds for item in selected):
        level = "UNKNOWN"
    elif orphans or any(
            item.role in {"dependency", "weak dependency"}
            for item in selected):
        level = "CAUTION"
    else:
        level = "LOW"
    notes.append(
        "This plan is a snapshot; the package manager's final transaction remains authoritative."
    )
    return RemovalPlan(
        selected, reports,
        planned if preview_status in {
            PreviewStatus.BLOCKED, PreviewStatus.NOOP
        } else planned or [item.ident for item in selected],
        additional, orphans, level, preview_available, protected_items, notes,
        preview_status.value, preview_fingerprint, blockers,
    )


ROLE_EXPLANATIONS = {
    "explicit": "explicit (installed at the user's request)",
    "external": "external (installed outside DNF)",
    "group": "group (installed as part of a package group)",
    "dependency": "dependency (installed automatically)",
    "weak dependency": "weak dependency (installed automatically; optional)",
    "unknown": "unknown (the package manager did not provide a reason)",
}


def render_relationship_path(nodes: list[str], relations: list[str]) -> str:
    rendered = display(nodes[0])
    for relation, node in zip(relations, nodes[1:]):
        rendered += f" --{display(relation)}--> {display(node)}"
    return rendered


def show_dependency_reports(
        reports: list[DependencyReport], heading: str = "",
) -> None:
    if heading:
        print(f"\n{heading}")
    for report in reports:
        item = report.target
        print(f"\n{display(item.name)} [{display(item.kind)}]")
        role = ROLE_EXPLANATIONS.get(item.role, item.role)
        print(f"  Installed as: {display(role)}")
        if report.history_reason:
            print(f"  Original install: {display(report.history_reason)}")

        if report.root_paths:
            print("  Required dependency paths:")
            for path in report.root_paths:
                print("    " + " --requires--> ".join(
                    display(node) for node in path))
        if report.relationship_paths:
            print("  Optional dependency paths:")
            for nodes, relations in report.relationship_paths:
                print("    " + render_relationship_path(nodes, relations))

        covered_hard = {
            nodes[-2] for nodes in report.root_paths if len(nodes) >= 2
        }
        uncovered_hard = [
            name for name in report.direct_dependents
            if name not in covered_hard
        ]
        if uncovered_hard:
            print("  Also required directly by: "
                  + ", ".join(display(name) for name in uncovered_hard[:12]))
            if len(uncovered_hard) > 12:
                print(f"    ...and {len(uncovered_hard) - 12} more")

        covered_weak = {
            nodes[-2] for nodes, _relations in report.relationship_paths
            if len(nodes) >= 2
        }
        uncovered_weak = [
            (dependent, relation)
            for dependent, relation in report.weak_relations
            if dependent not in covered_weak
        ]
        if uncovered_weak:
            print("  Other optional relationships:")
            for dependent, relation in uncovered_weak[:12]:
                print(
                    f"    {display(dependent)} {display(relation)} this package")
            if len(uncovered_weak) > 12:
                print(f"    ...and {len(uncovered_weak) - 12} more")
        if not report.complete:
            print("  Coverage: incomplete; some dependency metadata was unavailable.")
        if report.note:
            print(f"  Note: {display(report.note)}")


IMPACT_EXPLANATIONS = {
    "LOW": "only the requested software is expected to be removed",
    "CAUTION": "review automatically installed or now-unused dependencies",
    "HIGH": "dependent, root, or protected packages may be affected",
    "UNKNOWN": "a reliable package-manager preview was unavailable",
}


def show_removal_plan(plan: RemovalPlan) -> None:
    print("\nRemoval preview (nothing has been changed)")
    explanation = IMPACT_EXPLANATIONS.get(plan.level, "")
    print(
        f"  Risk: {plan.level}"
        f"{' - ' + explanation if explanation else ''}"
    )
    show_dependency_reports(plan.reports)

    requested = {package_base(item.ident) for item in plan.selected}
    requested_removals = [
        name for name in plan.planned_removals
        if package_base(name) in requested
    ]
    unused = [
        name for name in plan.planned_removals
        if name in plan.orphan_removals
    ]
    dependents = [
        name for name in plan.additional_removals
        if name not in plan.orphan_removals
    ]
    other = [
        name for name in plan.planned_removals
        if (name not in requested_removals
            and name not in unused and name not in dependents)
    ]
    print(
        f"\n  Expected removals "
        f"({len(plan.planned_removals)} removal"
        f"{'s' if len(plan.planned_removals) != 1 else ''}):"
    )
    for title, names in (
            ("Requested", requested_removals),
            ("Also removed because they depend on the request", dependents),
            ("Also removed because they become unused", unused),
            ("Other removals reported by the package manager", other)):
        if not names:
            continue
        print(f"    {title}:")
        for name in names:
            print(f"      {display(name)}")
    if plan.protected_items:
        print("  Protected or critical packages involved:")
        for item in plan.protected_items:
            print(f"    {display(item)}")
    for note in plan.notes:
        print(f"  Note: {display(note)}")


def show_compact_impact(plan: RemovalPlan) -> None:
    if plan.level == "BLOCKED":
        requested = ", ".join(display(item.name) for item in plan.selected)
        print(f"\nCannot remove {requested} with the requested transaction.")
        if plan.blockers:
            print("Required by: " + ", ".join(
                display(blocker) for blocker in plan.blockers))
        elif plan.notes:
            print(display(plan.notes[0]))
        print("Nothing will be changed.")
        return
    dependents = [
        name for name in plan.additional_removals
        if name not in plan.orphan_removals
    ]
    if dependents:
        print(
            "\nWarning: removal also affects installed dependents: "
            + compact_names(dependents)
        )
    if plan.orphan_removals:
        print(
            "\nAlso expected to remove "
            f"{len(plan.orphan_removals)} now-unused "
            f"dependenc{'y' if len(plan.orphan_removals) == 1 else 'ies'}: "
            + compact_names(plan.orphan_removals)
        )
    if plan.protected_items:
        print(
            "\nWarning: protected or critical packages are involved: "
            + compact_names(plan.protected_items)
        )
    if plan.level == "UNKNOWN":
        if all(item.kind == "Standalone" for item in plan.selected):
            print(
                "\nExtra confirmation is required because related "
                "standalone files cannot be identified."
            )
        else:
            print(
                "\nWarning: a reliable preview was unavailable; "
                "review the removal command carefully."
            )
    critical_markers = (
        "reboot", "generation", "garbage collection", "shared runtime",
        "new snapshot", "new deployment", "will not persist",
    )
    critical = next((
        note for note in plan.notes
        if any(marker in note.casefold() for marker in critical_markers)
    ), "")
    if critical:
        print("\nNote: " + display(critical))


def choose(matches: list[Match], auto_select: bool = False) -> list[Match]:
    print(f"\nFound {len(matches)} likely installed option{'s' if len(matches) != 1 else ''}:\n")
    for index, item in enumerate(matches, 1):
        role = (
            "" if item.role in {"explicit", "unknown"}
            else item.role
        )
        details = " | ".join(
            display(value)
            for value in (
                item.version,
                item.scope,
                role,
                format_size(item.size_bytes)
                if item.size_bytes is not None else "",
            )
            if value
        )
        print(f"  {index:>2}. {display(item.name)}  [{display(item.kind)}]"
              f"{'  ' + details if details else ''}")
        if item.ident != item.name:
            print(f"      {display(item.ident)}")
        if item.provides:
            print(f"      provides command: {display(item.provides)}")
        if item.reason:
            print(f"      Why installed: {display(item.reason)}")
        if item.archive:
            print(f"      matched package archive: {display(item.archive)}")
            if (item.archive_version and item.version
                    and item.archive_version != item.version):
                print(
                    f"      warning: archive version {display(item.archive_version)}; "
                    f"installed version {display(item.version)}"
                )
        if item.kind == "Standalone":
            print("      note: related files cannot be identified automatically")
    if auto_select and len(matches) == 1:
        print("\nAutomatically selected the only result.")
        return matches
    print("\nChoose numbers separated by commas, 'a' for all, or Enter to cancel.")
    while True:
        raw = input("> ").strip().casefold()
        if not raw:
            return []
        if raw in {"a", "all"}:
            return matches
        try:
            indexes = {int(part.strip()) for part in raw.split(",")}
        except ValueError:
            print("That selection was not understood; try again.", file=sys.stderr)
            continue
        if not indexes or min(indexes) < 1 or max(indexes) > len(matches):
            print("Selection is out of range; try again.", file=sys.stderr)
            continue
        return [item for index, item in enumerate(matches, 1) if index in indexes]


def data_keys(selected: Iterable[Match]) -> set[str]:
    keys: set[str] = set()
    for item in selected:
        values = (item.name, item.ident, Path(item.ident).stem)
        for value in values:
            simple = norm(value)
            if len(simple) >= 3:
                keys.add(simple)
            tail = norm(value.rsplit(".", 1)[-1])
            if len(tail) >= 3:
                keys.add(tail)
            versionless = norm(re.sub(
                r"[-_. ]v?\d+(?:[-_.]\d+)*.*$", "", value,
                flags=re.IGNORECASE,
            ))
            if len(versionless) >= 3:
                keys.add(versionless)
    return keys


def xdg_dir(variable: str, fallback: Path) -> Path:
    configured = os.environ.get(variable)
    if not configured:
        return fallback
    path = Path(configured).expanduser()
    if not path.is_absolute() or not safe_data_root(path):
        return fallback
    return path


def safe_data_root(path: Path) -> bool:
    """Reject roots broad enough to turn a name match into system damage."""
    absolute = path.absolute()
    forbidden = {
        Path("/"), Path.home().absolute(), Path("/bin"), Path("/boot"),
        Path("/dev"), Path("/etc"), Path("/lib"), Path("/lib64"),
        Path("/proc"), Path("/root"), Path("/run"), Path("/sbin"),
        Path("/sys"), Path("/usr"), Path("/var"), Path("/opt"),
        Path("/mnt"), Path("/media"), Path("/srv"),
    }
    return absolute not in forbidden


def user_data_roots() -> list[Path]:
    home = Path.home()
    return [
        xdg_dir("XDG_CONFIG_HOME", home / ".config"),
        xdg_dir("XDG_CACHE_HOME", home / ".cache"),
        xdg_dir("XDG_DATA_HOME", home / ".local/share"),
        xdg_dir("XDG_STATE_HOME", home / ".local/state"),
    ]


def find_user_data(selected: list[Match]) -> list[Path]:
    keys = data_keys(selected)
    roots = user_data_roots()
    paths: set[Path] = set()
    for root in roots:
        if not root.is_dir():
            continue
        try:
            for child in root.iterdir():
                child_key = norm(child.name)
                if child_key in keys and (child.is_dir() or child.is_symlink()):
                    paths.add(child)
        except OSError:
            pass
    data_home = xdg_dir("XDG_DATA_HOME", Path.home() / ".local/share")
    applications = data_home / "applications"
    if applications.is_dir():
        selected_files = {
            str(item.path) for item in selected
            if item.path and item.kind in {"AppImage", "Standalone"}
        }
        manager_owned_files = {
            str(item.path) for item in selected
            if item.path and item.kind == "Gear Lever"
        }
        try:
            for desktop_file in applications.glob("*.desktop"):
                matches_name = norm(desktop_file.stem) in keys
                references_file = False
                manager_owned = False
                if selected_files or manager_owned_files:
                    try:
                        if desktop_file.stat().st_size <= 1024 * 1024:
                            content = desktop_file.read_text(
                                encoding="utf-8", errors="replace")
                            references_file = any(
                                target in content for target in selected_files)
                            manager_owned = any(
                                target in content for target in manager_owned_files)
                    except OSError:
                        pass
                if manager_owned:
                    continue
                if matches_name or references_file:
                    paths.add(desktop_file)
        except OSError:
            pass
    icons = data_home / "icons"
    if icons.is_dir():
        try:
            for icon in icons.glob("hicolor/*/apps/*"):
                if icon.is_file() and norm(icon.stem) in keys:
                    paths.add(icon)
        except OSError:
            pass
    return sorted(paths)


def privileged(command: list[str]) -> list[str]:
    if os.geteuid() == 0:
        return command
    for helper in ("sudo", "doas", "pkexec"):
        if shutil.which(helper):
            return [helper] + command
    raise RuntimeError(
        f"{command[0]} needs administrator privileges, but sudo, doas, and "
        "pkexec are unavailable"
    )


def uninstall_command(item: Match, remove_data: bool) -> list[str]:
    if item.kind == "Flatpak":
        location = (
            f"--installation={item.installation}"
            if item.installation else f"--{item.scope}")
        command = ["flatpak", "uninstall", "-y", location]
        if remove_data:
            command.append("--delete-data")
        return command + [item.ident]
    if item.kind == "UV Tool":
        return ["uv", "tool", "uninstall", item.ident]
    if item.kind == "Conda":
        manager = "conda" if shutil.which("conda") else "micromamba"
        return [
            manager, "remove", "--yes", "--prefix", item.profile,
            item.ident,
        ]
    if item.kind == "Snap":
        command = ["snap", "remove"]
        if remove_data:
            command.append("--purge")
        return privileged(command + [item.ident])
    if item.kind == "APT":
        action = "purge" if remove_data else "remove"
        return privileged(["apt-get", action, item.ident])
    if item.kind == "APT-RPM":
        return privileged(["apt-get", "remove", item.ident])
    if item.kind == "DNF":
        manager = dnf_binary() or "dnf"
        return privileged([manager, "remove", item.ident])
    if item.kind == "RPM-OSTree":
        return privileged(["rpm-ostree", "uninstall", item.ident])
    if item.kind == "Zypper":
        if transactional_zypper_system():
            return privileged([
                "transactional-update", "--non-interactive", "pkg", "remove",
                item.ident,
            ])
        return privileged(["zypper", "remove", item.ident])
    if item.kind == "URPMI":
        return privileged(["urpme", "--auto", item.ident])
    if item.kind == "YUM":
        return privileged(["yum", "remove", item.ident])
    if item.kind == "RPM":
        return privileged(["rpm", "-e", item.ident])
    if item.kind == "Pacman":
        return privileged(["pacman", "-R", item.ident])
    if item.kind == "APK":
        return privileged(["apk", "del", item.ident])
    if item.kind == "OPKG":
        return privileged(["opkg", "remove", item.ident])
    if item.kind == "XBPS":
        return privileged([
            "xbps-remove", "--recursive", "--yes", item.ident,
        ])
    if item.kind == "Portage":
        atom = "=" + item.ident + (f"-{item.version}" if item.version else "")
        command = [
            "emerge", "--ask=n", "--verbose", "--depclean", atom,
        ]
        return command if item.scope == "user" else privileged(command)
    if item.kind == "Slackware":
        return privileged(["removepkg", item.ident])
    if item.kind == "Eopkg":
        command = ["eopkg", "remove", "--yes-all"]
        if remove_data:
            command.append("--purge")
        return privileged(command + [item.ident])
    if item.kind == "Swupd":
        return privileged(["swupd", "bundle-remove", item.ident])
    if item.kind == "Swupd 3rd-party":
        return privileged([
            "swupd", "3rd-party", "bundle-remove", "--repo", item.origin,
            item.ident,
        ])
    if item.kind in {"Homebrew", "Homebrew Cask"}:
        command = ["brew", "uninstall"]
        if item.kind == "Homebrew Cask":
            command.append("--cask")
            if remove_data:
                command.append("--zap")
        return command + [item.ident]
    if item.kind == "Cargo":
        return ["cargo", "uninstall", item.ident]
    if item.kind == "Pipx":
        command = ["pipx", "uninstall"]
        if item.scope == "system":
            command.append("--global")
            return privileged(command + [item.ident])
        return command + [item.ident]
    if item.kind == "NPM":
        command = ["npm", "uninstall", "--global", item.ident]
        return command if item.scope == "user" else privileged(command)
    if item.kind == "Nix":
        command = ["nix", "profile", "remove"]
        if item.profile:
            command.extend(["--profile", item.profile])
        return command + [item.ident]
    if item.kind == "Nix Legacy":
        return ["nix-env", "--uninstall", item.ident]
    if item.kind == "Guix":
        return [
            "guix", "package", f"--profile={item.origin}",
            f"--remove={item.ident}",
        ]
    if item.kind == "Gear Lever" and item.path:
        command = gearlever_command()
        if not command:
            raise RuntimeError("Gear Lever is no longer available")
        return command + ["--remove", str(item.path), "--yes"]
    if item.kind == "AppImage" and item.path:
        targets = [str(item.path)]
        if item.provides:
            exposed = Path(item.provides)
            try:
                if exposed.is_symlink() and exposed.resolve() == item.path.resolve():
                    targets.append(str(exposed))
            except OSError:
                pass
        command = ["rm", "--"] + targets
        return command if os.access(item.path.parent, os.W_OK) else privileged(command)
    if item.kind == "Standalone" and item.path:
        command = ["rm", "--", str(item.path)]
        return command if os.access(item.path.parent, os.W_OK) else privileged(command)
    raise ValueError(f"Unsupported package kind: {item.kind}")


def build_uninstall_batches(
        selected: list[Match], remove_data: bool | set[str],
) -> list[tuple[list[Match], list[str]]]:
    """Group packages when the real command safely accepts the same transaction."""
    groupable = {
        "Flatpak", "Snap", "APT", "DNF", "RPM-OSTree", "Zypper",
        "URPMI", "APT-RPM",
        "YUM", "RPM", "Pacman", "APK", "OPKG", "XBPS", "Portage", "Slackware",
        "Eopkg", "Swupd", "Swupd 3rd-party", "Homebrew", "Homebrew Cask", "NPM", "Nix",
        "Conda",
        "Nix Legacy", "Guix", "Standalone",
    }
    grouped: dict[tuple[str, str, str, str, str], list[Match]] = {}
    order: list[tuple[str, str, str, str, str]] = []
    for index, item in enumerate(selected):
        key = (
            (item.kind, item.scope, item.installation, item.profile,
             item.origin if item.kind in {"Guix", "Swupd 3rd-party"} else "")
            if item.kind in groupable else
            (f"{item.kind}:{index}", item.scope, item.installation,
             item.profile, item.origin)
        )
        if key not in grouped:
            grouped[key] = []
            order.append(key)
        grouped[key].append(item)

    batches: list[tuple[list[Match], list[str]]] = []
    for key in order:
        items = grouped[key]
        manager_cleanup = (
            remove_data
            if isinstance(remove_data, bool)
            else items[0].kind in remove_data
        )
        command = uninstall_command(items[0], manager_cleanup)
        for item in items[1:]:
            if item.kind in {"AppImage", "Standalone"} and item.path:
                value = str(item.path)
            elif item.kind == "Portage":
                value = "=" + item.ident + (
                    f"-{item.version}" if item.version else "")
            elif item.kind == "Guix":
                value = f"--remove={item.ident}"
            else:
                value = item.ident
            command.append(value)
        batches.append((items, command))
    return batches


def pinned_command(command: list[str]) -> list[str]:
    """Pin privileged tools to trusted absolute files used for this run."""
    pinned = list(command)
    privilege_helpers = {"sudo", "doas", "pkexec"}
    indexes = [0]
    if command and Path(command[0]).name in privilege_helpers and len(command) > 1:
        indexes.append(1)
    for index in indexes:
        resolved = shutil.which(command[index])
        if not resolved:
            raise RuntimeError(f"{command[index]} is no longer available")
        # Keep dispatch symlinks (notably Cargo's rustup shim) intact: argv[0]
        # is part of their interface.  stat() still validates the final target.
        path = Path(resolved).absolute()
        try:
            details = path.stat()
        except OSError as error:
            raise RuntimeError(
                f"cannot validate {command[index]}: {error}") from error
        privileged_target = len(indexes) > 1 and index == 1
        if privileged_target and (
                details.st_uid != 0 or details.st_mode & 0o022):
            raise RuntimeError(
                f"refusing to run untrusted privileged executable {path}")
        pinned[index] = str(path)
    return pinned


def confirmed_noninteractive_command(
        command: list[str], kind: str,
) -> list[str]:
    """Avoid a second prompt only after an exact fingerprinted preview."""
    updated = list(command)
    manager_index = 1 if updated and Path(updated[0]).name in {
        "sudo", "doas", "pkexec"
    } else 0
    if manager_index >= len(updated):
        return updated
    if kind in {"APT", "APT-RPM", "DNF", "YUM"} and "-y" not in updated:
        updated.insert(manager_index + 1, "-y")
    elif kind == "Zypper" and "--non-interactive" not in updated:
        updated.insert(manager_index + 1, "--non-interactive")
    elif kind == "Pacman" and "--noconfirm" not in updated:
        updated.insert(manager_index + 1, "--noconfirm")
    return updated


def manager_cleanup_paths(
        kind: str, selected: list[Match],
) -> list[Path] | None:
    targets = [item for item in selected if item.kind == kind]
    if kind == "Flatpak":
        return [
            Path.home() / ".var/app" / item.ident
            for item in targets
        ]
    if kind == "Snap":
        paths: list[Path] = []
        for item in targets:
            paths.extend((
                Path.home() / "snap" / item.ident,
                Path("/var/snap") / item.ident,
            ))
        return paths
    return None


def manager_cleanup_size(kind: str, selected: list[Match]) -> int | None:
    paths = manager_cleanup_paths(kind, selected)
    if paths is None:
        return None
    measured = path_disk_sizes(paths)
    sizes = [measured.get(path.absolute()) for path in paths]
    return None if any(size is None for size in sizes) else sum(sizes)


_CLEANUP_SNAPSHOTS: dict[Path, CleanupCandidate] = {}


def close_cleanup_candidate(candidate: CleanupCandidate | None) -> None:
    if candidate is None:
        return
    for descriptor in (candidate.target_fd, candidate.parent_fd):
        try:
            os.close(descriptor)
        except OSError:
            pass


def clear_cleanup_snapshots() -> None:
    for candidate in _CLEANUP_SNAPSHOTS.values():
        close_cleanup_candidate(candidate)
    _CLEANUP_SNAPSHOTS.clear()


def snapshot_cleanup_candidate(
        path: Path, evidence: str = "normalized-name match",
) -> CleanupCandidate | None:
    parent_fd = -1
    target_fd = -1
    try:
        parent_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
        parent_flags |= getattr(os, "O_CLOEXEC", 0)
        parent_flags |= getattr(os, "O_NOFOLLOW", 0)
        parent_fd = os.open(str(path.absolute().parent), parent_flags)
        target_flags = getattr(os, "O_PATH", os.O_RDONLY)
        target_flags |= getattr(os, "O_CLOEXEC", 0)
        target_flags |= getattr(os, "O_NOFOLLOW", 0)
        target_fd = os.open(
            path.absolute().name, target_flags, dir_fd=parent_fd)
        details = os.fstat(target_fd)
        parent = os.fstat(parent_fd)
    except OSError:
        for descriptor in (target_fd, parent_fd):
            if descriptor >= 0:
                try:
                    os.close(descriptor)
                except OSError:
                    pass
        return None
    return CleanupCandidate(
        path.absolute(), evidence, details.st_dev, details.st_ino,
        details.st_mode, details.st_ctime_ns, parent.st_dev, parent.st_ino,
        target_fd, parent_fd,
    )


def ask_cleanup(
        selected: list[Match], paths: list[Path],
) -> tuple[set[str], list[Path]]:
    kinds = {item.kind for item in selected}
    descriptions = (
        ("Flatpak", "Sandbox data and permissions"),
        ("APT", "Package-managed system configuration (not home data)"),
        ("Snap", "Do not create a recovery snapshot"),
        ("Eopkg", "Package-managed changed configuration files (--purge)"),
        (
            "Homebrew Cask",
            "Declared associated files (--zap; may include shared files)",
        ),
    )
    managed = [
        (kind, description)
        for kind, description in descriptions
        if kind in kinds
    ]
    if not managed and not paths:
        return set(), []

    print("\nRemove associated data too? (optional)\n")
    entries: list[tuple[str, Path | None, int | None]] = []
    labels: list[str] = []
    for kind, description in managed:
        entries.append((kind, None, manager_cleanup_size(kind, selected)))
        labels.append(f"[{kind}] {description}")
    detected_sizes = path_disk_sizes(paths)
    for path in paths:
        entries.append(("", path, detected_sizes.get(path.absolute())))
        evidence = (
            "desktop reference" if path.suffix == ".desktop" else
            "exact name match"
        )
        labels.append(f"[Detected] {display(path)} ({evidence})")
    label_width = max(len(label) for label in labels)
    for index, (label, (_kind, _path, size)) in enumerate(
            zip(labels, entries), 1):
        size_text = (
            format_size(size) if size is not None else "size unknown")
        print(f"  {index:>2}. {label:<{label_width}}  {size_text}")

    if managed:
        manager_note = (
            "Flatpak data is manager-owned."
            if [kind for kind, _description in managed] == ["Flatpak"]
            else "Package-manager options use their manager's cleanup rules."
        )
        print(f"\n{manager_note}", end="")
    if paths:
        spacer = " " if managed else "\n"
        print(
            spacer
            + "Detected paths are name matches, are not guaranteed to belong "
            "to this app, and will be deleted permanently.",
            end="",
        )
        print(" Only data for the current user is checked.", end="")
    print(
        "\nChoose numbers separated by commas, 'a' for all, "
        "or Enter to keep everything."
    )
    while True:
        try:
            raw = input("> ").strip().casefold()
        except EOFError:
            return set(), []
        if not raw:
            return set(), []
        if raw in {"a", "all"}:
            indexes = set(range(1, len(entries) + 1))
        else:
            try:
                indexes = {int(part.strip()) for part in raw.split(",")}
            except ValueError:
                print(
                    "That selection was not understood; try again.",
                    file=sys.stderr,
                )
                continue
            if (not indexes or min(indexes) < 1
                    or max(indexes) > len(entries)):
                print(
                    "Selection is out of range; try again.",
                    file=sys.stderr,
                )
                continue
        cleanup_kinds = {
            entries[index - 1][0]
            for index in indexes
            if entries[index - 1][0]
        }
        selected_paths = [
            path
            for index, (_kind, path, _size) in enumerate(entries, 1)
            if index in indexes and path is not None
        ]
        for path in selected_paths:
            snapshot = snapshot_cleanup_candidate(path)
            if snapshot:
                absolute = path.absolute()
                close_cleanup_candidate(_CLEANUP_SNAPSHOTS.pop(absolute, None))
                _CLEANUP_SNAPSHOTS[absolute] = snapshot
        return cleanup_kinds, selected_paths


def cleanup_display_command(path: Path) -> list[str]:
    if path.is_dir() and not path.is_symlink():
        return ["rm", "-r", "--", str(path)]
    return ["rm", "--", str(path)]


def distinct_paths(paths: Iterable[Path]) -> list[Path]:
    distinct: list[Path] = []
    for path in sorted(
            {item.absolute() for item in paths},
            key=lambda item: (len(item.parts), str(item))):
        if any(path == parent or path_is_within(path, parent)
               for parent in distinct):
            continue
        distinct.append(path)
    return distinct


def removal_space_estimate(
        plan: RemovalPlan, cleanup_kinds: set[str],
        cleanup_paths: list[Path],
) -> tuple[int, bool]:
    total = 0
    complete = plan.level != "UNKNOWN"
    for item in plan.selected:
        if item.size_bytes is None:
            complete = False
        else:
            total += item.size_bytes

    selected_kinds = {item.kind for item in plan.selected}
    selected_scopes = {item.scope for item in plan.selected}
    if plan.additional_removals:
        if len(selected_kinds) == 1:
            kind = next(iter(selected_kinds))
            scope = (
                next(iter(selected_scopes))
                if len(selected_scopes) == 1 else "system"
            )
            for ident in plan.additional_removals:
                size = package_installed_size(kind, ident, scope)
                if size is None:
                    complete = False
                else:
                    total += size
        else:
            complete = False

    measured_paths = list(cleanup_paths)
    for kind in cleanup_kinds:
        paths = manager_cleanup_paths(kind, plan.selected)
        if paths is None:
            complete = False
        else:
            measured_paths.extend(paths)
    distinct_measured = distinct_paths(measured_paths)
    measured_sizes = path_disk_sizes(distinct_measured)
    for path in distinct_measured:
        size = measured_sizes.get(path.absolute())
        if size is None:
            complete = False
        else:
            total += size
    return total, complete


def ready_heading(size_bytes: int, complete: bool) -> str:
    if complete:
        return (
            "Ready to run (estimated installed data affected: "
            f"about {format_size(size_bytes)}):"
        )
    if size_bytes:
        return (
            "Ready to run "
            f"(at least {format_size(size_bytes)} installed data affected; "
            "some sizes and reclaimed space unknown):"
        )
    return "Ready to run (affected size and reclaimed space unknown):"


def yes(prompt: str) -> bool:
    try:
        return input(prompt).strip().casefold() in {"y", "yes"}
    except EOFError:
        return False


def preflight_file(item: Match) -> str | None:
    if item.kind not in {"AppImage", "Gear Lever", "Standalone"} or not item.path:
        return None
    path = item.path
    if not path.is_absolute():
        return "target path is not absolute"
    if not path.exists() and not path.is_symlink():
        return "target no longer exists"
    if path.is_dir() and not path.is_symlink():
        return "target unexpectedly became a directory"
    if item.kind == "Standalone":
        current = shutil.which(item.name)
        if not current or Path(current).absolute() != path:
            return "the command resolved to a different path since it was selected"
    return None


def installation_present(item: Match) -> bool | None:
    """Query the selected backend directly, bypassing invocation caches."""
    if item.kind in {"AppImage", "Gear Lever", "Standalone"} and item.path:
        return item.path.exists() or item.path.is_symlink()
    commands: dict[str, list[str]] = {
        "Snap": ["snap", "list", item.ident],
        "APT": ["dpkg-query", "-W", "-f=${db:Status-Abbrev}", item.ident],
        "DNF": ["rpm", "-q", "--", item.ident],
        "YUM": ["rpm", "-q", "--", item.ident],
        "RPM": ["rpm", "-q", "--", item.ident],
        "RPM-OSTree": ["rpm", "-q", "--", item.ident],
        "Zypper": ["rpm", "-q", "--", item.ident],
        "URPMI": ["rpm", "-q", "--", item.ident],
        "APT-RPM": ["rpm", "-q", "--", item.ident],
        "Pacman": ["pacman", "-Q", item.ident],
        "APK": ["apk", "info", "--exists", item.ident],
        "OPKG": ["opkg", "status", item.ident],
        "XBPS": ["xbps-query", item.ident],
        "Eopkg": ["eopkg", "info", "--installed", item.ident],
        "Homebrew": ["brew", "list", "--versions", item.ident],
        "Homebrew Cask": ["brew", "list", "--cask", item.ident],
    }
    if item.kind == "Flatpak":
        location = (
            f"--installation={item.installation}"
            if item.installation else f"--{item.scope}")
        command = ["flatpak", "info", location, item.ident]
    elif item.kind == "Nix":
        command = ["nix", "profile", "list"]
        if item.profile:
            command.extend(["--profile", item.profile])
        command.extend(["--json"])
    elif item.kind == "Guix":
        command = [
            "guix", "package", f"--profile={item.origin}",
            "--list-installed", item.ident,
        ]
    elif item.kind == "UV Tool":
        command = ["uv", "tool", "list"]
    elif item.kind == "Conda":
        manager = "conda" if shutil.which("conda") else "micromamba"
        command = [
            manager, "list", "--json", "--prefix", item.profile,
            item.ident,
        ]
    else:
        command = commands.get(item.kind, [])
    if not command:
        return None
    result = run_command(command, timeout=30, combine_output=True)
    if result.status in {CommandStatus.TIMEOUT, CommandStatus.MISSING}:
        return None
    if item.kind == "APT" and result.ok:
        return len(result.stdout) > 1 and result.stdout[1:2] == "i"
    if item.kind == "Nix" and result.ok:
        return item.ident in nix_profile_elements_from_text(result.stdout)
    if item.kind == "OPKG" and result.ok:
        return "install" in result.stdout.casefold() \
            and "installed" in result.stdout.casefold()
    if item.kind == "UV Tool" and result.ok:
        return any(
            line.split()[:1] == [item.ident]
            for line in result.stdout.splitlines() if line and not line[0].isspace()
        )
    if item.kind == "Conda" and result.ok:
        try:
            payload = json.loads(result.stdout)
        except (json.JSONDecodeError, TypeError):
            return None
        return any(
            isinstance(entry, dict) and entry.get("name") == item.ident
            for entry in payload
        ) if isinstance(payload, list) else None
    return result.ok


def current_installed_version(item: Match) -> str | None:
    commands: dict[str, list[str]] = {
        "APT": ["dpkg-query", "-W", "-f=${Version}", item.ident],
        "DNF": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "--", item.ident],
        "YUM": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "--", item.ident],
        "RPM": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "--", item.ident],
        "RPM-OSTree": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "--", item.ident],
        "Zypper": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "--", item.ident],
        "URPMI": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "--", item.ident],
        "APT-RPM": ["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", "--", item.ident],
        "Pacman": ["pacman", "-Q", item.ident],
        "Snap": ["snap", "list", item.ident],
        "APK": ["apk", "info", "--all", item.ident],
        "XBPS": ["xbps-query", "--property", "pkgver", item.ident],
    }
    if item.kind == "Flatpak":
        location = (
            f"--installation={item.installation}"
            if item.installation else f"--{item.scope}")
        command = ["flatpak", "info", location, "--show-version", item.ident]
    else:
        command = commands.get(item.kind, [])
    if not command:
        return None
    result = run_command(command, timeout=30, combine_output=True)
    if not result.ok:
        return ""
    output = result.stdout.strip()
    if item.kind == "Pacman":
        fields = output.rsplit(maxsplit=1)
        return fields[1] if len(fields) == 2 else ""
    if item.kind == "Snap":
        lines = output.splitlines()
        fields = lines[1].split() if len(lines) > 1 else []
        return fields[1] if len(fields) > 1 else ""
    if item.kind == "APK":
        match = re.search(
            rf"(?m)^{re.escape(item.ident)}-([^\s]+)", output)
        return match.group(1) if match else ""
    if item.kind == "XBPS" and output.startswith(item.ident + "-"):
        return output[len(item.ident) + 1:]
    return output.splitlines()[0] if output else ""


def revalidate_package_identity(item: Match) -> str:
    if not item.version:
        present = installation_present(item)
        return "target is no longer installed" if present is False else ""
    current = current_installed_version(item)
    if current == "":
        return "target is no longer installed"
    if current is not None and current != item.version:
        return (
            f"installed version changed from {item.version} to {current}"
        )
    return ""


def nix_profile_elements_from_text(text: str) -> set[str]:
    try:
        payload = json.loads(text)
    except (json.JSONDecodeError, TypeError):
        return set()
    elements = payload.get("elements", payload) if isinstance(payload, dict) else {}
    return set(elements) if isinstance(elements, dict) else set()


def remove_paths(paths: list[Path]) -> bool:
    ok = True
    allowed_roots = [root.resolve() for root in user_data_roots()]
    allowed_roots.append((Path.home() / "snap").resolve())
    for path in paths:
        expected: CleanupCandidate | None = None
        try:
            absolute = path.absolute()
            resolved_parent = path.parent.resolve()
            if not any(
                resolved_parent == root or root in resolved_parent.parents
                for root in allowed_roots
            ):
                raise ValueError("path is outside the approved app-data locations")
            expected = _CLEANUP_SNAPSHOTS.pop(absolute, None)
            if expected is None:
                expected = snapshot_cleanup_candidate(absolute)
            if expected is None:
                if not absolute.exists() and not absolute.is_symlink():
                    print(f"  Already removed {display(path)}")
                    continue
                raise ValueError("path could not be opened safely")
            current = absolute.lstat()
            parent_path_current = absolute.parent.stat()
            parent_handle_current = os.fstat(expected.parent_fd)
            if ((current.st_dev, current.st_ino, stat.S_IFMT(current.st_mode),
                 current.st_ctime_ns)
                    != (expected.device, expected.inode,
                        stat.S_IFMT(expected.mode), expected.change_time_ns)):
                raise ValueError("path changed after it was selected")
            if ((parent_path_current.st_dev, parent_path_current.st_ino)
                    != (expected.parent_device, expected.parent_inode)
                    or (parent_handle_current.st_dev,
                        parent_handle_current.st_ino)
                    != (expected.parent_device, expected.parent_inode)):
                raise ValueError("parent directory changed after selection")
            tombstone: Path | None = None
            if stat.S_ISDIR(current.st_mode):
                trash_name = ".uninstall-trash-" + secrets.token_hex(12)
                os.rename(
                    absolute.name, trash_name,
                    src_dir_fd=expected.parent_fd,
                    dst_dir_fd=expected.parent_fd,
                )
                tombstone = absolute.parent / trash_name
            else:
                os.unlink(absolute.name, dir_fd=expected.parent_fd)
            if tombstone is not None:
                shutil.rmtree(tombstone)
            print(f"  Removed {display(path)}")
        except (OSError, ValueError) as error:
            ok = False
            print(f"  Could not remove {display(path)}: {display(error)}", file=sys.stderr)
        finally:
            close_cleanup_candidate(expected)
    return ok


def run_uninstall(
        query: str, show_dependencies: bool = False,
) -> int:
    progress = Timer(
        0.6,
        lambda: print("Checking installed applications…", file=sys.stderr),
    )
    progress.daemon = True
    progress.start()
    try:
        matches = annotate_roles(find_matches(query))
    finally:
        progress.cancel()
    matches, hidden_dependencies = filter_dependency_matches(
        matches, query, show_dependencies)
    if hidden_dependencies:
        print(
            f"Hidden {hidden_dependencies} fuzzy dependency match"
            f"{'es' if hidden_dependencies != 1 else ''}; "
            "use --show-dependencies to include them."
        )
    if not matches:
        base_image_package = (
            "" if is_package_archive_query(query)
            else rpm_ostree_base_match(query)
        )
        unidentified_path = (
            "" if is_package_archive_query(query) or base_image_package
            else unidentified_system_command(query)
        )
        if is_package_archive_query(query):
            print(
                "No installed package matched this archive. "
                "The downloaded archive itself was not removed."
            )
        elif base_image_package:
            print(
                f"{display(base_image_package)} is part of the "
                "rpm-ostree base OS image, "
                "not a layered app. It was not offered as a normal removal."
            )
            print(
                "Changing the base image requires the advanced "
                "'rpm-ostree override remove' workflow."
            )
        elif unidentified_path:
            print(
                f"The command exists at {display(unidentified_path)}, but no "
                "supported package manager proved ownership."
            )
            print(
                "It was not offered as a standalone file because deleting "
                "system-directory commands directly is unsafe."
            )
        else:
            print("No likely installed apps found.")
            if _DIAGNOSTICS:
                print("Some checks could not be completed:")
                for detail in dict.fromkeys(_DIAGNOSTICS):
                    print("  " + display(detail))
        return 1
    prebuilt_plan: RemovalPlan | None = None
    if len(matches) == 1:
        with ThreadPoolExecutor(max_workers=2) as executor:
            matches_future = executor.submit(decorate_matches, matches)
            plan_future = executor.submit(build_removal_plan, matches)
            matches = matches_future.result()
            prebuilt_plan = plan_future.result()
    else:
        matches = decorate_matches(matches)
    try:
        selected = choose(
            matches, auto_select=len(matches) == 1)
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return 130
    if not selected:
        print("Nothing selected.")
        return 0

    for item in selected:
        error = preflight_file(item)
        if error:
            print(f"Cannot safely remove {display(item.name)}: {error}.",
                  file=sys.stderr)
            return 1

    plan = prebuilt_plan or build_removal_plan(selected)
    plan = replace(plan, selected=selected)
    show_compact_impact(plan)
    if plan.level == "BLOCKED":
        return 1

    paths = find_user_data(selected)
    cleanup_kinds, paths_to_remove = ask_cleanup(selected, paths)

    if plan.preview_fingerprint:
        final_plan = build_removal_plan(selected, cleanup_kinds)
        if final_plan.level == "BLOCKED":
            show_compact_impact(final_plan)
            return 1
        changed_transaction = (
            final_plan.planned_removals != plan.planned_removals
            or final_plan.orphan_removals != plan.orphan_removals
            or final_plan.protected_items != plan.protected_items
            or final_plan.level != plan.level
        )
        plan = final_plan
        if changed_transaction:
            print("\nThe final cleanup choice changed the removal plan:")
            show_compact_impact(plan)

    try:
        batches = build_uninstall_batches(selected, cleanup_kinds)
        if plan.preview_fingerprint:
            batches = [
                (
                    items,
                    confirmed_noninteractive_command(
                        pinned_command(command), items[0].kind)
                    if plan.preview_status == PreviewStatus.EXACT.value
                    else pinned_command(command),
                )
                for items, command in batches
            ]
    except RuntimeError as error:
        print(display(error) + ".", file=sys.stderr)
        return 1
    size_bytes, size_complete = removal_space_estimate(
        plan, cleanup_kinds, paths_to_remove)
    print("\n" + ready_heading(size_bytes, size_complete))
    for _items, command in batches:
        print("  " + display(shlex.join(command)))
    for path in paths_to_remove:
        print("  " + display(shlex.join(cleanup_display_command(path))))
    outside_home_data = any(
        not path_is_within(path.absolute(), Path.home().absolute())
        for path in paths_to_remove
    )
    if plan.level in {"HIGH", "UNKNOWN"} or outside_home_data:
        expected = (
            "REMOVE " + display(selected[0].name)
            if len(selected) == 1 else "REMOVE ALL"
        )
        try:
            impact_label = (
                "Data outside your home directory"
                if outside_home_data else
                "Standalone removal"
                if plan.level == "UNKNOWN" and all(
                    item.kind == "Standalone" for item in selected)
                else f"{plan.level.title()}-impact transaction"
            )
            confirmation = input(
                f"\n{impact_label}. "
                f"Type '{expected}' to continue: "
            ).strip()
        except EOFError:
            confirmation = ""
        if confirmation != expected:
            print("Cancelled.")
            return 0
    elif not yes("\nContinue? [y/N] "):
        print("Cancelled.")
        return 0

    if plan.preview_fingerprint:
        for item in selected:
            identity_error = revalidate_package_identity(item)
            if identity_error:
                print(
                    f"Cannot continue with {display(item.name)}: "
                    f"{display(identity_error)}. Nothing was run.",
                    file=sys.stderr,
                )
                return 1
        current_plan = build_removal_plan(selected, cleanup_kinds)
        if current_plan.preview_fingerprint != plan.preview_fingerprint:
            print(
                "The package-manager transaction changed after it was "
                "confirmed. Nothing was run; start the command again.",
                file=sys.stderr,
            )
            return 1

    failed = False
    removed_items: list[Match] = []
    still_installed: list[Match] = []
    unverifiable: list[Match] = []
    failed_items: list[Match] = []
    for items, command in batches:
        names = ", ".join(display(item.name) for item in items)
        kinds = ", ".join(dict.fromkeys(display(item.kind) for item in items))
        print(f"\nRemoving {names} ({kinds})...")
        try:
            result = subprocess.run(command, check=False)
        except OSError as error:
            print(f"Could not run {display(command[0])}: {display(error)}", file=sys.stderr)
            failed = True
            failed_items.extend(items)
            continue
        if result.returncode:
            print(f"Removal failed with exit code {result.returncode}.", file=sys.stderr)
            failed = True
            failed_items.extend(items)
            continue
        if plan.preview_fingerprint:
            for item in items:
                if item.kind == "RPM-OSTree" or (
                        item.kind == "Zypper" and transactional_zypper_system()):
                    unverifiable.append(item)
                    continue
                present = installation_present(item)
                if present is False:
                    removed_items.append(item)
                elif present is True:
                    still_installed.append(item)
                    failed_items.append(item)
                    failed = True
                else:
                    unverifiable.append(item)
    if paths_to_remove:
        safe_cleanup = paths_to_remove
        kept_cleanup: list[Path] = []
        if failed_items:
            failed_keys = data_keys(failed_items)
            successful_keys = data_keys([
                item for item in selected if item not in failed_items
            ])
            safe_cleanup = []
            for path in paths_to_remove:
                key = norm(path.stem if path.suffix == ".desktop" else path.name)
                if key in successful_keys and key not in failed_keys:
                    safe_cleanup.append(path)
                else:
                    kept_cleanup.append(path)
        if safe_cleanup and not remove_paths(safe_cleanup):
            failed = True
        if kept_cleanup:
            print(
                "\nKept data whose application failed or could not be "
                "identified unambiguously: "
                + compact_names(str(path) for path in kept_cleanup)
            )
    if plan.preview_fingerprint and (removed_items or still_installed or unverifiable):
        print("\nResult:")
        if removed_items:
            print("  Removed: " + ", ".join(
                f"{display(item.name)} [{display(item.kind)}]"
                for item in removed_items))
        if still_installed:
            print("  Still installed: " + ", ".join(
                f"{display(item.name)} [{display(item.kind)}]"
                for item in still_installed))
        if unverifiable:
            print("  Pending or unverifiable: " + ", ".join(
                f"{display(item.name)} [{display(item.kind)}]"
                for item in unverifiable))
    print("\nFinished." if not failed else "\nFinished with errors.")
    show_diagnostics()
    return 1 if failed else 0


def self_uninstall() -> int:
    located = shutil.which(sys.argv[0])
    target = Path(located if located else sys.argv[0]).absolute()
    if not target.is_file():
        print("Cannot locate the installed executable.", file=sys.stderr)
        return 1
    print(f"This will remove uninstall itself:\n  {display(target)}")
    if not yes("Continue? [y/N] "):
        print("Cancelled.")
        return 0
    command = ["rm", "--", str(target)]
    try:
        if not os.access(target.parent, os.W_OK):
            command = privileged(command)
        return subprocess.run(command, check=False).returncode
    except (OSError, RuntimeError) as error:
        print(f"Could not remove uninstall: {display(error)}", file=sys.stderr)
        return 1


def json_report(query: str, show_dependencies: bool = False) -> int:
    matches = annotate_roles(find_matches(query))
    matches, hidden = filter_dependency_matches(
        matches, query, show_dependencies)
    matches = decorate_matches(matches)
    results: list[dict[str, object]] = []
    for item in matches:
        plan = build_removal_plan([item])
        results.append({
            "backend": item.kind,
            "id": item.ident,
            "name": item.name,
            "version": item.version,
            "architecture": item.architecture,
            "scope": item.scope,
            "profile": item.profile,
            "installation": item.installation,
            "command_path": item.provides,
            "role": item.role,
            "why_installed": item.reason,
            "installed_size_bytes": item.size_bytes,
            "preview": {
                "status": plan.preview_status,
                "impact": plan.level,
                "planned_removals": plan.planned_removals,
                "unused_dependencies": plan.orphan_removals,
                "protected": plan.protected_items,
                "blockers": plan.blockers,
                "notes": plan.notes,
                "fingerprint": plan.preview_fingerprint,
            },
        })
    print(json.dumps({
        "schema_version": 1,
        "query": query,
        "hidden_dependency_matches": hidden,
        "results": results,
        "diagnostics": list(dict.fromkeys(_DIAGNOSTICS)),
    }, ensure_ascii=False, sort_keys=True))
    return 0 if matches else 1


def exact_noninteractive_remove(
        query: str, backend: str, confirmation: str,
) -> int:
    candidates = [
        item for item in annotate_roles(find_matches(query))
        if item.kind.casefold() == backend.casefold()
        and item.ident.casefold() == query.casefold()
    ]
    if len(candidates) != 1:
        print(
            "Non-interactive removal requires one exact backend and package ID.",
            file=sys.stderr,
        )
        return 2
    selected = decorate_matches(candidates)
    item = selected[0]
    expected = f"REMOVE {item.kind}:{item.ident}"
    if confirmation != expected:
        print(f"Authorization must exactly equal: {expected}", file=sys.stderr)
        return 2
    plan = build_removal_plan(selected, set())
    if plan.preview_status != PreviewStatus.EXACT.value \
            or plan.level not in {"LOW", "CAUTION"}:
        print(
            "Non-interactive removal refuses blocked, unknown, or high-impact "
            "transactions. Run interactively to review it.",
            file=sys.stderr,
        )
        return 1
    try:
        batches = [
            (items, confirmed_noninteractive_command(
                pinned_command(command), items[0].kind))
            for items, command in build_uninstall_batches(selected, set())
        ]
    except RuntimeError as error:
        print(display(error), file=sys.stderr)
        return 1
    repeated = build_removal_plan(selected, set())
    identity_error = revalidate_package_identity(item)
    if identity_error:
        print(display(identity_error), file=sys.stderr)
        return 1
    if repeated.preview_fingerprint != plan.preview_fingerprint:
        print("Transaction changed before execution; nothing was run.", file=sys.stderr)
        return 1
    for _items, command in batches:
        try:
            result = subprocess.run(command, check=False)
        except OSError as error:
            print(display(error), file=sys.stderr)
            return 1
        if result.returncode:
            return result.returncode
    present = installation_present(item)
    if present is True:
        print("The package manager returned success, but the target remains installed.",
              file=sys.stderr)
        return 1
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="uninstall",
        description=(
            "Find, explain, and safely remove installed Linux software."
        ),
        epilog=(
            "Examples:\n"
            "  uninstall FreeCAD          find and remove it\n"
            "  uninstall DOSbox           explain and remove it\n"
            "  uninstall ./example.rpm    resolve a local archive\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "app", nargs="?",
        help="app name, command, package ID, or local package archive")
    parser.add_argument("--self-uninstall", action="store_true",
                        help="remove the uninstall command itself")
    parser.add_argument("--show-dependencies", action="store_true",
                        help="include fuzzy library/dependency search matches")
    parser.add_argument("--json", action="store_true",
                        help="print a read-only machine-readable report")
    parser.add_argument("--debug", action="store_true",
                        help="include backend timing and failure diagnostics")
    parser.add_argument("--backend",
                        help="exact backend for guarded non-interactive removal")
    parser.add_argument("--confirm",
                        help="exact 'REMOVE Backend:package-id' authorization")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    args = parser.parse_args()
    if args.debug:
        os.environ["UNINSTALL_DEBUG"] = "1"
    if os.geteuid() == 0 and os.environ.get("SUDO_USER") not in {None, "", "root"}:
        print("Run uninstall without sudo; it requests privilege only when needed.",
              file=sys.stderr)
        return 2
    if args.self_uninstall:
        if (args.app or args.show_dependencies or args.json
                or args.backend or args.confirm):
            parser.error("--self-uninstall cannot be combined with an app or another mode")
        return self_uninstall()
    if not args.app and args.json:
        parser.error("--json requires an app query")
    if not args.app:
        try:
            args.app = input("What app or command do you want to uninstall? ").strip()
        except EOFError:
            args.app = ""
        if not args.app:
            print("Nothing entered.")
            return 0
    if norm(args.app) == "uninstall" and not (
            args.show_dependencies or args.json or args.backend or args.confirm):
        return self_uninstall()
    if args.json:
        if args.backend or args.confirm:
            parser.error("--json cannot be combined with --backend or --confirm")
        return json_report(args.app, args.show_dependencies)
    if bool(args.backend) != bool(args.confirm):
        parser.error("--backend and --confirm must be used together")
    if args.backend and args.confirm:
        if args.show_dependencies:
            parser.error("non-interactive removal cannot use --show-dependencies")
        return exact_noninteractive_remove(
            args.app, args.backend, args.confirm)
    return run_uninstall(
        args.app, show_dependencies=args.show_dependencies)


if __name__ == "__main__":
    configure_output()
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        raise SystemExit(130)
    except BrokenPipeError:
        try:
            sys.stdout.close()
        finally:
            raise SystemExit(0)
