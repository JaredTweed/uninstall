    prefix = npm_global_prefix()
    try:
        payload = json.loads(capture(["npm", "list", "--global", "--depth=0", "--json"]))
    except (json.JSONDecodeError, TypeError):
        return ()
    dependencies = payload.get("dependencies", {}) if isinstance(payload, dict) else {}
    scope = ("user" if prefix
             and path_is_within(Path(prefix).expanduser(), Path.home())
             else "system")
    found: list[Match] = []
    for name, metadata in dependencies.items():
        version = metadata.get("version", "") if isinstance(metadata, dict) else ""
        found.append(Match("NPM", name, name, version, scope))
    return tuple(found)


def detect_npm(query: str) -> list[Match]:
    found = [item for item in npm_inventory() if relevant(query, item.ident)]
    return found


def cargo_install_root() -> Path:
    return Path(
        os.environ.get("CARGO_INSTALL_ROOT")
        or os.environ.get("CARGO_HOME")
        or Path.home() / ".cargo"
    ).expanduser()


@synchronized_lru_cache(maxsize=1)
def cargo_install_records(
) -> dict[str, tuple[str, str, tuple[str, ...]]]:
    try:
        payload = json.loads((cargo_install_root() / ".crates2.json").read_text(
            encoding="utf-8", errors="replace"))
    except (OSError, json.JSONDecodeError, TypeError):
        return {}
    installs = payload.get("installs", {}) if isinstance(payload, dict) else {}
    if not isinstance(installs, dict):
        return {}
    records: dict[str, tuple[str, str, tuple[str, ...]]] = {}
    pattern = re.compile(r"^(.+?)\s+(\S+)\s+\((.+)\)$")
    for key, details in installs.items():
        match = pattern.match(str(key))
        if not match:
            continue
        ident, version, source = match.groups()
        raw_bins = details.get("bins", []) if isinstance(details, dict) else []
        bins = tuple(
            value for value in raw_bins if isinstance(value, str)
        ) if isinstance(raw_bins, list) else ()
        records[ident] = (version, source, bins)
    return records


def detect_cargo(query: str) -> list[Match]:
    if not shutil.which("cargo"):
        return []
    retained = cargo_install_records()
    if retained:
        found: list[Match] = []
        cargo_bin = (cargo_install_root() / "bin").resolve()
        for crate, (version, _source, binaries) in retained.items():
            if not (relevant(query, crate)
                    or any(relevant(query, item) for item in binaries)):
                continue
            command_path = shutil.which(query) if query in binaries else ""
            if (command_path
                    and Path(command_path).resolve().parent != cargo_bin):
                command_path = ""
            found.append(Match(
                "Cargo", crate, crate, version, "user",
                provides=command_path or "",
            ))
        return found
    found: list[Match] = []
    crate = ""
    version = ""
    binaries: list[str] = []

    def add_crate() -> None:
        if crate and (relevant(query, crate) or any(relevant(query, item) for item in binaries)):
            command_path = shutil.which(query) if query in binaries else ""
            cargo_root = cargo_install_root()
            if (command_path and
                    Path(command_path).resolve().parent != (cargo_root / "bin").resolve()):
                command_path = ""
            found.append(Match("Cargo", crate, crate, version, "user",
                               provides=command_path or ""))

    for line in capture(["cargo", "install", "--list"]).splitlines():
        if line and not line[0].isspace() and line.endswith(":"):
            add_crate()
            header = line[:-1].rsplit(maxsplit=1)
            crate = header[0]
            version = header[1].lstrip("v") if len(header) > 1 else ""
            binaries = []
        elif crate and line.strip():
            binaries.append(line.strip())
    add_crate()
    return found


def parse_nix_profile(text: str) -> list[tuple[str, list[str]]]:
    entries: list[tuple[str, list[str]]] = []
    for block in text.split("\n\n"):
        fields: dict[str, str] = {}
        for line in block.splitlines():
            key, separator, value = line.partition(":")
            if separator:
                fields[key.strip()] = value.strip()
        ident = fields.get("Name") or fields.get("Index")
        stores = fields.get("Store paths", "").split()
        if ident and stores:
            entries.append((ident, stores))
    return entries


def parse_nix_profile_json(text: str) -> list[tuple[str, list[str]]]:
    try:
        payload = json.loads(text)
    except (json.JSONDecodeError, TypeError):
        return []
    if not isinstance(payload, dict):
        return []
    elements = payload.get("elements", payload)
    if not isinstance(elements, dict):
        return []
    entries: list[tuple[str, list[str]]] = []
    for ident, metadata in elements.items():
        if not isinstance(ident, str) or not isinstance(metadata, dict):
            continue
        raw_paths = metadata.get("storePaths", metadata.get("store_paths", []))
        stores = [
            path for path in raw_paths
            if isinstance(path, str)
        ] if isinstance(raw_paths, list) else []
        if stores:
            entries.append((ident, stores))
    return entries


def detect_nix(query: str) -> list[Match]:
    has_nix = bool(shutil.which("nix"))
    if not has_nix and not shutil.which("nix-env"):
        return []
    executable = find_executable(query) if Path(query).name == query else None
    resolved = str(Path(executable).resolve()) if executable else ""
    found: list[Match] = []
    entries_found = False
    for profile in nix_profile_paths() if has_nix else ():
        metadata = nix_profile_metadata(profile)
        entries: list[tuple[str, list[str]]] = []
        for ident, details in metadata.items():
            raw_paths = details.get(
                "storePaths", details.get("store_paths", []))
            stores = [
                path for path in raw_paths if isinstance(path, str)
            ] if isinstance(raw_paths, list) else []
            if stores:
                entries.append((ident, stores))
        if not entries and not profile:
            entries = parse_nix_profile(capture(["nix", "profile", "list"]))
        entries_found = entries_found or bool(entries)
        for ident, stores in entries:
            owns_command = bool(resolved) and any(
                resolved == store or resolved.startswith(store.rstrip("/") + "/")
                for store in stores
            )
            if relevant(query, ident) or owns_command:
                found.append(Match(
                    "Nix", ident, ident, "", "user",
                    provides=str(Path(executable).absolute())
                    if owns_command and executable else "",
                    profile=profile,
                ))
    if found or entries_found or not shutil.which("nix-env"):
        return found
    for record in nix_env_inventory():
        owns_command = bool(resolved and record.origin) and (
            resolved == record.origin
            or resolved.startswith(record.origin.rstrip("/") + "/")
        )
        if relevant(query, record.ident) or owns_command:
            found.append(Match(
                "Nix Legacy", record.ident, record.ident, record.version,
                "user", provides=(str(Path(executable).absolute())
                                  if owns_command and executable else ""),
                origin=record.origin,
            ))
    return found


@synchronized_lru_cache(maxsize=1)
def nix_env_inventory() -> tuple[PackageRecord, ...]:
    if not shutil.which("nix-env"):
        return ()
    records: list[PackageRecord] = []
    for line in capture([
            "nix-env", "--query", "--installed", "--out-path",
    ]).splitlines():
        fields = line.split(maxsplit=1)
        if not fields:
            continue
        match = re.match(r"^(.+)-([0-9][^\s]*)$", fields[0])
        name = match.group(1) if match else fields[0]
        version = match.group(2) if match else ""
        records.append(PackageRecord(
            name, version,
            origin=fields[1] if len(fields) > 1 else "",
        ))
    return tuple(records)


def guix_profile_path() -> Path:
    return Path(
        os.environ.get("GUIX_PROFILE") or Path.home() / ".guix-profile"
    ).expanduser()


@synchronized_lru_cache(maxsize=1)
def guix_inventory() -> tuple[PackageRecord, ...]:
    if not shutil.which("guix"):
        return ()
    profile = guix_profile_path()
    records: list[PackageRecord] = []
    for line in capture([
            "guix", "package", f"--profile={profile}", "--list-installed",
    ]).splitlines():
        fields = line.split()
        if len(fields) < 2:
            continue
        store = next((value for value in fields[2:]
                      if value.startswith("/gnu/store/")), "")
        records.append(PackageRecord(
            fields[0], fields[1], origin=store))
    return tuple(records)


def detect_guix(query: str) -> list[Match]:
    if not shutil.which("guix"):
        return []
    executable = find_executable(query) if Path(query).name == query else None
    resolved = str(Path(executable).resolve()) if executable else ""
    profile = str(guix_profile_path())
    found: list[Match] = []
    for record in guix_inventory():
        owns_command = bool(resolved and record.origin) and (
            resolved == record.origin
            or resolved.startswith(record.origin.rstrip("/") + "/")
        )
        if relevant(query, record.ident) or owns_command:
            found.append(Match(
                "Guix", record.ident, record.ident, record.version, "user",
                provides=(str(Path(executable).absolute())
                          if owns_command and executable else ""),
                origin=profile,
            ))
    return found


def path_after(parts: tuple[str, ...], marker: str) -> list[str]:
    try:
        index = parts.index(marker)
    except ValueError:
        return []
    return list(parts[index + 1:])


def snap_command_owner(query: str, visible: Path) -> list[Match]:
    snap_roots = (Path("/snap/bin"), Path("/var/lib/snapd/snap/bin"))
    if not any(visible.parent == root for root in snap_roots) or not shutil.which("snap"):
        return []
    package = visible.name.split(".", 1)[0]
    for line in capture(["snap", "aliases"]).splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 2 and fields[1] == visible.name:
            package = fields[0].split(".", 1)[0]
            break
    for item in snap_inventory():
        if item.ident == package:
            return [replace(item, provides=str(visible))]
    return []


def flatpak_command_owner(visible: Path) -> list[Match]:
    path_text = str(visible)
    if "/flatpak/exports/bin/" not in path_text or not shutil.which("flatpak"):
        return []
    app_id = visible.name
    found: list[Match] = []
    for scope, installation in flatpak_locations():
        for item in flatpak_inventory(scope, installation):
            if item.ident == app_id:
                found.append(replace(item, provides=str(visible)))
    return found


def package_owner_from_output(
        output: str, records: Iterable[PackageRecord], kind: str,
        visible: Path,
) -> list[Match]:
    for record in records:
        if re.search(
                rf"(?<![A-Za-z0-9+_.-]){re.escape(record.ident)}"
                rf"(?:-{re.escape(record.version)})?(?![A-Za-z0-9+_.-])",
                output):
            return [Match(
                kind, record.ident,
                (record.ident.rsplit("/", 1)[-1]
                 if kind == "Portage" else record.ident),
                record.version, "system", provides=str(visible),
                size_bytes=record.size_bytes, origin=record.origin,
            )]
    return []


def portage_command_owner(resolved: Path, visible: Path) -> list[Match]:
    target = str(resolved)
    for record in portage_inventory():
        for contents_path in record.files:
            try:
                lines = Path(contents_path).read_text(
                    encoding="utf-8", errors="replace").splitlines()
            except OSError:
                continue
            if any(
                    line.startswith((f"obj {target} ", f"sym {target} -> "))
                    for line in lines):
                return [Match(
                    "Portage", record.ident,
                    record.ident.rsplit("/", 1)[-1], record.version,
                    portage_scope(), provides=str(visible),
                    size_bytes=record.size_bytes, origin=record.origin,
                )]
    return []


def slackware_command_owner(resolved: Path, visible: Path) -> list[Match]:
    target = str(resolved)
    for record in slackware_inventory():
        if target in record.files:
            return [Match(
                "Slackware", record.ident, record.ident, record.version,
                "system", provides=str(visible),
                size_bytes=record.size_bytes,
            )]
    return []


def detect_executable_owner(query: str) -> list[Match]:
    """Find the package owning a command, or identify a standalone command."""
    if not query or Path(query).name != query:
        return []
    executable = find_executable(query)
    if not executable:
        return []
    visible = Path(executable).absolute()
    resolved = Path(executable).resolve()
    path = str(resolved)
    found: list[Match] = []
    base_image_owner = False
    appimage_candidate: Match | None = None

    managed = snap_command_owner(query, visible) or flatpak_command_owner(visible)
    if managed:
        return managed
    if (visible.parent in {Path("/snap/bin"), Path("/var/lib/snapd/snap/bin")}
            or "/flatpak/exports/bin/" in str(visible)):
        return []

    appimage_magic = is_appimage_file(resolved)
    if ((appimage_magic
            or (visible.name.casefold().endswith(".appimage")
                and not visible.is_symlink()))
            and safe_standalone_location(visible)):
        target = resolved if visible.is_symlink() else visible
        scope = "user" if path_is_within(target, Path.home()) else "system"
        appimage_candidate = Match(
            "AppImage", str(target), target.stem, "", scope, target,
            provides=str(visible) if visible != target else "",
        )

    brew_parts = path_after(resolved.parts, "Cellar")
    brew_cellar = capture(["brew", "--cellar"]).strip() if shutil.which("brew") else ""
    in_brew_cellar = bool(
        brew_cellar and path_is_within(resolved, Path(brew_cellar).resolve())
    )
    if brew_parts and in_brew_cellar:
        formula = brew_parts[0]
        details = capture(["brew", "list", "--formula", "--versions", formula]).strip()
        if details:
            fields = details.split()
            return [Match("Homebrew", formula, formula, " ".join(fields[1:]),
                          "user", provides=str(visible))]

    pipx_parts = path_after(resolved.parts, "venvs")
    if pipx_parts and "/pipx/venvs/" in path and shutil.which("pipx"):
        scope = "user" if path_is_within(visible, Path.home()) else "system"
        return [Match("Pipx", pipx_parts[0], pipx_parts[0], "", scope,
                      provides=str(visible))]

    node_parts = path_after(resolved.parts, "node_modules")
    npm_prefix = (
        npm_global_prefix()
        if node_parts and shutil.which("npm") else ""
    )
    npm_prefix_path = Path(npm_prefix).resolve() if npm_prefix else None
    npm_exposed = bool(
        npm_prefix_path and visible.parent.resolve() == npm_prefix_path / "bin"
    )
    if node_parts and npm_exposed:
        package = ("/".join(node_parts[:2]) if node_parts[0].startswith("@")
                   and len(node_parts) > 1 else node_parts[0])
        scope = "user" if path_is_within(visible, Path.home()) else "system"
        return [Match("NPM", package, package, "", scope,
                      provides=str(visible))]

    if shutil.which("apk"):
        owned = package_owner_from_output(
            capture(["apk", "info", "--who-owns", path]),
            apk_inventory(), "APK", visible)
        if owned:
            return owned

    if shutil.which("opkg"):
        owned = package_owner_from_output(
            capture(["opkg", "search", path]),
            opkg_inventory(), "OPKG", visible)
        if owned:
            return owned

    if shutil.which("xbps-query"):
        owned = package_owner_from_output(
            capture(["xbps-query", "--ownedby", path]),
            xbps_inventory(), "XBPS", visible)
        if owned:
            return owned

    if shutil.which("emerge"):
        owned = portage_command_owner(resolved, visible)
        if owned:
            return owned

    if shutil.which("removepkg"):
        owned = slackware_command_owner(resolved, visible)
        if owned:
            return owned

    if shutil.which("eopkg"):
        owned = package_owner_from_output(
            capture(["eopkg", "search-file", path]),
            eopkg_inventory(), "Eopkg", visible)
        if owned:
            return owned

    kind = rpm_manager()
    if kind and shutil.which("rpm"):
        fmt = "%{NAME}\\t%{VERSION}-%{RELEASE}\\t%{ARCH}\\n"
        for owner_path in dict.fromkeys((path, str(visible))):
            for line in capture(["rpm", "-qf", "--qf", fmt, owner_path]).splitlines():
                fields = line.split("\t", 2)
                if fields and fields[0]:
                    if kind == "RPM-OSTree":
                        layered_ok, layered = rpm_ostree_layered_packages()
                        if not layered_ok or fields[0] not in layered:
                            base_image_owner = True
                            continue
                    architecture = fields[2] if len(fields) > 2 else ""
                    ident = (
                        f"{fields[0]}.{architecture}"
                        if architecture else fields[0])
                    found.append(Match(
                        kind, ident, fields[0],
                        fields[1] if len(fields) > 1 else "",
                        "system", provides=str(visible),
                        architecture=architecture,
                    ))

    if shutil.which("dpkg-query"):
        fmt = "${db:Status-Abbrev}\\t${binary:Package}\\t${Version}\\n"
        for owner_path in dict.fromkeys((path, str(visible))):
            for owner_line in capture(["dpkg-query", "-S", owner_path]).splitlines():
                owner, separator, _owned_path = owner_line.rpartition(": ")
                if not separator or not owner:
                    continue
                details = capture(["dpkg-query", "-W", "-f=" + fmt, owner]).strip()
                fields = details.split("\t", 2)
                installed = fields and len(fields[0]) > 1 and fields[0][1] == "i"
                if installed and len(fields) >= 2:
                    found.append(Match("APT", fields[1], fields[1],
                                       fields[2] if len(fields) > 2 else "",
                                       "system", provides=str(visible)))

    if shutil.which("pacman"):
        for owner_path in dict.fromkeys((path, str(visible))):
            for owner in capture(["pacman", "-Qoq", owner_path]).splitlines():
                fields = capture(["pacman", "-Q", owner.strip()]).strip().rsplit(maxsplit=1)
                if fields:
                    found.append(Match("Pacman", fields[0], fields[0],
                                       fields[1] if len(fields) > 1 else "",
                                       "system", provides=str(visible)))
    if found:
        return found
    if base_image_owner:
        return []
    if appimage_candidate:
        return [appimage_candidate]
    if not found:
        protected_markers = (
            "/nix/store/", "/node_modules/", "/pipx/venvs/",
            "/flatpak/", "/snap/", "/Cellar/",
        )
        if any(marker in path for marker in protected_markers):
            return []
        scope = "user" if path_is_within(visible, Path.home()) else "system"
        if safe_standalone_location(visible):
            found.append(Match("Standalone", str(visible), query, "",
                               scope, path=visible))
    return found


def unidentified_system_command(query: str) -> str:
    if not query or Path(query).name != query:
        return ""
    executable = find_executable(query)
    if not executable:
        return ""
    visible = Path(executable).absolute()
    return "" if safe_standalone_location(visible) else str(visible)


def rpm_ostree_base_match(query: str) -> str:
    """Return an exact base-image RPM match that normal uninstall must not stage."""
    if rpm_manager() != "RPM-OSTree" or not shutil.which("rpm"):
        return ""
    layered_ok, layered = rpm_ostree_layered_packages()
    if not layered_ok:
        return ""
    candidates: list[str] = []
    executable = shutil.which(query) if Path(query).name == query else ""
    if executable:
        visible = Path(executable).absolute()
        candidates.extend(dict.fromkeys((
            str(visible.resolve()), str(visible),
        )))
    elif Path(query).name == query:
        candidates.append(query)
    for candidate in candidates:
        option = "-qf" if "/" in candidate else "-q"
        name = capture([
            "rpm", option, "--qf", "%{NAME}\\n", "--", candidate,
        ]).strip().splitlines()
        if name and name[0] not in layered:
            return name[0]
    return ""


def detect_appimages(query: str) -> list[Match]:
    explicit = Path(query).expanduser()
    if ("/" in query and explicit.is_file()
            and (explicit.name.casefold().endswith(".appimage")
                 or is_appimage_file(explicit))):
        visible = explicit.absolute()
        resolved = visible.resolve()
        path = (
            resolved
            if visible.is_symlink() and is_appimage_file(resolved)
            else visible
        )
        scope = "user" if path_is_within(path, Path.home()) else "system"
        return [Match(
            "AppImage", str(path), path.stem, "", scope, path,
            provides=str(visible) if visible != path else "",
        )]
    roots = [
        Path.home() / "Applications", Path.home() / ".local/bin",
        Path.home() / "Downloads", Path.home() / "Desktop",
        Path("/opt"), Path("/usr/local/bin"),
    ]
    found: list[Match] = []
    seen: set[Path] = set()
    for root in roots:
        if not root.is_dir():
            continue
        try:
            for current, dirs, files in os.walk(root):
                relative_depth = len(Path(current).relative_to(root).parts)
                if relative_depth >= 2:
                    dirs[:] = []
                for filename in files:
                    path = Path(current) / filename
                    if (filename.casefold().endswith(".appimage")
                            and relevant(query, filename)
                            and path not in seen):
                        seen.add(path)
                        found.append(Match("AppImage", str(path), path.stem, "",
                                           "user" if path_is_within(path, Path.home()) else "system", path))
        except OSError:
            continue
    return found


def detect_package_archive(query: str) -> list[Match]:
    """Resolve a local package archive to the corresponding installed package."""
    candidate = Path(query).expanduser()
    if not candidate.is_file():
        return []
    archive = candidate.absolute()
    lowered = archive.name.casefold()

    if lowered.endswith(".rpm") and shutil.which("rpm"):
        archive_format = "%{NAME}\\t%{VERSION}-%{RELEASE}\\t%{ARCH}\\n"
        fields = capture([
            "rpm", "-qp", "--qf", archive_format, "--", str(archive),
        ]).strip().split("\t")
        if len(fields) != 3:
            return []
        name, archive_version, architecture = fields
        installed_format = "%{NAME}\\t%{VERSION}-%{RELEASE}\\t%{ARCH}\\n"
        installed = capture([
            "rpm", "-q", "--qf", installed_format,
            "--", f"{name}.{architecture}",
        ]).splitlines()
        for line in installed:
            installed_fields = line.split("\t")
            if len(installed_fields) == 3 and installed_fields[0] == name:
                kind = rpm_manager()
                if kind == "RPM-OSTree":
                    layered_ok, layered = rpm_ostree_layered_packages()
                    if not layered_ok or name not in layered:
                        return []
                identifier = f"{name}.{architecture}" if architecture else name
                return [Match(
                    kind, identifier, name, installed_fields[1], "system",
                    archive=archive, archive_version=archive_version,
                    architecture=architecture,
                )]
        return []

    if lowered.endswith(".deb") and shutil.which("dpkg-deb"):
        archive_format = (
            "${Package}\\t${Version}\\t${Architecture}\\n"
        )
        fields = capture([
            "dpkg-deb", "--show", "--showformat=" + archive_format,
            str(archive),
        ]).strip().split("\t")
        if len(fields) != 3:
            return []
        name, archive_version, architecture = fields
        installed_format = (
            "${db:Status-Abbrev}\\t${binary:Package}\\t${Version}\\n"
        )
        identifiers = (
            [f"{name}:{architecture}"]
            if architecture not in {"", "all"} else [name]
        )
        for identifier in identifiers:
            installed = capture([
                "dpkg-query", "-W", "-f=" + installed_format, identifier,
            ]).strip().split("\t")
            is_installed = (
                len(installed) == 3 and len(installed[0]) > 1
                and installed[0][1] == "i"
            )
            if is_installed:
                return [Match(
                    "APT", installed[1], installed[1], installed[2], "system",
                    archive=archive, archive_version=archive_version,
                    architecture=architecture,
                )]
        return []

    if (".pkg.tar." in lowered and shutil.which("pacman")):
        archive_fields = capture(
            ["pacman", "-Qp", str(archive)]).strip().rsplit(maxsplit=1)
        if len(archive_fields) != 2:
            return []
        name, archive_version = archive_fields
        installed_fields = capture(
            ["pacman", "-Q", name]).strip().rsplit(maxsplit=1)
        if len(installed_fields) == 2 and installed_fields[0] == name:
            return [Match(
                "Pacman", name, name, installed_fields[1], "system",
                archive=archive, archive_version=archive_version,
            )]
        return []

    if lowered.endswith(".apk") and shutil.which("apk"):
        try:
            with tarfile.open(archive, "r:*") as package:
                member = next((
                    item for item in package.getmembers()
                    if item.name.lstrip("./") == ".PKGINFO"
                ), None)
                stream = package.extractfile(member) if member else None
                metadata = stream.read().decode(
                    "utf-8", errors="replace") if stream else ""
        except (OSError, tarfile.TarError):
            metadata = ""
        fields = dict(
            line.split(" = ", 1) for line in metadata.splitlines()
            if " = " in line
        )
        name = fields.get("pkgname", "")
        installed = apk_inventory_by_name().get(name)
        if installed:
            return [Match(
                "APK", name, name, installed.version, "system",
                archive=archive, archive_version=fields.get("pkgver", ""),
                architecture=fields.get("arch", ""),
            )]
        return []

    if lowered.endswith((".ipk", ".opk")) and shutil.which("opkg"):
        control = read_ar_control(archive)
        records = parse_control_records(control)
        fields = records[0] if records else {}
        name = fields.get("Package", "")
        installed = opkg_inventory_by_name().get(name)
        if installed:
            return [Match(
                "OPKG", name, name, installed.version, "system",
                archive=archive, archive_version=fields.get("Version", ""),
                architecture=fields.get("Architecture", ""),
            )]
        return []

    if lowered.endswith(".xbps") and shutil.which("xbps-query"):
        stem = archive.name[:-5]
        pkgver_arch = stem.rsplit(".", 1)[0]
        name, archive_version = split_xbps_pkgver(pkgver_arch)
        installed = xbps_inventory_by_name().get(name)
        if installed:
            return [Match(
                "XBPS", name, name, installed.version, "system",
                archive=archive, archive_version=archive_version,
            )]
        return []

    if lowered.endswith((".txz", ".tgz")) and shutil.which("removepkg"):
        fields = archive.name.rsplit(".", 1)[0].rsplit("-", 3)
        if len(fields) == 4:
            name, archive_version = fields[0], fields[1]
            installed = slackware_inventory_by_name().get(name)
            if installed:
                return [Match(
                    "Slackware", name, name, installed.version, "system",
                    archive=archive, archive_version=archive_version,
                    architecture=fields[2],
                )]
        return []

    if lowered.endswith(".eopkg") and shutil.which("eopkg"):
        output = capture(["eopkg", "info", str(archive)])
        name_match = re.search(r"(?im)^Name\s*:\s*(\S+)", output)
        version_match = re.search(r"(?im)^Version\s*:\s*(\S+)", output)
        name = name_match.group(1) if name_match else ""
        installed = next((
            record for record in eopkg_inventory() if record.ident == name
        ), None)
        if installed:
            return [Match(
                "Eopkg", name, name, installed.version, "system",
                archive=archive,
                archive_version=(version_match.group(1) if version_match else ""),
            )]
        return []

    if lowered.endswith((".flatpak", ".flatpakref")) \
            and shutil.which("flatpak"):
        ident = ""
        if lowered.endswith(".flatpakref"):
            try:
                content = archive.read_text(
                    encoding="utf-8", errors="replace")
            except OSError:
                content = ""
            match = re.search(r"(?im)^Name\s*=\s*(\S+)", content)
            ident = match.group(1) if match else ""
        else:
            reference = capture([
                "flatpak", "info", "--show-ref", str(archive),
            ]).strip()
            parts = reference.split("/")
            ident = parts[1] if len(parts) >= 4 and parts[0] == "app" else ""
        for item in detect_flatpak(ident):
            if item.ident == ident:
                return [replace(item, archive=archive)]
    return []


def read_ar_control(path: Path) -> str:
    """Read an opkg/deb-style control archive without extracting files."""
    try:
        payload = path.read_bytes()
    except OSError:
        return ""
    if not payload.startswith(b"!<arch>\n"):
        return ""
    offset = 8
    while offset + 60 <= len(payload):
        header = payload[offset:offset + 60]
        name = header[:16].decode("ascii", errors="replace").strip().rstrip("/")
        raw_size = header[48:58].decode("ascii", errors="replace").strip()
        if not raw_size.isdigit():
            return ""
        size = int(raw_size)
        data = payload[offset + 60:offset + 60 + size]
        if name.startswith("control.tar"):
            try:
                with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as control:
                    member = next((
                        item for item in control.getmembers()
                        if item.name.lstrip("./") == "control"
                    ), None)
                    stream = control.extractfile(member) if member else None
                    return stream.read().decode(
                        "utf-8", errors="replace") if stream else ""
            except (OSError, tarfile.TarError):
                return ""
        offset += 60 + size + (size % 2)
    return ""


def is_package_archive_query(query: str) -> bool:
    candidate = Path(query).expanduser()
    lowered = candidate.name.casefold()
    return candidate.is_file() and (
        lowered.endswith((
            ".rpm", ".deb", ".apk", ".ipk", ".opk", ".xbps",
            ".txz", ".tgz", ".eopkg", ".flatpak", ".flatpakref",
        )) or ".pkg.tar." in lowered
    )


