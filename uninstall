@lru_cache(maxsize=1)
def portage_world() -> set[str]:
    try:
        lines = (portage_prefix() / "var/lib/portage/world").read_text(
            encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return set()
    installed = portage_inventory_by_name()
    explicit: set[str] = set()
    for raw in lines:
        atom = raw.strip()
        if not atom or atom.startswith(("#", "@")):
            continue
        atom = atom.lstrip("<>=~!")
        atom = atom.split("[", 1)[0].split(":", 1)[0]
        if atom in installed:
            explicit.add(atom)
            continue
        candidates = [ident for ident in installed if atom.startswith(ident + "-")]
        if candidates:
            explicit.add(max(candidates, key=len))
    return explicit


