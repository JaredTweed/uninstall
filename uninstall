    for record in apt_inventory():
        if relevant(query, record.ident, record.summary):
            found.append(Match(
                "APT", record.ident, record.ident, record.version, "system",
                size_bytes=record.size_bytes,
            ))
    return found


def detect_rpm(query: str) -> list[Match]:
    if not shutil.which("rpm"):
        return []
    kind = rpm_manager()
    if not kind:
        return []
    layered_ok, layered = (
        rpm_ostree_layered_packages()
        if kind == "RPM-OSTree" else (True, set())
    )
    if kind == "RPM-OSTree" and not layered_ok:
        return []
    found: list[Match] = []
    normalized_query = norm(query)
    for name, records in rpm_inventory_by_name().items():
        record = records[-1]
        architecture_identities = {
            norm(f"{name}.{item.architecture}"): item
            for item in records if item.architecture
        }
        exact_architecture = architecture_identities.get(normalized_query)
        if ((kind != "RPM-OSTree" or name in layered) and (
                relevant(query, name, record.summary)
                or exact_architecture is not None
        )):
            if any(item.architecture for item in records):
                displayed_records = (
                    (exact_architecture,) if exact_architecture else records)
                for installed in displayed_records:
                    ident = f"{name}.{installed.architecture}"
                    found.append(Match(
                        kind, ident, name, installed.version, "system",
                        size_bytes=installed.size_bytes,
                        architecture=installed.architecture,
                    ))
            else:
                retained_sizes = [
                    item.size_bytes for item in records
                    if item.size_bytes is not None
                ]
                found.append(Match(
                    kind, name, name, record.version, "system",
                    size_bytes=(sum(retained_sizes) if retained_sizes else None),
                ))
    return found


def detect_pacman(query: str) -> list[Match]:
