@dataclass(frozen=True)
class Match:
    kind: str
    ident: str
    name: str
    version: str = ""
    scope: str = ""
    path: Path | None = None
    provides: str = ""
    role: str = "unknown"
    archive: Path | None = None
    archive_version: str = ""
    reason: str = ""
    size_bytes: int | None = None


@dataclass
class DependencyReport:
    target: Match
