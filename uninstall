def dependency_name(value: str) -> str:
    """Strip a package-manager version constraint from a dependency token."""
    return re.split(r"[<>=~]", value.lstrip("!"), maxsplit=1)[0].strip()


def apk_constraint_name(value: str) -> str:
    """Return the provided name from an APK world constraint, excluding its tag."""
    return dependency_name(value).split("@", 1)[0]


def parse_apk_installed(text: str) -> tuple[PackageRecord, ...]:
    records: list[PackageRecord] = []
    for block in re.split(r"\n\s*\n", text):
        fields: dict[str, str] = {}
        for line in block.splitlines():
            if len(line) >= 2 and line[1] == ":":
                fields[line[0]] = line[2:].strip()
        name = fields.get("P", "")
        if not name:
            continue
        records.append(PackageRecord(
            ident=name,
            version=fields.get("V", ""),
            summary=fields.get("T", ""),
            size_bytes=(int(fields["I"])
                        if fields.get("I", "").isdigit() else None),
            depends=tuple(fields.get("D", "").split()),
            provides=tuple(fields.get("p", "").split()),
            origin=fields.get("o", ""),
        ))
    return tuple(records)


@synchronized_lru_cache(maxsize=1)
def apk_inventory() -> tuple[PackageRecord, ...]:
    if not shutil.which("apk"):
        return ()
    try:
        text = Path("/lib/apk/db/installed").read_text(
            encoding="utf-8", errors="replace")
    except OSError:
        text = ""
    parsed = parse_apk_installed(text)
    if parsed:
        return parsed
    records: list[PackageRecord] = []
    for line in capture(["apk", "info", "--verbose"]).splitlines():
        match = re.match(r"^(.+)-([0-9][^\s]*-r\d+)$", line.strip())
        if match:
            records.append(PackageRecord(match.group(1), match.group(2)))
    return tuple(records)


@synchronized_lru_cache(maxsize=1)
def apk_inventory_by_name() -> dict[str, PackageRecord]:
    return {record.ident: record for record in apk_inventory()}


@lru_cache(maxsize=1)
def apk_world() -> tuple[str, ...]:
    try:
        lines = Path("/etc/apk/world").read_text(
            encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ()
    return tuple(
        line.strip() for line in lines
        if line.strip() and not line.lstrip().startswith("#")
    )


@lru_cache(maxsize=1)
def apk_provider_map() -> dict[str, set[str]]:
    providers: dict[str, set[str]] = defaultdict(set)
    for record in apk_inventory():
        providers[record.ident].add(record.ident)
        for capability in record.provides:
            name = dependency_name(capability)
            if name:
                providers[name].add(record.ident)
    return dict(providers)


@lru_cache(maxsize=1)
def apk_explicit_causes() -> dict[str, str]:
    providers = apk_provider_map()
    causes: dict[str, str] = {}
    for constraint in apk_world():
        capability = apk_constraint_name(constraint)
        for package in providers.get(capability, set()):
            causes.setdefault(package, constraint)
    return causes


def detect_apk(query: str) -> list[Match]:
    return [
        Match(
            "APK", record.ident, record.ident, record.version, "system",
            size_bytes=record.size_bytes, origin=record.origin,
        )
        for record in apk_inventory()
        if relevant(query, record.ident, record.summary)
    ]


def parse_control_records(text: str) -> list[dict[str, str]]:
    records: list[dict[str, str]] = []
    for block in re.split(r"\n\s*\n", text):
        fields: dict[str, str] = {}
        current = ""
        for line in block.splitlines():
            if ":" in line and not line[:1].isspace():
                current, value = line.split(":", 1)
                fields[current] = value.strip()
            elif current and line[:1].isspace():
                fields[current] += " " + line.strip()
        if fields:
            records.append(fields)
    return records


def parse_opkg_status(text: str) -> tuple[PackageRecord, ...]:
    records: list[PackageRecord] = []
    for fields in parse_control_records(text):
        status = fields.get("Status", "")
        name = fields.get("Package", "")
        if not name or " installed" not in status:
            continue
        role = (
            "explicit" if " user " in f" {status} " else
            "dependency" if fields.get(
                "Auto-Installed", "").casefold() == "yes" else
            "base"
        )
        records.append(PackageRecord(
            ident=name,
            version=fields.get("Version", ""),
            summary=fields.get("Description", ""),
            size_bytes=(int(fields["Installed-Size"])
                        if fields.get("Installed-Size", "").isdigit()
                        else None),
            depends=tuple(
                value.strip() for value in fields.get("Depends", "").split(",")
                if value.strip()),
            provides=tuple(
                value.strip() for value in fields.get("Provides", "").split(",")
                if value.strip()),
            origin=role,
        ))
    return tuple(records)


