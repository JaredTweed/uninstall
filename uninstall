@lru_cache(maxsize=16384)
def norm(value: str) -> str:
    decomposed = unicodedata.normalize("NFKD", value.casefold())
    return "".join(
        char for char in decomposed
        if char.isalnum() and not unicodedata.combining(char)
    )


def display(value: object) -> str:
    """Make untrusted package metadata safe to print to a terminal."""
    text = str(value)
    return "".join(
        char if char.isprintable() and char not in "\x1b\x7f" else "?"
        for char in text
    )


def compact_names(values: Iterable[str], limit: int = 8) -> str:
    names = list(dict.fromkeys(display(value) for value in values))
    shown = names[:limit]
    suffix = f", plus {len(names) - limit} more" if len(names) > limit else ""
    return ", ".join(shown) + suffix


def format_size(size_bytes: int) -> str:
    value = float(max(size_bytes, 0))
    units = ("B", "KiB", "MiB", "GiB", "TiB", "PiB")
    unit = units[0]
    for unit in units:
        if value < 1024 or unit == units[-1]:
            break
        value /= 1024
    if unit == "B":
        return f"{int(value)} B"
    if value >= 10:
        return f"{value:.0f} {unit}"
    rendered = f"{value:.1f}".rstrip("0").rstrip(".")
    return f"{rendered} {unit}"


def parse_size(value: str) -> int | None:
    match = re.search(
        r"(?i)(\d+(?:[.,]\d+)?)\s*"
        r"(bytes?|[kmgtpe]?i?b)\b",
        value.replace("\N{NO-BREAK SPACE}", " "),
    )
    if not match:
        stripped = value.strip()
        return int(stripped) if stripped.isdigit() else None
    number = float(match.group(1).replace(",", "."))
    unit = match.group(2).casefold()
    powers = {
        "b": 0, "byte": 0, "bytes": 0,
        "kb": 1, "kib": 1,
        "mb": 2, "mib": 2,
        "gb": 3, "gib": 3,
        "tb": 4, "tib": 4,
        "pb": 5, "pib": 5,
        "eb": 6, "eib": 6,
    }
    power = powers.get(unit)
    return None if power is None else int(number * (1024 ** power))


@lru_cache(maxsize=256)
def path_disk_size(path_text: str) -> int | None:
    path = Path(path_text)
    if not path.exists() and not path.is_symlink():
        return 0
    code, output = capture_any(
        ["du", "-sk", "--", str(path)], timeout=15)
    if code != 0:
        return None
    first_line = output.splitlines()[0] if output.splitlines() else ""
    fields = first_line.split(maxsplit=1)
    return int(fields[0]) * 1024 if fields and fields[0].isdigit() else None


def path_disk_sizes(paths: Iterable[Path]) -> dict[Path, int | None]:
    unique = list(dict.fromkeys(path.absolute() for path in paths))
    if not unique:
        return {}
    if len(unique) == 1:
        return {unique[0]: path_disk_size(str(unique[0]))}
    code, output = capture_any(
        ["du", "-sk", "--", *(str(path) for path in unique)], timeout=30)
    measured: dict[str, int] = {}
    for line in output.splitlines():
        fields = line.split(maxsplit=1)
        if len(fields) == 2 and fields[0].isdigit():
            measured[str(Path(fields[1]).absolute())] = int(fields[0]) * 1024
    return {
        path: measured.get(str(path), 0 if not path.exists() else None)
        for path in unique
    } if code in {0, 1} else {path: None for path in unique}


def file_disk_size(path: Path) -> int | None:
    try:
        details = path.lstat() if path.is_symlink() else path.stat()
    except OSError:
        return None
    blocks = getattr(details, "st_blocks", 0)
    return blocks * 512 if blocks else details.st_size


@lru_cache(maxsize=256)
def package_installed_size(
        kind: str, ident: str, scope: str, path_text: str = "",
        installation: str = "",
) -> int | None:
    if kind == "Flatpak":
        scope_option = (
            f"--installation={installation}" if installation else f"--{scope}")
        output = capture([
            "flatpak", "info", scope_option, "--show-size", ident,
        ]).strip()
        return int(output) if output.isdigit() else parse_size(output)
    if kind == "APT":
        record = apt_inventory_by_name().get(ident)
        if not record:
            record = apt_inventory_by_name().get(package_base(ident))
        if record and record.size_bytes is not None:
            return record.size_bytes
        output = capture([
            "dpkg-query", "-W", "-f=${Installed-Size}", ident,
        ]).strip()
        return int(output) * 1024 if output.isdigit() else None
    if kind in {"DNF", "YUM", "Zypper", "RPM", "RPM-OSTree", "URPMI", "APT-RPM"}:
        records = rpm_inventory_by_name().get(package_base(ident), ())
        if ident != package_base(ident):
            architecture = ident.rsplit(".", 1)[-1]
            records = tuple(
                record for record in records
                if record.architecture == architecture
            )
        sizes = [
            record.size_bytes for record in records
            if record.size_bytes is not None
        ]
        if sizes:
            return sum(sizes)
        output = capture([
            "rpm", "-q", "--qf", "%{SIZE}\\n", "--", ident,
        ]).strip()
        fallback_sizes = [
            int(line) for line in output.splitlines()
            if line.strip().isdigit()
        ]
        return sum(fallback_sizes) if fallback_sizes else None
    if kind == "Pacman":
        record = pacman_inventory_by_name().get(ident)
        retained = parse_size(record.get("Installed Size", "")) if record else None
        if retained is not None:
            return retained
        output = capture(["pacman", "-Qi", ident])
        for line in output.splitlines():
            if line.casefold().startswith("installed size") and ":" in line:
                return parse_size(line.split(":", 1)[1])
        return None
    if kind == "APK":
        record = apk_inventory_by_name().get(ident)
        if record and record.size_bytes is not None:
            return record.size_bytes
        return parse_size(capture(["apk", "info", "--size", ident]))
    if kind == "OPKG":
        record = opkg_inventory_by_name().get(ident)
        return record.size_bytes if record else None
    if kind == "XBPS":
        output = capture([
            "xbps-query", "--property", "installed_size", ident,
        ]).strip()
        return int(output) if output.isdigit() else parse_size(output)
    if kind == "Portage":
        record = portage_inventory_by_name().get(ident)
        return record.size_bytes if record else None
    if kind == "Slackware":
        record = slackware_inventory_by_name().get(ident)
        return record.size_bytes if record else None
    if kind == "Snap":
        total = 0
        found = False
        try:
            images = list(Path("/var/lib/snapd/snaps").glob(f"{ident}_*.snap"))
        except OSError:
            images = []
        for image in images:
            size = file_disk_size(image)
            if size is not None:
                total += size
                found = True
        return total if found else None
    if kind in {"AppImage", "Gear Lever", "Standalone"} and path_text:
        return file_disk_size(Path(path_text))
    if kind == "NPM":
        root = npm_global_root()
        return path_disk_size(str(Path(root) / ident)) if root else None
    if kind == "Pipx":
        candidates = (
            Path.home() / ".local/share/pipx/venvs" / ident,
            Path("/opt/pipx/venvs") / ident,
        )
        for candidate in candidates:
            if candidate.exists():
                return path_disk_size(str(candidate))
        return None
    if kind == "Homebrew":
        prefix = capture(["brew", "--prefix", ident]).strip()
        return path_disk_size(prefix) if prefix else None
    return None


def add_installed_sizes(matches: list[Match]) -> list[Match]:
    def add_size(item: Match) -> Match:
        if item.size_bytes is not None:
            return item
        return replace(
            item,
            size_bytes=package_installed_size(
                item.kind, item.ident, item.scope,
                str(item.path or item.provides or ""),
                item.installation,
            ),
        )

    if len(matches) < 2:
        return [add_size(item) for item in matches]
    with ThreadPoolExecutor(max_workers=min(4, len(matches))) as executor:
        return list(executor.map(add_size, matches))


def configure_output() -> None:
    """Never crash merely because a terminal uses an ASCII-only locale."""
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure:
            try:
                reconfigure(errors="replace")
            except (LookupError, OSError):
                pass


def path_is_within(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def safe_standalone_location(path: Path) -> bool:
    """Allow direct deletion only in user/admin application locations."""
    absolute = path.absolute()
    if path_is_within(absolute, Path.home()):
        return True
    return any(
        path_is_within(absolute, root)
        for root in (Path("/usr/local"), Path("/opt"))
    )


def is_appimage_file(path: Path) -> bool:
    """Recognize type 1/2 AppImages even when their filename has no extension."""
    try:
        with path.open("rb") as stream:
            header = stream.read(11)
    except OSError:
        return False
    return (
        len(header) >= 11
        and header[:4] == b"\x7fELF"
        and header[8:10] == b"AI"
        and header[10] in {1, 2}
    )


def relevant(query: str, *values: str) -> bool:
    needle = norm(query)
    if not needle:
        return False
    normalized = [norm(value) for value in values]
    if len(needle) < 3:
        return any(
            needle == value or needle == norm(raw.rsplit(".", 1)[-1])
            for raw, value in zip(values, normalized)
        )
    return any(needle in value for value in normalized)


def run_command(
        command: list[str], timeout: int = 20,
        combine_output: bool = False,
) -> CommandResult:
    """Run a read-only command without discarding how it failed."""
    started = time.monotonic()
    try:
        env = os.environ.copy()
        env["LC_ALL"] = "C"
        result = subprocess.run(
            command, text=True, encoding="utf-8", errors="replace",
            stdout=subprocess.PIPE,
            stderr=(subprocess.STDOUT if combine_output else subprocess.PIPE),
            timeout=timeout, check=False, env=env,
        )
        command_result = CommandResult(
            tuple(command),
            CommandStatus.OK if result.returncode == 0 else CommandStatus.NONZERO,
            result.returncode,
            result.stdout or "",
            "" if combine_output else (result.stderr or ""),
            time.monotonic() - started,
        )
        if os.environ.get("UNINSTALL_DEBUG"):
            record_diagnostic(
                f"{command[0]}: {command_result.status.value}, "
                f"{command_result.duration * 1000:.0f} ms"
            )
        return command_result
    except subprocess.TimeoutExpired as error:
        stdout = error.stdout or ""
        stderr = error.stderr or ""
        if isinstance(stdout, bytes):
            stdout = stdout.decode("utf-8", errors="replace")
        if isinstance(stderr, bytes):
            stderr = stderr.decode("utf-8", errors="replace")
        record_diagnostic(f"{command[0]} timed out after {timeout} seconds")
        return CommandResult(
            tuple(command), CommandStatus.TIMEOUT, 124,
            stdout, stderr, time.monotonic() - started,
        )
    except OSError as error:
        record_diagnostic(f"{command[0]} could not be started: {error}")
        return CommandResult(
            tuple(command), CommandStatus.MISSING, 127, "", str(error),
            time.monotonic() - started,
        )


def capture(command: list[str]) -> str:
    result = run_command(command)
    return result.stdout if result.ok else ""


def capture_any(command: list[str], timeout: int = 60) -> tuple[int, str]:
    result = run_command(command, timeout=timeout, combine_output=True)
    return result.returncode, result.stdout


def find_executable(query: str) -> str | None:
    """Resolve a command, tolerating case mistakes when unambiguous."""
    executable = shutil.which(query)
    if executable or not query or Path(query).name != query:
        return executable
    if query == query.casefold():
        return None
    for raw_directory in os.environ.get("PATH", "").split(os.pathsep):
        directory = Path(raw_directory or ".")
        try:
            candidates = [
                entry.path for entry in os.scandir(directory)
                if entry.name.casefold() == query.casefold()
                and entry.is_file(follow_symlinks=True)
                and os.access(entry.path, os.X_OK)
            ]
        except OSError:
            continue
        if len(candidates) == 1:
            return candidates[0]
        if len(candidates) > 1:
            return None
    return None


def desktop_search_paths() -> list[Path]:
    data_home = xdg_dir(
        "XDG_DATA_HOME", Path.home() / ".local/share")
    raw_dirs = os.environ.get(
        "XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    roots = [data_home]
    roots.extend(
        Path(value) for value in raw_dirs.split(os.pathsep)
        if value and Path(value).is_absolute()
    )
    return list(dict.fromkeys(root / "applications" for root in roots))


@lru_cache(maxsize=1)
def desktop_inventory() -> tuple[DesktopRecord, ...]:
    records: list[DesktopRecord] = []
    seen: set[str] = set()
    for directory in desktop_search_paths():
        try:
            entries = sorted(directory.glob("*.desktop"))
        except OSError:
            continue
        for path in entries:
            if path.name in seen:
                continue
            try:
                if path.stat().st_size > 2 * 1024 * 1024:
                    continue
                lines = path.read_text(
                    encoding="utf-8", errors="replace").splitlines()
            except OSError:
                continue
            fields: dict[str, str] = {}
            localized_names: list[str] = []
            in_entry = False
            for line in lines:
                if line.startswith("["):
                    in_entry = line.strip() == "[Desktop Entry]"
                    continue
                if not in_entry or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key.startswith("Name["):
                    localized_names.append(value)
                elif key in {"Name", "GenericName", "Comment", "Exec", "Type", "NoDisplay", "Hidden"}:
                    fields.setdefault(key, value)
            if fields.get("Type", "Application") != "Application" \
                    or fields.get("Hidden", "false").casefold() == "true":
                continue
            try:
                argv = shlex.split(fields.get("Exec", ""))
            except ValueError:
                argv = []
            executable = ""
            for token in argv:
                if token == "env" or "=" in token and not token.startswith("/"):
                    continue
                if token.startswith("%"):
                    continue
                executable = token
                break
            name = fields.get("Name") or (
                localized_names[0] if localized_names else path.stem)
            records.append(DesktopRecord(
                path.name, name, fields.get("GenericName", ""),
                fields.get("Comment", ""), executable, path,
            ))
            seen.add(path.name)
    return tuple(records)


def detect_desktop_apps(query: str) -> list[Match]:
    matches: list[Match] = []
    for record in desktop_inventory():
        if not relevant(
                query, record.desktop_id, record.name,
                record.generic_name, record.comment,
                Path(record.executable).name):
            continue
        argv = []
        try:
            argv = shlex.split(next(
                line.split("=", 1)[1]
                for line in record.path.read_text(
                    encoding="utf-8", errors="replace").splitlines()
                if line.startswith("Exec=")
            ))
        except (OSError, StopIteration, ValueError):
            pass
        if argv and Path(argv[0]).name == "flatpak" and "run" in argv:
            identifiers = [
                value for value in argv[argv.index("run") + 1:]
                if not value.startswith(("-", "%"))
            ]
            if identifiers:
                for item in detect_flatpak(identifiers[-1]):
                    if item.ident == identifiers[-1]:
                        matches.append(replace(
                            item, name=record.name,
                            evidence=f"desktop entry {record.desktop_id}"))
                continue
        launcher = Path(argv[0]).name if argv else ""
        if launcher in {"distrobox-enter", "distrobox"}:
            container = ""
            for option in ("-n", "--name"):
                if option in argv and argv.index(option) + 1 < len(argv):
                    container = argv[argv.index(option) + 1]
                    break
            command = argv[argv.index("--") + 1] if "--" in argv \
                and argv.index("--") + 1 < len(argv) else record.name
            matches.append(Match(
                "Container Export", f"{container}:{command}", record.name,
                "", "user", origin=f"Distrobox container {container or 'unknown'}",
                evidence=f"desktop entry {record.desktop_id}",
            ))
            continue
        if launcher == "toolbox" and "run" in argv:
            container = ""
            for option in ("--container", "-c"):
                if option in argv and argv.index(option) + 1 < len(argv):
                    container = argv[argv.index(option) + 1]
                    break
            matches.append(Match(
                "Container Export", f"{container}:{record.name}", record.name,
                "", "user", origin=f"Toolbox container {container or 'default'}",
                evidence=f"desktop entry {record.desktop_id}",
            ))
            continue
        executable_path = Path(record.executable).expanduser()
        if executable_path.is_absolute() and is_appimage_file(executable_path) \
                and safe_standalone_location(executable_path):
            matches.append(Match(
                "AppImage", str(executable_path), record.name, "",
                "user" if path_is_within(executable_path, Path.home()) else "system",
                executable_path, evidence=f"desktop entry {record.desktop_id}",
            ))
            continue
        executable = Path(record.executable).name
        if not executable:
            continue
        owners = detect_executable_owner(executable)
        for owner in owners:
            matches.append(replace(
                owner, name=record.name,
                evidence=f"desktop entry {record.desktop_id}"))
    return matches


@lru_cache(maxsize=1)
def appstream_inventory() -> tuple[AppStreamRecord, ...]:
    roots = (
        Path("/usr/share/metainfo"), Path("/usr/share/appdata"),
        Path("/usr/share/app-info/xmls"),
        Path.home() / ".local/share/metainfo",
    )
    paths: list[Path] = []
    for root in roots:
        try:
            paths.extend(root.glob("*.xml"))
            paths.extend(root.glob("*.xml.gz"))
        except OSError:
            continue
    records: list[AppStreamRecord] = []
    seen: set[tuple[str, str]] = set()
    for path in paths[:4096]:
        try:
            if path.suffix == ".gz":
                with gzip.open(path, "rt", encoding="utf-8",
                               errors="replace") as stream:
                    text = stream.read(32 * 1024 * 1024)
            else:
                if path.stat().st_size > 32 * 1024 * 1024:
                    continue
                text = path.read_text(encoding="utf-8", errors="replace")
            root = ET.fromstring(text)
        except (OSError, ET.ParseError):
            continue
        components = [
            element for element in root.iter()
            if element.tag.rsplit("}", 1)[-1] == "component"
        ]
        for component in components:
            def child_text(name: str, current=component) -> str:
                child = next((
                    value for value in current
                    if value.tag.rsplit("}", 1)[-1] == name
                    and value.text
                ), None)
                return child.text.strip() if child is not None and child.text else ""
            component_id = child_text("id")
            package = child_text("pkgname")
            name = child_text("name")
            summary = child_text("summary")
            binaries = tuple(
                value.text.strip() for value in component.iter()
                if value.tag.rsplit("}", 1)[-1] == "binary" and value.text
            )
            key = (component_id, package)
            if key in seen or not (component_id or package or binaries):
                continue
            seen.add(key)
            records.append(AppStreamRecord(
                component_id, name or component_id, summary, package, binaries,
            ))
    return tuple(records)


def detect_appstream(query: str) -> list[Match]:
    found: list[Match] = []
    native_detectors = {
        detect_dpkg, detect_rpm, detect_pacman, detect_apk, detect_opkg,
        detect_xbps, detect_portage, detect_slackware, detect_eopkg,
        detect_swupd,
    }
    active_native = [
        detector for detector in active_detectors()
        if detector in native_detectors
    ]
    for record in appstream_inventory():
        if not relevant(
                query, record.component_id, record.name, record.summary,
                record.package, *record.binaries):
            continue
        owners: list[Match] = []
        if record.package:
            for detector in active_native:
                owners.extend(safe_detect(detector, record.package))
        if not owners:
            for binary in record.binaries:
                owners.extend(detect_executable_owner(Path(binary).name))
                if owners:
                    break
        for owner in owners:
            if record.package and package_base(owner.ident) != package_base(record.package):
                continue
            found.append(replace(
                owner, name=record.name,
                evidence=f"AppStream component {record.component_id}"))
    return found


@lru_cache(maxsize=1)
def os_release() -> dict[str, str]:
    values: dict[str, str] = {}
    for candidate in (Path("/etc/os-release"), Path("/usr/lib/os-release")):
        try:
            lines = candidate.read_text(
                encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        for line in lines:
            key, separator, raw = line.partition("=")
            if separator and re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
                try:
                    parsed = shlex.split(raw, posix=True)
                except ValueError:
                    parsed = []
                values[key] = parsed[0] if parsed else raw.strip("'\"")
        if values:
            break
    return values


def distro_ids() -> set[str]:
    release = os_release()
    return {
        value.casefold()
        for value in (release.get("ID", "") + " "
                      + release.get("ID_LIKE", "")).split()
        if value
    }


def dnf_binary() -> str:
    for candidate in ("dnf5", "dnf", "microdnf"):
        if shutil.which(candidate):
            return candidate
    return ""


def rpm_manager() -> str:
    if (Path("/run/ostree-booted").exists()
            and shutil.which("rpm-ostree")):
        return "RPM-OSTree"
    identities = distro_ids()
    if identities.intersection({"opensuse", "opensuse-leap", "opensuse-tumbleweed", "sles", "suse"}) \
            and shutil.which("zypper"):
        return "Zypper"
    if identities.intersection({
            "fedora", "rhel", "centos", "rocky", "almalinux",
            "ol", "amzn", "openmandriva",
    }) and dnf_binary():
        return "DNF"
    if "mageia" in identities and shutil.which("urpme"):
        return "URPMI"
    if identities.intersection({"altlinux", "pclinuxos"}) \
            and shutil.which("apt-get"):
        return "APT-RPM"
    if identities.intersection({"rhel", "centos"}) and shutil.which("yum"):
        return "YUM"
    if identities.intersection({
            "fedora", "rhel", "centos", "rocky", "almalinux", "ol",
            "amzn", "mageia", "openmandriva", "altlinux", "pclinuxos",
    }) and shutil.which("rpm"):
        return "RPM"
    available = [
        kind for kind, command in (
            ("DNF", dnf_binary()), ("YUM", shutil.which("yum")),
            ("Zypper", shutil.which("zypper")),
            ("URPMI", shutil.which("urpme")),
        ) if command
    ]
    if len(available) == 1:
        return available[0]
    if shutil.which("zypper") and identities.intersection({"suse", "opensuse"}):
        return "Zypper"
    if dnf_binary():
        return "DNF"
    if shutil.which("yum"):
        return "YUM"
    if shutil.which("zypper"):
        return "Zypper"
    return "RPM" if shutil.which("rpm") else ""


@lru_cache(maxsize=1)
def transactional_zypper_system() -> bool:
    """Identify read-only SUSE variants that must modify a new snapshot."""
    if not shutil.which("transactional-update"):
        return False
    try:
        mounts = Path("/proc/self/mounts").read_text(
            encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return False
    for line in mounts:
        fields = line.split()
        if len(fields) >= 4 and fields[1] == "/":
            return "ro" in fields[3].split(",")
    return False


@lru_cache(maxsize=1)
def immutable_host() -> tuple[str, str]:
    """Return the host image model and a concise persistence warning."""
    identities = distro_ids()
    if Path("/etc/steamos-release").exists() or "steamos" in identities:
        return (
            "SteamOS",
            ("SteamOS manages the host as an update image; direct Pacman "
            "changes can be lost or conflict with a future update."),
        )
    if Path("/run/ostree-booted").exists():
        model = "bootc" if shutil.which("bootc") else "rpm-ostree"
        return (
            model,
            (f"{model} applies host package changes through a deployment; "
            "a reboot can be required."),
        )
    if transactional_zypper_system():
        return (
            "transactional-update",
            "The change is written to a new snapshot and requires a reboot.",
        )
    return "", ""


@synchronized_lru_cache(maxsize=1)
def rpm_inventory() -> tuple[RpmPackageRecord, ...]:
    """Load RPM discovery, size, metadata, and dependency data once."""
    if not shutil.which("rpm"):
        return ()
    text = capture([
        "rpm", "-qa", "--qf",
        ("P\\t%{NAME}\\t%{VERSION}-%{RELEASE}\\t%{SUMMARY}\\t%{SIZE}\\t"
        "%{INSTALLTIME:date}\\t%{VENDOR}\\t%{ARCH}\\n"),
    ])
    records: list[RpmPackageRecord] = []
    current: dict[str, object] | None = None

    def finish() -> None:
        nonlocal current
        if not current:
            return
        records.append(RpmPackageRecord(
            name=str(current["name"]),
            version=str(current["version"]),
            summary=str(current["summary"]),
            size_bytes=current["size"] if isinstance(
                current["size"], int) else None,
            install_time=str(current["install_time"]),
            vendor=str(current["vendor"]),
            requires=tuple(current["requires"]),
            recommends=tuple(current["recommends"]),
            suggests=tuple(current["suggests"]),
            supplements=tuple(current["supplements"]),
            enhances=tuple(current["enhances"]),
            provides=tuple(current["provides"]),
            architecture=str(current["architecture"]),
        ))
        current = None

    relation_keys = {
        "R": "requires", "W": "recommends", "G": "suggests",
        "U": "supplements", "E": "enhances", "S": "provides",
    }
    for line in text.splitlines():
        if line.startswith("P\t"):
            finish()
            fields = line.split("\t", 7)
            if len(fields) < 2 or not fields[1]:
                continue
            current = {
                "name": fields[1],
                "version": fields[2] if len(fields) > 2 else "",
                "summary": fields[3] if len(fields) > 3 else "",
                "size": (int(fields[4])
                         if len(fields) > 4 and fields[4].isdigit() else None),
                "install_time": fields[5] if len(fields) > 5 else "",
                "vendor": fields[6] if len(fields) > 6 else "",
                "architecture": fields[7] if len(fields) > 7 else "",
                "requires": [], "recommends": [], "suggests": [],
                "supplements": [], "enhances": [], "provides": [],
            }
        elif current and len(line) > 2 and line[1] == "\t":
            key = relation_keys.get(line[0])
            value = line[2:].strip()
            if key and value:
                values = current[key]
                if isinstance(values, list):
                    values.append(value)
    finish()
    return tuple(records)


@synchronized_lru_cache(maxsize=1)
def rpm_dependency_inventory() -> tuple[RpmPackageRecord, ...]:
    """Load the large RPM relationship dataset only after selection."""
    if not shutil.which("rpm"):
        return ()
    text = capture([
        "rpm", "-qa", "--qf",
        ("P\\t%{NAME}\\n"
        "[R\\t%{REQUIRENAME}\\n]"
        "[W\\t%{RECOMMENDNAME}\\n]"
        "[G\\t%{SUGGESTNAME}\\n]"
        "[U\\t%{SUPPLEMENTNAME}\\n]"
        "[E\\t%{ENHANCENAME}\\n]"
        "[S\\t%{PROVIDENAME}\\n]"),
    ])
    records: list[RpmPackageRecord] = []
    current_name = ""
    relationships: dict[str, list[str]] = {}

    def finish() -> None:
        nonlocal current_name, relationships
        if current_name:
            records.append(RpmPackageRecord(
                current_name, "", "", None, "", "",
                requires=tuple(relationships.get("R", [])),
                recommends=tuple(relationships.get("W", [])),
                suggests=tuple(relationships.get("G", [])),
                supplements=tuple(relationships.get("U", [])),
                enhances=tuple(relationships.get("E", [])),
                provides=tuple(relationships.get("S", [])),
            ))
        current_name = ""
        relationships = {key: [] for key in "RWGUES"}

    finish()
    for line in text.splitlines():
        if line.startswith("P\t"):
            finish()
            current_name = line[2:].strip()
        elif current_name and len(line) > 2 and line[1] == "\t" \
                and line[0] in relationships:
            value = line[2:].strip()
            if value:
                relationships[line[0]].append(value)
    finish()
    return tuple(records)


@synchronized_lru_cache(maxsize=1)
def rpm_inventory_by_name() -> dict[str, tuple[RpmPackageRecord, ...]]:
    grouped: dict[str, list[RpmPackageRecord]] = defaultdict(list)
    for record in rpm_inventory():
        grouped[record.name].append(record)
    return {name: tuple(records) for name, records in grouped.items()}


@lru_cache(maxsize=1)
def rpm_ostree_layered_packages() -> tuple[bool, set[str]]:
    if not shutil.which("rpm-ostree"):
        return False, set()
    try:
        payload = json.loads(capture(["rpm-ostree", "status", "--json"]))
    except (json.JSONDecodeError, TypeError):
        return False, set()
    deployments = payload.get("deployments", []) if isinstance(payload, dict) else []
    if not isinstance(deployments, list) or not deployments:
        return False, set()
    deployment = next(
        (
            item for item in deployments
            if isinstance(item, dict) and item.get("booted") is True
        ),
        deployments[0],
    )
    if not isinstance(deployment, dict):
        return False, set()
    names: set[str] = set()
    for key in ("requested-packages", "packages"):
        values = deployment.get(key, [])
        if isinstance(values, list):
            names.update(value for value in values if isinstance(value, str))
    for key in (
            "requested-local-packages",
            "requested-local-fileoverride-packages"):
        values = deployment.get(key, [])
        if not isinstance(values, list):
            continue
        for value in values:
            if not isinstance(value, str):
                continue
            queried = capture([
                "rpm", "-q", "--qf", "%{NAME}\\n", "--", value,
            ]).strip()
            if queried:
                names.update(queried.splitlines())
    return True, names


def flatpak_system_installations() -> tuple[str, ...]:
    identifiers: list[str] = []
    directory = Path("/etc/flatpak/installations.d")
    try:
        configs = sorted(directory.glob("*.conf"))
    except OSError:
        configs = []
    for config in configs:
        try:
            text = config.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        in_installation = False
        for line in text.splitlines():
            if line.startswith("["):
                section = re.fullmatch(
                    r'\[Installation\s+"([A-Za-z0-9_.-]+)"\]',
                    line.strip(), flags=re.IGNORECASE)
                if section:
                    identifiers.append(section.group(1))
                    in_installation = True
                else:
                    in_installation = line.strip().casefold() == "[installation]"
                continue
            key, separator, value = line.partition("=")
            if in_installation and separator and key.strip().casefold() == "id":
                ident = value.strip()
                if re.fullmatch(r"[A-Za-z0-9_.-]+", ident):
                    identifiers.append(ident)
    return tuple(dict.fromkeys(identifiers))


def flatpak_locations() -> list[tuple[str, str]]:
    return [
        ("user", ""), ("system", ""),
        *(("system", ident) for ident in flatpak_system_installations()),
    ]


@synchronized_lru_cache(maxsize=16)
def flatpak_inventory(
        scope: str, installation: str = "",
) -> tuple[Match, ...]:
    if not shutil.which("flatpak"):
        return ()
    scope_option = (
        f"--installation={installation}" if installation else f"--{scope}")
    text = capture([
        "flatpak", "list", "--app", scope_option,
        "--columns=application,name,version,origin",
    ])
    found: list[Match] = []
    for line in text.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2:
            found.append(Match(
                "Flatpak", fields[0], fields[1],
                fields[2] if len(fields) > 2 else "", scope,
                origin=fields[3] if len(fields) > 3 else "",
                installation=installation,
            ))
    return tuple(found)


def detect_flatpak(query: str) -> list[Match]:
    found: list[Match] = []
    for scope, installation in flatpak_locations():
        found.extend(
            item for item in flatpak_inventory(scope, installation)
            if relevant(query, item.ident, item.name)
        )
    return found


