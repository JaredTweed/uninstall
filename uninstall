def xbps_dependency_report(item: Match) -> DependencyReport:
    target = item.ident
    manual_ok, explicit = xbps_manual_packages()
    reverse: dict[str, set[str]] = {}
    queue = deque([target])
    queried: set[str] = set()
    complete = manual_ok
    while queue and len(queried) < 64:
        package = queue.popleft()
        if package in queried:
            continue
        queried.add(package)
        ok, dependents = xbps_reverse_dependencies(package)
        complete = complete and ok
        reverse[package] = dependents
        for dependent in dependents:
            if dependent not in explicit and dependent not in queried:
                queue.append(dependent)
    if queue:
        complete = False
    paths, paths_complete = root_paths(target, reverse, explicit)
    return DependencyReport(
        item, sorted(reverse.get(target, set())), paths,
        complete and paths_complete,
        "Paths use current XBPS reverse-dependency and manual-package metadata.",
    )


def eopkg_dependency_report(item: Match) -> DependencyReport:
    code, output = capture_any([
        "eopkg", "--no-color", "info", item.ident,
    ], timeout=30)
    direct: list[str] = []
    for line in output.splitlines():
        key, separator, value = line.partition(":")
        if separator and key.strip().casefold() == "reverse dependencies":
            direct.extend(re.findall(r"[A-Za-z0-9+_.-]+", value))
    return DependencyReport(
        item, sorted(set(direct)), [], False,
        ("Eopkg reports direct reverse dependencies but does not retain "
         "a reliable explicit-install root." if code == 0 else
         "Eopkg package information was unavailable."),
    )


