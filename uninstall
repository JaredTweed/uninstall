def safe_detect(
        detector: Callable[[str], list[Match]], query: str,
) -> list[Match]:
    try:
        return detector(query)
    # Optional manager clients and their parsers are deliberately isolated: one
    # malformed inventory must never prevent all other backends from appearing.
    except Exception as error:  # noqa: BLE001
        record_diagnostic(f"{detector.__name__} failed: {error}")
        return []


def active_detectors() -> tuple[Callable[[str], list[Match]], ...]:
    """Query one native system family plus portable/user-level managers."""
    identities = distro_ids()
    native_map: dict[Callable[[str], list[Match]], set[str]] = {
        detect_dpkg: {"debian", "ubuntu", "linuxmint", "pop"},
        detect_rpm: {
            "fedora", "rhel", "centos", "rocky", "almalinux", "ol",
            "amzn", "opensuse", "suse", "mageia", "openmandriva",
            "altlinux", "pclinuxos",
        },
        detect_pacman: {"arch", "manjaro", "endeavouros", "steamos"},
        detect_apk: {"alpine", "postmarketos", "openwrt"},
        detect_opkg: {"openwrt", "lede"},
        detect_xbps: {"void"},
        detect_portage: {"gentoo", "funtoo"},
        detect_slackware: {"slackware"},
        detect_eopkg: {"solus"},
        detect_swupd: {"clear-linux-os"},
    }
    known_native = any(
        identities.intersection(supported)
        for supported in native_map.values()
    )
    selected: list[Callable[[str], list[Match]]] = []
    for detector in DETECTORS:
        supported = native_map.get(detector)
        if supported is None or not known_native \
                or identities.intersection(supported):
            selected.append(detector)
    return tuple(selected)


def score(match: Match, query: str) -> tuple[int, str, str]:
    needle = norm(query)
    values = (norm(match.ident), norm(match.name))
    command_exact = bool(
        match.provides and needle == norm(Path(match.provides).name))
    desktop_exact = bool(
        match.evidence.startswith("desktop entry") and needle in values)
    tokens = {
        norm(token) for value in (match.ident, match.name)
        for token in re.split(r"[^\w]+", value) if token
    }
    rank = (
        -6 if match.archive else
        -5 if command_exact or match.kind == "Standalone" else
        -4 if desktop_exact else
        -3 if needle == values[0] else
        -2 if needle == values[1] else
        -1 if any(value.startswith(needle) for value in values) else
        0 if needle in tokens else 1
    )
    return rank, match.kind, match.name.casefold()


def exact_app_match(match: Match, query: str) -> bool:
    needle = norm(query)
    return needle in {
        norm(match.name),
        norm(match.ident),
        norm(match.ident.rsplit(".", 1)[-1]),
        norm(Path(match.ident).stem),
    }


def find_matches(query: str) -> list[Match]:
    archive_matches = detect_package_archive(query)
    if archive_matches:
        return sorted(archive_matches, key=lambda item: score(item, query))
    fast_matches = (
        detect_executable_owner(query)
        if (query and Path(query).name == query
            and detect_executable_owner in DETECTORS) else []
    )
    matches: list[Match] = list(fast_matches)
    detectors = active_detectors()
    if fast_matches:
        native_detectors = {
            detect_dpkg, detect_rpm, detect_pacman, detect_apk, detect_opkg,
            detect_xbps, detect_portage, detect_slackware, detect_eopkg,
            detect_swupd, detect_executable_owner, detect_desktop_apps,
            detect_appstream,
        }
        detectors = tuple(
            detector for detector in detectors
            if detector not in native_detectors
        )
    if detectors:
        with ThreadPoolExecutor(max_workers=min(4, len(detectors))) as executor:
            for detected in executor.map(
                    lambda detector: safe_detect(detector, query), detectors):
                matches.extend(detected)
    unique = {m.key: m for m in matches}
    results = list(unique.values())
    gearlever_paths = {
        str(item.path.resolve()) for item in results
        if item.kind == "Gear Lever" and item.path
    }
    if gearlever_paths:
        results = [
            item for item in results
            if not (
                item.kind == "AppImage" and item.path
                and str(item.path.resolve()) in gearlever_paths
            )
        ]
    command_candidates = [
        item for item in results
        if item.provides or item.kind == "Standalone"
    ]
    if command_candidates:
        managed_paths = {
            item.provides for item in command_candidates
            if item.kind != "Standalone" and item.provides
        }
        managed_resolved_paths: set[str] = set()
        for value in managed_paths:
            try:
                managed_resolved_paths.add(str(Path(value).resolve()))
            except OSError:
                continue
        commands = [
            item for item in command_candidates
            if item.kind != "Standalone" or str(item.path) not in managed_paths
        ]
        results = commands + [
            item for item in results
            if (item not in command_candidates
                and exact_app_match(item, query)
                and not (
                    item.kind == "AppImage" and item.path
                    and str(item.path.resolve()) in managed_resolved_paths
                ))
        ]
    return sorted(results, key=lambda item: score(item, query))


def package_base(name: str) -> str:
    base = name.split(":", 1)[0]
    rpm_architectures = {
        "aarch64", "alpha", "armv7hl", "armv7hnl", "i386", "i486",
        "i586", "i686", "ia64", "noarch", "ppc", "ppc64", "ppc64le",
        "riscv64", "s390", "s390x", "sparc", "src", "x86_64",
    }
    prefix, separator, suffix = base.rpartition(".")
    return prefix if separator and suffix in rpm_architectures else base


def command_lines(command: list[str]) -> tuple[bool, set[str]]:
    code, output = capture_any(command, timeout=30)
    return code == 0, {
        line.strip() for line in output.splitlines() if line.strip()
    }


@lru_cache(maxsize=1)
def zypper_userinstalled() -> tuple[bool, set[str]]:
    command = [
        "zypper", "--no-refresh", "--xmlout", "packages",
        "--installed-only", "--userinstalled",
    ]
    code, output = capture_any(command, timeout=30)
    if code != 0:
        return False, set()
    names: set[str] = set()
    try:
        root = ET.fromstring(output)
    except ET.ParseError:
        root = None
    if root is not None:
        for element in root.iter():
            name = element.attrib.get("name", "")
            kind = element.attrib.get("kind", "package")
            if name and kind in {"", "package"}:
                names.add(name)
    if not names:
        for line in output.splitlines():
            fields = [field.strip() for field in line.split("|")]
            if len(fields) >= 4 and fields[0].startswith("i"):
                names.add(fields[2])
    return True, names


@lru_cache(maxsize=1)
def dnf_install_reasons() -> tuple[bool, dict[str, str]]:
    manager = dnf_binary()
    if not manager or manager == "microdnf":
        return False, {}
    command = (
        [manager, "repoquery", "--installed",
         "--queryformat=%{name}|%{reason}\\n"]
        if manager == "dnf5" else
        [manager, "repoquery", "--installed",
         "--qf", "%{name}|%{reason}\\n"]
    )
    code, output = capture_any(command, timeout=30)
    if code != 0:
        return False, {}
    reasons: dict[str, str] = {}
    for line in output.splitlines():
        name, separator, reason = line.partition("|")
        if separator and name.strip() and reason.strip():
            reasons[name.strip()] = reason.strip()
    return True, reasons


def annotate_roles(matches: list[Match]) -> list[Match]:
    by_kind: dict[str, list[Match]] = defaultdict(list)
    for item in matches:
        by_kind[item.kind].append(item)
    roles: dict[tuple[str, str, str], str] = {}

    if by_kind.get("APT") and shutil.which("apt-mark"):
        ok, automatic = command_lines(["apt-mark", "showauto"])
        if ok:
            automatic_bases = {package_base(name) for name in automatic}
            for item in by_kind["APT"]:
                role = ("dependency" if package_base(item.ident) in automatic_bases
                        else "explicit")
                roles[(item.kind, item.ident, item.scope)] = role

    rpm_kinds = {"DNF"}
    present_rpm_kinds = rpm_kinds.intersection(by_kind)
    if present_rpm_kinds:
        ok, reasons = dnf_install_reasons()
        if ok:
            role_names = {
                "user": "explicit",
                "external user": "external",
                "external": "external",
                "group": "group",
                "dependency": "dependency",
                "weak dependency": "weak dependency",
            }
            for kind in present_rpm_kinds:
                for item in by_kind[kind]:
                    reason = reasons.get(package_base(item.ident))
                    if reason:
                        roles[(item.kind, item.ident, item.scope)] = (
                            role_names.get(reason.casefold(), reason.casefold()))
        else:
            manager = dnf_binary()
            if not manager or manager == "microdnf":
                manager = "dnf"
            command = (
                [manager, "repoquery", "--userinstalled",
                 "--queryformat=%{name}\\n"]
                if manager == "dnf5" else
                [manager, "repoquery", "--installed", "--userinstalled",
                 "--qf", "%{name}\\n"]
            )
            explicit_ok, explicit = command_lines(command)
            if explicit_ok:
                for kind in present_rpm_kinds:
                    for item in by_kind[kind]:
                        role = (
                            "explicit" if package_base(item.ident) in explicit else "dependency")
                        roles[(item.kind, item.ident, item.scope)] = role

    if by_kind.get("Zypper") and shutil.which("zypper"):
        ok, explicit = zypper_userinstalled()
        if ok:
            for item in by_kind["Zypper"]:
                roles[(item.kind, item.ident, item.scope)] = (
                    "explicit" if item.ident in explicit else "dependency")

    if by_kind.get("YUM") and shutil.which("yum"):
        ok, explicit = command_lines([
            "yum", "repoquery", "--installed", "--userinstalled",
            "--qf", "%{name}\\n",
        ])
        if ok:
            for item in by_kind["YUM"]:
                roles[(item.kind, item.ident, item.scope)] = (
                    "explicit" if item.ident in explicit else "dependency")

    if by_kind.get("Pacman") and shutil.which("pacman"):
        inventory = pacman_inventory_by_name()
        if inventory:
            for item in by_kind["Pacman"]:
                reason = inventory.get(item.ident, {}).get(
                    "Install Reason", "").casefold()
                if reason:
                    role = (
                        "dependency" if "dependency" in reason
                        else "explicit"
                    )
                    roles[(item.kind, item.ident, item.scope)] = role
        else:
            ok, explicit = command_lines(["pacman", "-Qqe"])
            if ok:
                for item in by_kind["Pacman"]:
                    role = (
                        "explicit" if item.ident in explicit else "dependency")
                    roles[(item.kind, item.ident, item.scope)] = role

    if by_kind.get("APK") and shutil.which("apk"):
        explicit = apk_explicit_causes()
        for item in by_kind["APK"]:
            roles[(item.kind, item.ident, item.scope)] = (
                "explicit" if item.ident in explicit else "dependency")

    if by_kind.get("OPKG") and shutil.which("opkg"):
        inventory = opkg_inventory_by_name()
        for item in by_kind["OPKG"]:
            retained = inventory.get(item.ident)
            if retained and retained.origin in {"explicit", "dependency"}:
                roles[(item.kind, item.ident, item.scope)] = retained.origin

    if by_kind.get("XBPS") and shutil.which("xbps-query"):
        ok, explicit = xbps_manual_packages()
        if ok:
            for item in by_kind["XBPS"]:
                roles[(item.kind, item.ident, item.scope)] = (
                    "explicit" if item.ident in explicit else "dependency")

    if by_kind.get("Portage") and shutil.which("emerge"):
        explicit = portage_world()
        for item in by_kind["Portage"]:
            roles[(item.kind, item.ident, item.scope)] = (
                "explicit" if item.ident in explicit else "dependency")

    if by_kind.get("Eopkg") and shutil.which("eopkg"):
        ok, automatic = eopkg_automatic_packages()
        if ok:
            for item in by_kind["Eopkg"]:
                roles[(item.kind, item.ident, item.scope)] = (
                    "dependency" if item.ident in automatic else "explicit")

    if by_kind.get("Swupd") and shutil.which("swupd"):
        retained = {record.ident: record.origin for record in swupd_inventory()}
        for item in by_kind["Swupd"]:
            role = retained.get(item.ident, "")
            if role in {"explicit", "dependency"}:
                roles[(item.kind, item.ident, item.scope)] = role

    if by_kind.get("Homebrew") and shutil.which("brew"):
        metadata = homebrew_installed_metadata()
        unresolved: list[Match] = []
        for item in by_kind["Homebrew"]:
            details = metadata.get((item.kind, item.ident))
            requested = details[2] if details else None
            if requested is None:
                unresolved.append(item)
            else:
                roles[(item.kind, item.ident, item.scope)] = (
                    "explicit" if requested else "dependency")
        if unresolved:
            ok, explicit = command_lines([
                "brew", "list", "--formula", "--installed-on-request",
            ])
        else:
            ok, explicit = True, set()
        if ok:
            for item in unresolved:
                role = "explicit" if item.ident in explicit else "dependency"
                roles[(item.kind, item.ident, item.scope)] = role

    inherently_explicit = {
        "Flatpak", "Snap", "Homebrew Cask", "Cargo", "Pipx", "UV Tool",
        "NPM", "Nix",
        "Nix Legacy", "Guix", "AppImage", "Gear Lever", "Standalone",
        "Container Export", "RPM-OSTree",
        "Swupd 3rd-party",
    }
    for item in matches:
        key = (item.kind, item.ident, item.scope)
        if key not in roles and item.kind in inherently_explicit:
            roles[key] = "explicit"
    return [
        replace(item, role=roles.get(
            (item.kind, item.ident, item.scope), "unknown"))
        for item in matches
    ]


def filter_dependency_matches(
        matches: list[Match], query: str, show_dependencies: bool,
) -> tuple[list[Match], int]:
    if show_dependencies:
        return matches, 0
    visible: list[Match] = []
    hidden = 0
    for item in matches:
        forced = bool(item.provides or item.archive) or exact_app_match(item, query)
        if item.role in {"dependency", "weak dependency"} and not forced:
            hidden += 1
        else:
            visible.append(item)
    if hidden and not visible:
        return matches, 0
    return visible, hidden


@lru_cache(maxsize=1)
def rpm_dependency_graph() -> tuple[
        dict[str, set[str]], dict[str, set[str]],
        dict[tuple[str, str], set[str]], bool,
]:
    inventory = rpm_dependency_inventory()
    if not inventory:
        return {}, {}, {}, False
    dependency_maps: dict[str, dict[str, set[str]]] = {
        relation: defaultdict(set)
        for relation in (
            "requires", "recommends", "suggests", "supplements", "enhances")
    }
    provide_map: dict[str, set[str]] = defaultdict(set)
    packages = {record.name for record in inventory}
    for record in inventory:
        for relation in dependency_maps:
            for capability in getattr(record, relation):
                if capability and not capability.startswith("rpmlib("):
                    dependency_maps[relation][record.name].add(capability)
        provide_map[record.name].update(record.provides)
    providers: dict[str, set[str]] = defaultdict(set)
    for package in packages:
        providers[package].add(package)
        for capability in provide_map.get(package, set()):
            providers[capability].add(package)
    hard_reverse: dict[str, set[str]] = defaultdict(set)
    all_reverse: dict[str, set[str]] = defaultdict(set)
    relations: dict[tuple[str, str], set[str]] = defaultdict(set)
    for relation, dependency_map in dependency_maps.items():
        for dependent, capabilities in dependency_map.items():
            for capability in capabilities:
                for provider in providers.get(capability, set()):
                    if provider == dependent:
                        continue
                    if relation == "supplements":
                        # "A Supplements: B" means B can cause A to be
                        # installed, the reverse direction of Recommends.
                        all_reverse[dependent].add(provider)
                        relations[(dependent, provider)].add(
                            "is supplemented by")
                    elif relation == "enhances":
                        # Enhances is the reverse-direction counterpart to
                        # Suggests.
                        all_reverse[dependent].add(provider)
                        relations[(dependent, provider)].add(
                            "is enhanced by")
                    else:
                        all_reverse[provider].add(dependent)
                        relations[(provider, dependent)].add(relation)
                    if relation == "requires":
                        hard_reverse[provider].add(dependent)
    return (
        dict(hard_reverse), dict(all_reverse), dict(relations), True,
    )


@lru_cache(maxsize=1)
def rpm_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    hard_reverse, _all_reverse, _relations, complete = rpm_dependency_graph()
    return hard_reverse, complete


def split_debian_relationships(value: str) -> list[list[str]]:
    groups: list[list[str]] = []
    for group in value.split(","):
        alternatives: list[str] = []
        for alternative in group.split("|"):
            name = re.sub(r"\s*\(.*?\)", "", alternative).strip()
            name = re.sub(r"\s*\[.*?\]", "", name).strip()
            if name:
                alternatives.append(name)
        if alternatives:
            groups.append(alternatives)
    return groups


@lru_cache(maxsize=1)
def apt_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    inventory = apt_inventory()
    if not inventory:
        return {}, False
    installed_names: set[str] = set()
    virtuals: dict[str, set[str]] = defaultdict(set)
    for record in inventory:
        package = record.ident
        installed_names.update({package, package_base(package)})
        for provided in record.provides.split(","):
            capability = re.sub(r"\s*\(.*?\)", "", provided).strip()
            if capability:
                virtuals[capability].add(package)
    reverse: dict[str, set[str]] = defaultdict(set)
    for record in inventory:
        dependent = record.ident
        for alternatives in split_debian_relationships(
                ",".join(value for value in (
                    record.depends, record.pre_depends) if value)):
            candidate_providers: set[str] = set()
            for alternative in alternatives:
                if alternative in installed_names:
                    candidate_providers.add(alternative)
                elif package_base(alternative) in installed_names:
                    candidate_providers.add(package_base(alternative))
                candidate_providers.update(virtuals.get(alternative, set()))
            for provider in candidate_providers:
                provider_base = package_base(provider)
                if provider_base != package_base(dependent):
                    reverse[provider_base].add(package_base(dependent))
    return dict(reverse), True


@lru_cache(maxsize=1)
def apk_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    inventory = apk_inventory()
    if not inventory:
        return {}, False
    providers = apk_provider_map()
    reverse: dict[str, set[str]] = defaultdict(set)
    for record in inventory:
        for raw_dependency in record.depends:
            if raw_dependency.startswith("!"):
                continue
            capability = dependency_name(raw_dependency)
            for provider in providers.get(capability, set()):
                if provider != record.ident:
                    reverse[provider].add(record.ident)
    return dict(reverse), True


def parse_pacman_info(text: str) -> list[dict[str, str]]:
    records: list[dict[str, str]] = []
    current: dict[str, str] = {}
    last_key = ""
    for line in text.splitlines():
        if not line.strip():
            if current:
                records.append(current)
                current = {}
                last_key = ""
            continue
        if ":" in line and not line[0].isspace():
            key, value = line.split(":", 1)
            last_key = key.strip()
            current[last_key] = value.strip()
        elif current and last_key:
            current[last_key] += " " + line.strip()
    if current:
        records.append(current)
    return records


