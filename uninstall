def detect_swupd_third_party(query: str) -> list[Match]:
    found: list[Match] = []
    if not shutil.which("swupd"):
        return found
    code, repositories = capture_any(["swupd", "3rd-party", "list"], timeout=30)
    if code != 0 or "3rd-party repositories" not in repositories.casefold():
        return found
    repo_names: list[str] = []
    for line in repositories.splitlines():
        match = re.match(r"\s*-?\s*([A-Za-z0-9_.-]+)\s*:", line)
        if match and match.group(1).casefold() not in {"http", "https", "total"}:
            repo_names.append(match.group(1))
    for repository in dict.fromkeys(repo_names):
        list_code, output = capture_any([
            "swupd", "3rd-party", "bundle-list", "--repo", repository,
        ], timeout=30)
        if list_code != 0:
            continue
        for line in output.splitlines():
            ident = line.strip().split()[0] if line.strip() else ""
            if re.fullmatch(r"[A-Za-z0-9+_.-]+", ident) \
                    and relevant(query, ident):
                found.append(Match(
                    "Swupd 3rd-party", ident, ident, scope="system",
                    origin=repository,
                ))
    return found


@synchronized_lru_cache(maxsize=1)
def homebrew_installed_metadata(
) -> dict[tuple[str, str], tuple[str, str, bool | None]]:
    if not shutil.which("brew"):
        return {}
    try:
        payload = json.loads(capture([
            "brew", "info", "--json=v2", "--installed",
        ]))
    except (json.JSONDecodeError, TypeError):
        return {}
    if not isinstance(payload, dict):
        return {}
    metadata: dict[tuple[str, str], tuple[str, str, bool | None]] = {}
    for kind, key in (("Homebrew", "formulae"),
                      ("Homebrew Cask", "casks")):
        entries = payload.get(key, [])
        if not isinstance(entries, list):
            continue
        for details in entries:
            if not isinstance(details, dict):
                continue
            ident = str(details.get("name") or details.get("token") or "")
            if not ident:
                continue
            installed = details.get("installed", [])
            latest = (
                installed[-1]
                if isinstance(installed, list) and installed else {}
            )
            if isinstance(latest, dict):
                version = str(latest.get("version") or "")
                raw_requested = latest.get("installed_on_request")
                requested = (
                    raw_requested if isinstance(raw_requested, bool) else None)
            else:
                version = str(latest) if latest else ""
                requested = None
            if not version:
                version = str(details.get("version") or "")
            metadata[(kind, ident)] = (
                version, str(details.get("tap") or ""), requested)
    return metadata


def detect_homebrew(query: str) -> list[Match]:
    if not shutil.which("brew"):
        return []
    metadata = homebrew_installed_metadata()
    if metadata:
        return [
            Match(kind, ident, ident, version, "user", origin=tap)
            for (kind, ident), (version, tap, _requested) in metadata.items()
            if relevant(query, ident)
        ]
    found: list[Match] = []
    for kind, option in (("Homebrew", "--formula"), ("Homebrew Cask", "--cask")):
        for line in capture(["brew", "list", option, "--versions"]).splitlines():
            fields = line.split()
            if fields and relevant(query, fields[0]):
                found.append(Match(kind, fields[0], fields[0],
                                   " ".join(fields[1:]), "user"))
    return found


def gearlever_command() -> list[str]:
    if shutil.which("gearlever"):
        return ["gearlever"]
    if shutil.which("flatpak"):
        app_id = "it.mijorus.gearlever"
        if any(
            item.ident == app_id
            for scope, installation in flatpak_locations()
            for item in flatpak_inventory(scope, installation)
        ):
            return ["flatpak", "run", app_id]
    return []


def parse_gearlever_list(text: str) -> list[dict[str, object]]:
    """Parse Gear Lever's versioned JSON, with its older table as a fallback."""
    for line in reversed(text.splitlines()):
        if not line.lstrip().startswith("{"):
            continue
        try:
            payload = json.loads(line)
        except (json.JSONDecodeError, TypeError):
            continue
        if not isinstance(payload, dict):
            continue
        installed = payload.get("installed")
        if isinstance(installed, list):
            return [item for item in installed if isinstance(item, dict)]

    installed: list[dict[str, object]] = []
    table_row = re.compile(
        r"^(.*?)\s{2,}\[([^\]]*)\]\s{2,}\[([^\]]*)\]\s{2,}(.+?)\s*$"
    )
    for line in text.splitlines():
        match = table_row.match(line)
        if not match:
            continue
        name, version, _manager, path = match.groups()
        installed.append({
            "name": name.strip(),
            "path": path.strip(),
            "current_version": "" if version == "Not specified" else version,
        })
    return installed


def detect_gearlever(query: str) -> list[Match]:
    command = gearlever_command()
    if not command:
        return []
    text = capture(command + ["--list-installed", "--json"])
    if not text:
        text = capture(command + ["--list-installed"])
    found: list[Match] = []
    for metadata in parse_gearlever_list(text):
        name = metadata.get("name")
        path_value = metadata.get("path")
        if not isinstance(name, str) or not isinstance(path_value, str):
            continue
        path = Path(path_value).expanduser()
        if (not path.is_absolute()
                or (not path.is_file() and not path.is_symlink())):
            continue
        if not relevant(query, name, path.name, path.stem, str(path)):
            continue
        visible = shutil.which(query) if Path(query).name == query else ""
        provides = ""
        if visible:
            try:
                if Path(visible).resolve() == path.resolve():
                    provides = str(Path(visible).absolute())
            except OSError:
                pass
        raw_version = metadata.get("current_version")
        version = raw_version if isinstance(raw_version, str) else ""
        origin = next((
            value for value in (
                metadata.get("update_url"),
                metadata.get("source_url"),
                metadata.get("url"),
            )
            if isinstance(value, str) and value
        ), "")
        found.append(Match(
            "Gear Lever", str(path), name, version, "user", path,
            provides=provides, origin=origin,
        ))
    return found


@synchronized_lru_cache(maxsize=2)
def pipx_inventory(scope: str) -> tuple[Match, ...]:
    if not shutil.which("pipx"):
        return ()
    extra = ["--global"] if scope == "system" else []
    found: list[Match] = []
    text = capture(["pipx", "list", "--json"] + extra)
    try:
        payload = json.loads(text)
    except (json.JSONDecodeError, TypeError):
        payload = {}
    venvs = payload.get("venvs", {}) if isinstance(payload, dict) else {}
    if isinstance(venvs, dict):
        for environment, metadata in venvs.items():
            if not isinstance(environment, str) or not isinstance(metadata, dict):
                continue
            details = metadata.get("metadata", metadata)
            main = (
                details.get("main_package", {})
                if isinstance(details, dict) else {}
            )
            package = (
                main.get("package", environment)
                if isinstance(main, dict) else environment
            )
            version = (
                main.get("package_version", "")
                if isinstance(main, dict) else ""
            )
            source = (
                main.get("package_or_url") or package
                if isinstance(main, dict) else package
            )
            if not isinstance(package, str):
                package = environment
            if not isinstance(version, str):
                version = ""
            found.append(Match(
                "Pipx", environment, package, version, scope,
                origin=source if isinstance(source, str) else "",
            ))
        if text:
            return tuple(found)
    for line in capture(["pipx", "list", "--short"] + extra).splitlines():
        fields = line.split()
        if fields:
            found.append(Match(
                "Pipx", fields[0], fields[0],
                fields[1] if len(fields) > 1 else "", scope))
    return tuple(found)


def detect_pipx(query: str) -> list[Match]:
    found: list[Match] = []
    for scope in ("user", "system"):
        found.extend(
            item for item in pipx_inventory(scope)
            if relevant(query, item.ident, item.name)
        )
    return found


@synchronized_lru_cache(maxsize=1)
def uv_tool_inventory() -> tuple[Match, ...]:
    if not shutil.which("uv"):
        return ()
    found: list[Match] = []
    current = ""
    version = ""
    binaries: list[str] = []

    def finish() -> None:
        if not current:
            return
        command_path = next((
            shutil.which(binary) or "" for binary in binaries
            if shutil.which(binary)
        ), "")
        found.append(Match(
            "UV Tool", current, current, version, "user",
            provides=command_path,
            origin="uv-managed isolated tool environment",
        ))

    for line in capture(["uv", "tool", "list"]).splitlines():
        if line and not line[0].isspace() and not line.startswith("-"):
            finish()
            fields = line.rstrip(":").split()
            current = fields[0] if fields else ""
            version = fields[1].lstrip("v") if len(fields) > 1 else ""
            binaries = []
        elif current and line.strip().startswith("-"):
            binary = line.strip()[1:].strip().split()[0]
            if binary:
                binaries.append(binary)
    finish()
    return tuple(found)


