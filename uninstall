@dataclass(frozen=True)
class Match:
    kind: str
    ident: str
    name: str
    version: str = ""
    scope: str = ""
    path: Path | None = None
    provides: str = ""
    role: str = "unknown"
    archive: Path | None = None
    archive_version: str = ""


@dataclass
class DependencyReport:
    target: Match
    direct_dependents: list[str]
    root_paths: list[list[str]]
    complete: bool = True
    note: str = ""


@dataclass
class RemovalPlan:
    selected: list[Match]
    reports: list[DependencyReport]
    planned_removals: list[str]
    additional_removals: list[str]
    orphan_removals: list[str]
    level: str
    preview_available: bool
    protected_items: list[str]
    notes: list[str]


def norm(value: str) -> str:
    decomposed = unicodedata.normalize("NFKD", value.casefold())
    return "".join(
        char for char in decomposed
        if char.isalnum() and not unicodedata.combining(char)
    )


def display(value: object) -> str:
    """Make untrusted package metadata safe to print to a terminal."""
    text = str(value)
    return "".join(
        char if char.isprintable() and char not in "\x1b\x7f" else "?"
        for char in text
    )


def path_is_within(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def relevant(query: str, *values: str) -> bool:
    needle = norm(query)
    if not needle:
        return False
    normalized = [norm(value) for value in values]
    if len(needle) < 3:
        return any(
            needle == value or needle == norm(raw.rsplit(".", 1)[-1])
            for raw, value in zip(values, normalized)
        )
    return any(needle in value for value in normalized)


def capture(command: list[str]) -> str:
    try:
        env = os.environ.copy()
        env["LC_ALL"] = "C"
        result = subprocess.run(
            command, text=True, encoding="utf-8", errors="replace",
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=20, check=False, env=env,
        )
        return result.stdout if result.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def capture_any(command: list[str], timeout: int = 60) -> tuple[int, str]:
    try:
        env = os.environ.copy()
        env["LC_ALL"] = "C"
        result = subprocess.run(
            command, text=True, encoding="utf-8", errors="replace",
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            timeout=timeout, check=False, env=env,
        )
        return result.returncode, result.stdout
    except subprocess.TimeoutExpired as error:
        output = error.stdout or ""
        if isinstance(output, bytes):
            output = output.decode("utf-8", errors="replace")
        return 124, output
    except OSError as error:
        return 127, str(error)


def rpm_manager() -> str:
    if (Path("/run/ostree-booted").exists()
            and shutil.which("rpm-ostree")):
        return "RPM-OSTree"
    if shutil.which("dnf5") or shutil.which("dnf"):
        return "DNF"
    if shutil.which("yum"):
        return "YUM"
    if shutil.which("zypper"):
        return "Zypper"
    return "RPM" if shutil.which("rpm") else ""


def detect_flatpak(query: str) -> list[Match]:
    if not shutil.which("flatpak"):
        return []
    found: list[Match] = []
    for scope in ("user", "system"):
        text = capture(["flatpak", "list", "--app", f"--{scope}",
                        "--columns=application,name,version"])
        for line in text.splitlines():
            fields = line.split("\t")
            if len(fields) >= 2 and relevant(query, fields[0], fields[1]):
                found.append(Match("Flatpak", fields[0], fields[1],
                                   fields[2] if len(fields) > 2 else "", scope))
    return found


def detect_snap(query: str) -> list[Match]:
    if not shutil.which("snap"):
        return []
    found: list[Match] = []
    for line in capture(["snap", "list"]).splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 2 and relevant(query, fields[0]):
            found.append(Match("Snap", fields[0], fields[0], fields[1], "system"))
    return found


def detect_dpkg(query: str) -> list[Match]:
    if not shutil.which("dpkg-query"):
        return []
    fmt = "${db:Status-Abbrev}\\t${binary:Package}\\t${Version}\\t${binary:Summary}\\n"
    found: list[Match] = []
    for line in capture(["dpkg-query", "-W", "-f=" + fmt]).splitlines():
        fields = line.split("\t", 3)
        installed = fields and len(fields[0]) > 1 and fields[0][1] == "i"
        if (installed and len(fields) >= 3
                and relevant(query, fields[1],
                             fields[3] if len(fields) > 3 else "")):
            found.append(Match("APT", fields[1], fields[1],
                               fields[2], "system"))
    return found


def detect_rpm(query: str) -> list[Match]:
    if not shutil.which("rpm"):
        return []
    kind = rpm_manager()
    if not kind:
        return []
    fmt = "%{NAME}\\t%{VERSION}-%{RELEASE}\\t%{SUMMARY}\\n"
    found: list[Match] = []
    for line in capture(["rpm", "-qa", "--qf", fmt]).splitlines():
        fields = line.split("\t", 2)
        if len(fields) >= 2 and relevant(query, fields[0], fields[2] if len(fields) > 2 else ""):
            found.append(Match(kind, fields[0], fields[0], fields[1], "system"))
    return found


def detect_pacman(query: str) -> list[Match]:
    if not shutil.which("pacman"):
        return []
    found: list[Match] = []
    for line in capture(["pacman", "-Q"]).splitlines():
        fields = line.rsplit(maxsplit=1)
        if fields and relevant(query, fields[0]):
            found.append(Match("Pacman", fields[0], fields[0],
                               fields[1] if len(fields) > 1 else "", "system"))
    return found


def detect_homebrew(query: str) -> list[Match]:
    if not shutil.which("brew"):
        return []
    found: list[Match] = []
    for kind, option in (("Homebrew", "--formula"), ("Homebrew Cask", "--cask")):
        for line in capture(["brew", "list", option, "--versions"]).splitlines():
            fields = line.split()
            if fields and relevant(query, fields[0]):
                found.append(Match(kind, fields[0], fields[0],
                                   " ".join(fields[1:]), "user"))
    return found


def gearlever_command() -> list[str]:
    if shutil.which("gearlever"):
        return ["gearlever"]
    if shutil.which("flatpak"):
        return ["flatpak", "run", "it.mijorus.gearlever"]
    return []


def parse_gearlever_list(text: str) -> list[dict[str, object]]:
    """Parse Gear Lever's versioned JSON, with its older table as a fallback."""
    for line in reversed(text.splitlines()):
        if not line.lstrip().startswith("{"):
            continue
        try:
            payload = json.loads(line)
        except (json.JSONDecodeError, TypeError):
            continue
        if not isinstance(payload, dict):
            continue
        installed = payload.get("installed")
        if isinstance(installed, list):
            return [item for item in installed if isinstance(item, dict)]

    installed: list[dict[str, object]] = []
    table_row = re.compile(
        r"^(.*?)\s{2,}\[([^\]]*)\]\s{2,}\[([^\]]*)\]\s{2,}(.+?)\s*$"
    )
    for line in text.splitlines():
        match = table_row.match(line)
        if not match:
            continue
        name, version, _manager, path = match.groups()
        installed.append({
            "name": name.strip(),
            "path": path.strip(),
            "current_version": "" if version == "Not specified" else version,
        })
    return installed


def detect_gearlever(query: str) -> list[Match]:
    command = gearlever_command()
    if not command:
        return []
    text = capture(command + ["--list-installed", "--json"])
    if not text:
        text = capture(command + ["--list-installed"])
    found: list[Match] = []
    for metadata in parse_gearlever_list(text):
        name = metadata.get("name")
        path_value = metadata.get("path")
        if not isinstance(name, str) or not isinstance(path_value, str):
            continue
        path = Path(path_value).expanduser()
        if (not path.is_absolute()
                or (not path.is_file() and not path.is_symlink())):
            continue
        if not relevant(query, name, path.name, path.stem, str(path)):
            continue
        visible = shutil.which(query) if Path(query).name == query else ""
        provides = ""
        if visible:
            try:
                if Path(visible).resolve() == path.resolve():
                    provides = str(Path(visible).absolute())
            except OSError:
                pass
        raw_version = metadata.get("current_version")
        version = raw_version if isinstance(raw_version, str) else ""
        found.append(Match(
            "Gear Lever", str(path), name, version, "user", path,
            provides=provides,
        ))
    return found


def detect_pipx(query: str) -> list[Match]:
    if not shutil.which("pipx"):
        return []
    found: list[Match] = []
    for scope, extra in (("user", []), ("system", ["--global"])):
        command = ["pipx", "list", "--short"] + extra
        for line in capture(command).splitlines():
            fields = line.split()
            if fields and relevant(query, fields[0]):
                found.append(Match("Pipx", fields[0], fields[0],
                                   fields[1] if len(fields) > 1 else "", scope))
    return found


def detect_npm(query: str) -> list[Match]:
    if not shutil.which("npm"):
        return []
    prefix = capture(["npm", "prefix", "--global"]).strip()
    try:
        payload = json.loads(capture(["npm", "list", "--global", "--depth=0", "--json"]))
    except (json.JSONDecodeError, TypeError):
        return []
    dependencies = payload.get("dependencies", {}) if isinstance(payload, dict) else {}
    scope = ("user" if prefix
             and path_is_within(Path(prefix).expanduser(), Path.home())
             else "system")
    found: list[Match] = []
    for name, metadata in dependencies.items():
        if relevant(query, name):
            version = metadata.get("version", "") if isinstance(metadata, dict) else ""
            found.append(Match("NPM", name, name, version, scope))
    return found


def detect_cargo(query: str) -> list[Match]:
    if not shutil.which("cargo"):
        return []
    found: list[Match] = []
    crate = ""
    version = ""
    binaries: list[str] = []

    def add_crate() -> None:
        if crate and (relevant(query, crate) or any(relevant(query, item) for item in binaries)):
            command_path = shutil.which(query) if query in binaries else ""
            cargo_root = Path(
                os.environ.get("CARGO_INSTALL_ROOT")
                or os.environ.get("CARGO_HOME")
                or Path.home() / ".cargo"
            ).expanduser()
            if (command_path and
                    Path(command_path).resolve().parent != (cargo_root / "bin").resolve()):
                command_path = ""
            found.append(Match("Cargo", crate, crate, version, "user",
                               provides=command_path or ""))

    for line in capture(["cargo", "install", "--list"]).splitlines():
        if line and not line[0].isspace() and line.endswith(":"):
            add_crate()
            header = line[:-1].rsplit(maxsplit=1)
            crate = header[0]
            version = header[1].lstrip("v") if len(header) > 1 else ""
            binaries = []
        elif crate and line.strip():
            binaries.append(line.strip())
    add_crate()
    return found


def parse_nix_profile(text: str) -> list[tuple[str, list[str]]]:
    entries: list[tuple[str, list[str]]] = []
    for block in text.split("\n\n"):
        fields: dict[str, str] = {}
        for line in block.splitlines():
            key, separator, value = line.partition(":")
            if separator:
                fields[key.strip()] = value.strip()
        ident = fields.get("Name") or fields.get("Index")
        stores = fields.get("Store paths", "").split()
        if ident and stores:
            entries.append((ident, stores))
    return entries


def detect_nix(query: str) -> list[Match]:
    if not shutil.which("nix"):
        return []
    executable = shutil.which(query) if Path(query).name == query else None
    resolved = str(Path(executable).resolve()) if executable else ""
    found: list[Match] = []
    for ident, stores in parse_nix_profile(capture(["nix", "profile", "list"])):
        owns_command = bool(resolved) and any(
            resolved == store or resolved.startswith(store.rstrip("/") + "/")
            for store in stores
        )
        if relevant(query, ident) or owns_command:
            found.append(Match("Nix", ident, ident, "", "user",
                               provides=str(Path(executable).absolute())
                               if owns_command and executable else ""))
    return found


def path_after(parts: tuple[str, ...], marker: str) -> list[str]:
    try:
        index = parts.index(marker)
    except ValueError:
        return []
    return list(parts[index + 1:])


def snap_command_owner(query: str, visible: Path) -> list[Match]:
    snap_roots = (Path("/snap/bin"), Path("/var/lib/snapd/snap/bin"))
    if not any(visible.parent == root for root in snap_roots) or not shutil.which("snap"):
        return []
    package = visible.name.split(".", 1)[0]
    for line in capture(["snap", "aliases"]).splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 2 and fields[1] == visible.name:
            package = fields[0].split(".", 1)[0]
            break
    for line in capture(["snap", "list", package]).splitlines()[1:]:
        fields = line.split()
        if len(fields) >= 2 and fields[0] == package:
            return [Match("Snap", package, package, fields[1], "system",
                          provides=str(visible))]
    return []


def flatpak_command_owner(visible: Path) -> list[Match]:
    path_text = str(visible)
    if "/flatpak/exports/bin/" not in path_text or not shutil.which("flatpak"):
        return []
    app_id = visible.name
    found: list[Match] = []
    for scope in ("user", "system"):
        text = capture(["flatpak", "list", "--app", f"--{scope}",
                        "--columns=application,name,version"])
        for line in text.splitlines():
            fields = line.split("\t")
            if fields and fields[0] == app_id:
                found.append(Match("Flatpak", app_id,
                                   fields[1] if len(fields) > 1 else app_id,
                                   fields[2] if len(fields) > 2 else "", scope,
                                   provides=str(visible)))
    return found


def detect_executable_owner(query: str) -> list[Match]:
    """Find the package owning a command, or identify a standalone command."""
    if not query or Path(query).name != query:
        return []
    executable = shutil.which(query)
    if not executable:
        return []
    visible = Path(executable).absolute()
    resolved = Path(executable).resolve()
    path = str(resolved)
    found: list[Match] = []

    managed = snap_command_owner(query, visible) or flatpak_command_owner(visible)
    if managed:
        return managed
    if (visible.parent in {Path("/snap/bin"), Path("/var/lib/snapd/snap/bin")}
            or "/flatpak/exports/bin/" in str(visible)):
        return []

    if visible.name.casefold().endswith(".appimage"):
        scope = "user" if path_is_within(visible, Path.home()) else "system"
        return [Match("AppImage", str(visible), visible.stem, "", scope, visible)]

    brew_parts = path_after(resolved.parts, "Cellar")
    brew_cellar = capture(["brew", "--cellar"]).strip() if shutil.which("brew") else ""
    in_brew_cellar = bool(
        brew_cellar and path_is_within(resolved, Path(brew_cellar).resolve())
    )
    if brew_parts and in_brew_cellar:
        formula = brew_parts[0]
        details = capture(["brew", "list", "--formula", "--versions", formula]).strip()
        if details:
            fields = details.split()
            return [Match("Homebrew", formula, formula, " ".join(fields[1:]),
                          "user", provides=str(visible))]

    pipx_parts = path_after(resolved.parts, "venvs")
    if pipx_parts and "/pipx/venvs/" in path and shutil.which("pipx"):
        scope = "user" if path_is_within(visible, Path.home()) else "system"
        return [Match("Pipx", pipx_parts[0], pipx_parts[0], "", scope,
                      provides=str(visible))]

    node_parts = path_after(resolved.parts, "node_modules")
    npm_prefix = capture(["npm", "prefix", "--global"]).strip() if shutil.which("npm") else ""
    npm_prefix_path = Path(npm_prefix).resolve() if npm_prefix else None
    npm_exposed = bool(
        npm_prefix_path and visible.parent.resolve() == npm_prefix_path / "bin"
    )
    if node_parts and npm_exposed:
        package = ("/".join(node_parts[:2]) if node_parts[0].startswith("@")
                   and len(node_parts) > 1 else node_parts[0])
        scope = "user" if path_is_within(visible, Path.home()) else "system"
        return [Match("NPM", package, package, "", scope,
                      provides=str(visible))]

    kind = rpm_manager()
    if kind and shutil.which("rpm"):
        fmt = "%{NAME}\\t%{VERSION}-%{RELEASE}\\n"
        for owner_path in dict.fromkeys((path, str(visible))):
            for line in capture(["rpm", "-qf", "--qf", fmt, owner_path]).splitlines():
                fields = line.split("\t", 1)
                if fields and fields[0]:
                    found.append(Match(kind, fields[0], fields[0],
                                       fields[1] if len(fields) > 1 else "",
                                       "system", provides=str(visible)))

    if shutil.which("dpkg-query"):
        fmt = "${db:Status-Abbrev}\\t${binary:Package}\\t${Version}\\n"
        for owner_path in dict.fromkeys((path, str(visible))):
            for owner_line in capture(["dpkg-query", "-S", owner_path]).splitlines():
                owner, separator, _owned_path = owner_line.rpartition(": ")
                if not separator or not owner:
                    continue
                details = capture(["dpkg-query", "-W", "-f=" + fmt, owner]).strip()
                fields = details.split("\t", 2)
                installed = fields and len(fields[0]) > 1 and fields[0][1] == "i"
                if installed and len(fields) >= 2:
                    found.append(Match("APT", fields[1], fields[1],
                                       fields[2] if len(fields) > 2 else "",
                                       "system", provides=str(visible)))

    if shutil.which("pacman"):
        for owner_path in dict.fromkeys((path, str(visible))):
            for owner in capture(["pacman", "-Qoq", owner_path]).splitlines():
                fields = capture(["pacman", "-Q", owner.strip()]).strip().rsplit(maxsplit=1)
                if fields:
                    found.append(Match("Pacman", fields[0], fields[0],
                                       fields[1] if len(fields) > 1 else "",
                                       "system", provides=str(visible)))
    if not found:
        protected_markers = (
            "/nix/store/", "/node_modules/", "/pipx/venvs/",
            "/flatpak/", "/snap/", "/Cellar/",
        )
        if any(marker in path for marker in protected_markers):
            return []
        scope = "user" if path_is_within(visible, Path.home()) else "system"
        found.append(Match("Standalone", str(visible), query, "",
                           scope, path=visible))
    return found


def detect_appimages(query: str) -> list[Match]:
    explicit = Path(query).expanduser()
    if ("/" in query and explicit.is_file()
            and explicit.name.casefold().endswith(".appimage")):
        path = explicit.absolute()
        scope = "user" if path_is_within(path, Path.home()) else "system"
        return [Match("AppImage", str(path), path.stem, "", scope, path)]
    roots = [
        Path.home() / "Applications", Path.home() / ".local/bin",
        Path.home() / "Downloads", Path.home() / "Desktop",
        Path("/opt"), Path("/usr/local/bin"),
    ]
    found: list[Match] = []
    seen: set[Path] = set()
    for root in roots:
        if not root.is_dir():
            continue
        try:
            for current, dirs, files in os.walk(root):
                relative_depth = len(Path(current).relative_to(root).parts)
                if relative_depth >= 2:
                    dirs[:] = []
                for filename in files:
                    path = Path(current) / filename
                    if (filename.casefold().endswith(".appimage")
                            and relevant(query, filename)
                            and path not in seen):
                        seen.add(path)
                        found.append(Match("AppImage", str(path), path.stem, "",
                                           "user" if path_is_within(path, Path.home()) else "system", path))
        except OSError:
            continue
    return found


def detect_package_archive(query: str) -> list[Match]:
    """Resolve a local package archive to the corresponding installed package."""
    candidate = Path(query).expanduser()
    if not candidate.is_file():
        return []
    archive = candidate.absolute()
    lowered = archive.name.casefold()

    if lowered.endswith(".rpm") and shutil.which("rpm"):
        archive_format = "%{NAME}\\t%{VERSION}-%{RELEASE}\\t%{ARCH}\\n"
        fields = capture([
            "rpm", "-qp", "--qf", archive_format, "--", str(archive),
        ]).strip().split("\t")
        if len(fields) != 3:
            return []
        name, archive_version, architecture = fields
        installed_format = "%{NAME}\\t%{VERSION}-%{RELEASE}\\t%{ARCH}\\n"
        installed = capture([
            "rpm", "-q", "--qf", installed_format,
            "--", f"{name}.{architecture}",
        ]).splitlines()
        for line in installed:
            installed_fields = line.split("\t")
            if len(installed_fields) == 3 and installed_fields[0] == name:
                return [Match(
                    rpm_manager(), name, name, installed_fields[1], "system",
                    archive=archive, archive_version=archive_version,
                )]
        return []

    if lowered.endswith(".deb") and shutil.which("dpkg-deb"):
        archive_format = (
            "${Package}\\t${Version}\\t${Architecture}\\n"
        )
        fields = capture([
            "dpkg-deb", "--show", "--showformat=" + archive_format,
            str(archive),
        ]).strip().split("\t")
        if len(fields) != 3:
            return []
        name, archive_version, architecture = fields
        installed_format = (
            "${db:Status-Abbrev}\\t${binary:Package}\\t${Version}\\n"
        )
        identifiers = (
            [f"{name}:{architecture}"]
            if architecture not in {"", "all"} else [name]
        )
        for identifier in identifiers:
            installed = capture([
                "dpkg-query", "-W", "-f=" + installed_format, identifier,
            ]).strip().split("\t")
            is_installed = (
                len(installed) == 3 and len(installed[0]) > 1
                and installed[0][1] == "i"
            )
            if is_installed:
                return [Match(
                    "APT", installed[1], installed[1], installed[2], "system",
                    archive=archive, archive_version=archive_version,
                )]
        return []

    if (".pkg.tar." in lowered and shutil.which("pacman")):
        archive_fields = capture(
            ["pacman", "-Qp", str(archive)]).strip().rsplit(maxsplit=1)
        if len(archive_fields) != 2:
            return []
        name, archive_version = archive_fields
        installed_fields = capture(
            ["pacman", "-Q", name]).strip().rsplit(maxsplit=1)
        if len(installed_fields) == 2 and installed_fields[0] == name:
            return [Match(
                "Pacman", name, name, installed_fields[1], "system",
                archive=archive, archive_version=archive_version,
            )]
    return []


def is_package_archive_query(query: str) -> bool:
    candidate = Path(query).expanduser()
    lowered = candidate.name.casefold()
    return candidate.is_file() and (
        lowered.endswith((".rpm", ".deb")) or ".pkg.tar." in lowered
    )


DETECTORS: tuple[Callable[[str], list[Match]], ...] = (
    detect_flatpak, detect_snap, detect_dpkg, detect_rpm, detect_pacman,
    detect_homebrew, detect_gearlever, detect_pipx, detect_npm, detect_cargo,
    detect_nix, detect_appimages, detect_executable_owner,
)


def score(match: Match, query: str) -> tuple[int, str, str]:
    needle = norm(query)
    values = (norm(match.ident), norm(match.name))
    rank = (-1 if match.provides or match.archive or match.kind == "Standalone"
            else 0 if needle in values
            else 1 if any(v.startswith(needle) for v in values) else 2)
    return rank, match.kind, match.name.casefold()


def exact_app_match(match: Match, query: str) -> bool:
    needle = norm(query)
    return needle in {
        norm(match.name),
        norm(match.ident),
        norm(match.ident.rsplit(".", 1)[-1]),
        norm(Path(match.ident).stem),
    }


def find_matches(query: str) -> list[Match]:
    archive_matches = detect_package_archive(query)
    if archive_matches:
        return sorted(archive_matches, key=lambda item: score(item, query))
    matches: list[Match] = []
    for detector in DETECTORS:
        matches.extend(detector(query))
    unique = {(m.kind, m.ident, m.scope): m for m in matches}
    results = list(unique.values())
    gearlever_paths = {
        str(item.path.resolve()) for item in results
        if item.kind == "Gear Lever" and item.path
    }
    if gearlever_paths:
        results = [
            item for item in results
            if not (
                item.kind == "AppImage" and item.path
                and str(item.path.resolve()) in gearlever_paths
            )
        ]
    command_candidates = [
        item for item in results
        if item.provides or item.kind == "Standalone"
    ]
    if command_candidates:
        managed_paths = {
            item.provides for item in command_candidates
            if item.kind != "Standalone" and item.provides
        }
        commands = [
            item for item in command_candidates
            if item.kind != "Standalone" or str(item.path) not in managed_paths
        ]
        results = commands + [
            item for item in results
            if item not in command_candidates and exact_app_match(item, query)
        ]
    return sorted(results, key=lambda item: score(item, query))


def package_base(name: str) -> str:
    return name.split(":", 1)[0]


def command_lines(command: list[str]) -> tuple[bool, set[str]]:
    code, output = capture_any(command, timeout=30)
    return code == 0, {
        line.strip() for line in output.splitlines() if line.strip()
    }


def annotate_roles(matches: list[Match]) -> list[Match]:
    by_kind: dict[str, list[Match]] = defaultdict(list)
    for item in matches:
        by_kind[item.kind].append(item)
    roles: dict[tuple[str, str, str], str] = {}

    if by_kind.get("APT") and shutil.which("apt-mark"):
        ok, automatic = command_lines(["apt-mark", "showauto"])
        if ok:
            automatic_bases = {package_base(name) for name in automatic}
            for item in by_kind["APT"]:
                role = ("dependency" if package_base(item.ident) in automatic_bases
                        else "explicit")
                roles[(item.kind, item.ident, item.scope)] = role

    rpm_kinds = {"DNF"}
    present_rpm_kinds = rpm_kinds.intersection(by_kind)
    if present_rpm_kinds:
        manager = "dnf5" if shutil.which("dnf5") else "dnf"
        if manager == "dnf5":
            command = [
                manager, "repoquery", "--userinstalled",
                "--queryformat=%{name}\\n",
            ]
        else:
            command = [
                manager, "repoquery", "--installed", "--userinstalled",
                "--qf", "%{name}\\n",
            ]
        ok, explicit = command_lines(command)
        if ok:
            for kind in present_rpm_kinds:
                for item in by_kind[kind]:
                    role = "explicit" if item.ident in explicit else "dependency"
                    roles[(item.kind, item.ident, item.scope)] = role

    if by_kind.get("Pacman") and shutil.which("pacman"):
        ok, explicit = command_lines(["pacman", "-Qqe"])
        if ok:
            for item in by_kind["Pacman"]:
                role = "explicit" if item.ident in explicit else "dependency"
                roles[(item.kind, item.ident, item.scope)] = role

    if by_kind.get("Homebrew") and shutil.which("brew"):
        ok, explicit = command_lines([
            "brew", "list", "--formula", "--installed-on-request",
        ])
        if ok:
            for item in by_kind["Homebrew"]:
                role = "explicit" if item.ident in explicit else "dependency"
                roles[(item.kind, item.ident, item.scope)] = role

    inherently_explicit = {
        "Flatpak", "Homebrew Cask", "Cargo", "Pipx", "NPM", "Nix",
        "AppImage", "Gear Lever", "Standalone",
    }
    for item in matches:
        key = (item.kind, item.ident, item.scope)
        if key not in roles and item.kind in inherently_explicit:
            roles[key] = "explicit"
    return [
        replace(item, role=roles.get(
            (item.kind, item.ident, item.scope), "unknown"))
        for item in matches
    ]


def filter_dependency_matches(
        matches: list[Match], query: str, show_dependencies: bool,
) -> tuple[list[Match], int]:
    if show_dependencies:
        return matches, 0
    visible: list[Match] = []
    hidden = 0
    for item in matches:
        forced = bool(item.provides or item.archive) or exact_app_match(item, query)
        if item.role == "dependency" and not forced:
            hidden += 1
        else:
            visible.append(item)
    return visible, hidden


@lru_cache(maxsize=1)
def rpm_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    text = capture([
        "rpm", "-qa", "--qf",
        "P\\t%{NAME}\\n[R\\t%{REQUIRENAME}\\n][S\\t%{PROVIDENAME}\\n]",
    ])
    if not text:
        return {}, False
    requirement_map: dict[str, set[str]] = defaultdict(set)
    provide_map: dict[str, set[str]] = defaultdict(set)
    current = ""
    for line in text.splitlines():
        if line.startswith("P\t"):
            current = line[2:].strip()
        elif current and line.startswith("R\t"):
            requirement = line[2:].strip()
            if requirement and not requirement.startswith("rpmlib("):
                requirement_map[current].add(requirement)
        elif current and line.startswith("S\t"):
            provided = line[2:].strip()
            if provided:
                provide_map[current].add(provided)
    providers: dict[str, set[str]] = defaultdict(set)
    for package, capabilities in provide_map.items():
        providers[package].add(package)
        for capability in capabilities:
            providers[capability].add(package)
    reverse: dict[str, set[str]] = defaultdict(set)
    for dependent, requirements in requirement_map.items():
        for requirement in requirements:
            for provider in providers.get(requirement, set()):
                if provider != dependent:
                    reverse[provider].add(dependent)
    return dict(reverse), True


def split_debian_relationships(value: str) -> list[list[str]]:
    groups: list[list[str]] = []
    for group in value.split(","):
        alternatives: list[str] = []
        for alternative in group.split("|"):
            name = re.sub(r"\s*\(.*?\)", "", alternative).strip()
            name = re.sub(r"\s*\[.*?\]", "", name).strip()
            if name:
                alternatives.append(name)
        if alternatives:
            groups.append(alternatives)
    return groups


@lru_cache(maxsize=1)
def apt_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    fmt = (
        "P\\t${db:Status-Abbrev}\\t${binary:Package}\\t${Depends}\\t${Pre-Depends}"
        "\\t${Provides}\\n"
    )
    text = capture(["dpkg-query", "-W", "-f=" + fmt])
    if not text:
        return {}, False
    installed_names: set[str] = set()
    records: list[tuple[str, str, str, str]] = []
    virtuals: dict[str, set[str]] = defaultdict(set)
    for line in text.splitlines():
        fields = line.split("\t", 5)
        is_installed = len(fields) > 1 and len(fields[1]) > 1 and fields[1][1] == "i"
        if len(fields) < 6 or fields[0] != "P" or not is_installed:
            continue
        package = fields[2]
        installed_names.update({package, package_base(package)})
        records.append((package, fields[3], fields[4], fields[5]))
        for provided in fields[5].split(","):
            capability = re.sub(r"\s*\(.*?\)", "", provided).strip()
            if capability:
                virtuals[capability].add(package)
    reverse: dict[str, set[str]] = defaultdict(set)
    for dependent, depends, pre_depends, _provides in records:
        for alternatives in split_debian_relationships(
                ",".join(value for value in (depends, pre_depends) if value)):
            candidate_providers: set[str] = set()
            for alternative in alternatives:
                if alternative in installed_names:
                    candidate_providers.add(alternative)
                elif package_base(alternative) in installed_names:
                    candidate_providers.add(package_base(alternative))
                candidate_providers.update(virtuals.get(alternative, set()))
            for provider in candidate_providers:
                provider_base = package_base(provider)
                if provider_base != package_base(dependent):
                    reverse[provider_base].add(package_base(dependent))
    return dict(reverse), True


def parse_pacman_info(text: str) -> list[dict[str, str]]:
    records: list[dict[str, str]] = []
    current: dict[str, str] = {}
    last_key = ""
    for line in text.splitlines():
        if not line.strip():
            if current:
                records.append(current)
                current = {}
                last_key = ""
            continue
        if ":" in line and not line[0].isspace():
            key, value = line.split(":", 1)
            last_key = key.strip()
            current[last_key] = value.strip()
        elif current and last_key:
            current[last_key] += " " + line.strip()
    if current:
        records.append(current)
    return records


@lru_cache(maxsize=1)
def pacman_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    text = capture(["pacman", "-Qi"])
    if not text:
        return {}, False
    reverse: dict[str, set[str]] = defaultdict(set)
    for record in parse_pacman_info(text):
        package = record.get("Name", "")
        required_by = record.get("Required By", "")
        if not package or required_by == "None":
            continue
        for dependent in required_by.split():
            reverse[package].add(dependent)
    return dict(reverse), True


def root_paths(
        target: str, reverse: dict[str, set[str]], explicit: set[str],
        max_roots: int = 8, max_depth: int = 10,
) -> tuple[list[list[str]], bool]:
    roots: list[list[str]] = []
    queue: deque[list[str]] = deque([[target]])
    visited_depth: dict[str, int] = {target: 0}
    complete = True
    while queue and len(roots) < max_roots:
        path = queue.popleft()
        node = path[-1]
        depth = len(path) - 1
        for dependent in sorted(reverse.get(node, set())):
            if dependent in path:
                continue
            next_path = path + [dependent]
            if dependent in explicit and dependent != target:
                roots.append(list(reversed(next_path)))
                if len(roots) >= max_roots:
                    complete = not queue
                    break
            elif depth + 1 < max_depth:
                previous = visited_depth.get(dependent)
                if previous is None or depth + 1 <= previous:
                    visited_depth[dependent] = depth + 1
                    queue.append(next_path)
            else:
                complete = False
    if queue:
        complete = False
    return roots, complete


@lru_cache(maxsize=None)
def explicit_names_for_kind(kind: str) -> set[str]:
    if kind == "APT" and shutil.which("apt-mark"):
        ok, names = command_lines(["apt-mark", "showmanual"])
        return {package_base(name) for name in names} if ok else set()
    if kind == "DNF":
        manager = "dnf5" if shutil.which("dnf5") else "dnf"
        command = ([manager, "repoquery", "--userinstalled",
                    "--queryformat=%{name}\\n"]
                   if manager == "dnf5" else
                   [manager, "repoquery", "--installed", "--userinstalled",
                    "--qf", "%{name}\\n"])
        ok, names = command_lines(command)
        return names if ok else set()
    if kind == "Pacman" and shutil.which("pacman"):
        ok, names = command_lines(["pacman", "-Qqe"])
        return names if ok else set()
    if kind == "Homebrew" and shutil.which("brew"):
        ok, names = command_lines([
            "brew", "list", "--formula", "--installed-on-request",
        ])
        return names if ok else set()
    return set()


def dependency_report(item: Match) -> DependencyReport:
    target = package_base(item.ident)
    reverse: dict[str, set[str]] = {}
    complete = False
    note = ""
    if item.kind in {
            "DNF", "YUM", "Zypper", "RPM", "RPM-OSTree"} and shutil.which("rpm"):
        reverse, complete = rpm_reverse_graph()
        note = "RPM dependency metadata; weak dependencies may not appear."
    elif item.kind == "APT" and shutil.which("dpkg-query"):
        reverse, complete = apt_reverse_graph()
        note = "APT dependency metadata; alternatives can make paths ambiguous."
    elif item.kind == "Pacman" and shutil.which("pacman"):
        reverse, complete = pacman_reverse_graph()
    elif item.kind == "Homebrew" and shutil.which("brew"):
        direct_ok, direct = command_lines([
            "brew", "uses", "--installed", item.ident,
        ])
        recursive_ok, recursive = command_lines([
            "brew", "uses", "--installed", "--recursive", item.ident,
        ])
        explicit = explicit_names_for_kind(item.kind)
        roots = sorted(recursive.intersection(explicit))[:8]
        return DependencyReport(
            item, sorted(direct), [[root, "…", target] for root in roots],
            direct_ok and recursive_ok,
            "Homebrew reports recursive root causes without exact path edges.",
        )
    elif item.kind == "Gear Lever":
        return DependencyReport(
            item, [], [], True,
            "Gear Lever manages this installation as a single AppImage.",
        )
    else:
        return DependencyReport(
            item, [], [], False,
            "This installation method does not expose a system dependency graph.",
        )
    explicit = explicit_names_for_kind(item.kind)
    paths, paths_complete = root_paths(target, reverse, explicit)
    if not explicit and item.kind in {
            "APT", "DNF", "Pacman", "YUM", "Zypper", "RPM", "RPM-OSTree"}:
        paths_complete = False
        note = (note + " Installation-reason metadata was unavailable.").strip()
    return DependencyReport(
        item, sorted(reverse.get(target, set())), paths,
        complete and paths_complete, note,
    )


def parse_dnf_preview(output: str) -> tuple[list[str], list[str]]:
    removals: list[str] = []
    orphans: list[str] = []
    section = ""
    for raw_line in output.splitlines():
        line = raw_line.strip()
        lowered = line.casefold()
        if lowered in {
            "removing:", "removing dependent packages:",
            "removing unused dependencies:",
        }:
            section = lowered
            continue
        if not line:
            if section:
                section = ""
            continue
        if not section or lowered.startswith(("package ", "transaction ")):
            continue
        package = line.split()[0]
        if package and package not in {"Removing:", "After"}:
            removals.append(package)
            if section == "removing unused dependencies:":
                orphans.append(package)
    return list(dict.fromkeys(removals)), list(dict.fromkeys(orphans))


def native_removal_preview(
        selected: list[Match],
) -> tuple[list[str], list[str], bool, list[str]]:
    planned: list[str] = []
    orphans: list[str] = []
    available = True
    notes: list[str] = []
    by_kind: dict[str, list[str]] = defaultdict(list)
    for item in selected:
        by_kind[item.kind].append(item.ident)
    for kind, identifiers in by_kind.items():
        if kind in {"DNF", "YUM"}:
            manager = ("dnf5" if shutil.which("dnf5")
                       else "dnf" if kind == "DNF" else "yum")
            code, output = capture_any(
                [manager, "--assumeno", "remove"] + identifiers)
            removed, unused = parse_dnf_preview(output)
            if removed:
                planned.extend(removed)
                orphans.extend(unused)
            else:
                available = False
                notes.append(f"{kind} could not produce a removal transaction preview.")
            if code == 124:
                notes.append(f"{kind} preview timed out.")
        elif kind == "APT":
            code, output = capture_any(
                ["apt-get", "--simulate", "remove"] + identifiers)
            removed = [
                line.split()[1] for line in output.splitlines()
                if line.startswith("Remv ") and len(line.split()) > 1
            ]
            if code == 0:
                planned.extend(removed or identifiers)
                if os.geteuid() != 0:
                    notes.append(
                        "APT warns that a non-root simulation can miss unreadable configuration."
                    )
            else:
                available = False
                notes.append("APT simulation failed; its final prompt remains authoritative.")
        elif kind == "Pacman":
            code, output = capture_any(
                ["pacman", "-R", "--print", "--print-format", "%n"] + identifiers)
            removed = [
                line.strip() for line in output.splitlines()
                if line.strip() and " " not in line.strip()
            ]
            if code == 0:
                planned.extend(removed or identifiers)
            else:
                available = False
                notes.append(
                    "Pacman rejected the preview, usually because another package requires the target."
                )
        elif kind == "Zypper":
            code, output = capture_any(
                ["zypper", "--non-interactive", "--dry-run", "remove"]
                + identifiers)
            if code == 0:
                planned.extend(identifiers)
                available = False
                notes.append(
                    "Zypper completed a dry-run, but its extra removals could not be parsed reliably."
                )
            else:
                available = False
                notes.append("Zypper dry-run failed.")
        elif kind == "RPM-OSTree":
            code, _output = capture_any(
                ["rpm-ostree", "uninstall", "--dry-run"] + identifiers)
            if code == 0:
                planned.extend(identifiers)
            else:
                available = False
                notes.append("rpm-ostree did not provide a usable dry-run.")
        elif kind == "RPM":
            code, _output = capture_any(
                ["rpm", "-e", "--test"] + identifiers)
            if code == 0:
                planned.extend(identifiers)
            else:
                available = False
                notes.append(
                    "RPM's test transaction rejected the removal, usually because "
                    "another package requires the target."
                )
        elif kind == "Snap":
            planned.extend(identifiers)
            available = False
            notes.append(
                "Snap bases and content providers are checked by snapd only during removal."
            )
        elif kind in {
            "Flatpak", "Homebrew Cask", "Cargo", "Pipx",
            "NPM", "Nix", "AppImage", "Gear Lever",
        }:
            planned.extend(identifiers)
            if kind == "Gear Lever":
                notes.append(
                    "Gear Lever will trash the AppImage when possible and remove its "
                    "desktop entry, icon, and update metadata."
                )
        elif kind == "Homebrew":
            planned.extend(identifiers)
            available = False
            notes.append("Homebrew will perform its installed-dependent check during removal.")
        elif kind == "Standalone":
            planned.extend(identifiers)
            available = False
            notes.append("Standalone files have no package dependency metadata.")
        else:
            available = False
            notes.append(f"No read-only transaction preview is available for {kind}.")
    return (
        list(dict.fromkeys(planned)),
        list(dict.fromkeys(orphans)),
        available,
        notes,
    )


@lru_cache(maxsize=1)
def apt_held_packages() -> set[str]:
    if not shutil.which("apt-mark"):
        return set()
    ok, names = command_lines(["apt-mark", "showhold"])
    return {package_base(name) for name in names} if ok else set()


@lru_cache(maxsize=1)
def dnf_protected_patterns() -> set[str]:
    patterns = {
        "dnf", "dnf5", "rpm", "systemd", "systemd-udev",
        "kernel", "kernel-core", "kernel-modules", "glibc",
    }
    for directory in (Path("/etc/dnf/protected.d"), Path("/etc/yum/protected.d")):
        if not directory.is_dir():
            continue
        try:
            for config in directory.glob("*.conf"):
                for line in config.read_text(
                        encoding="utf-8", errors="replace").splitlines():
                    value = line.strip()
                    if value and not value.startswith("#"):
                        patterns.add(value)
        except OSError:
            continue
    return patterns


def protection_reason(kind: str, name: str) -> str:
    base = package_base(name)
    universal_core = {
        "apt", "dpkg", "pacman", "rpm", "dnf", "dnf5", "sudo",
        "systemd", "systemd-udev", "filesystem", "basesystem",
        "glibc", "libc6",
    }
    if base in universal_core or base.startswith("kernel"):
        return "core system package"
    if kind == "APT":
        if base in apt_held_packages():
            return "held by APT"
        details = capture([
            "dpkg-query", "-W", "-f=${Essential}\\t${Priority}", name,
        ]).strip().split("\t", 1)
        if details and details[0].casefold() == "yes":
            return "Essential package"
        if len(details) > 1 and details[1].casefold() == "required":
            return "required-priority package"
    if kind in {"DNF", "YUM", "RPM", "RPM-OSTree"}:
        for pattern in dnf_protected_patterns():
            if fnmatch.fnmatchcase(base, pattern):
                return "protected/core RPM package"
    if kind == "Pacman":
        try:
            text = Path("/etc/pacman.conf").read_text(
                encoding="utf-8", errors="replace")
        except OSError:
            text = ""
        for line in text.splitlines():
            if line.strip().startswith("HoldPkg") and "=" in line:
                held = line.split("=", 1)[1].split()
                if any(fnmatch.fnmatchcase(base, pattern) for pattern in held):
                    return "held by Pacman configuration"
    return ""


def build_removal_plan(selected: list[Match]) -> RemovalPlan:
    reports = [dependency_report(item) for item in selected]
    planned, orphans, preview_available, notes = native_removal_preview(selected)
    requested = {package_base(item.ident) for item in selected}
    additional = [
        name for name in planned
        if package_base(name) not in requested
    ]
    protected_items: list[str] = []
    kinds = {item.kind for item in selected}
    protection_kind = next(iter(kinds)) if len(kinds) == 1 else ""
    selected_kinds = {
        package_base(item.ident): item.kind for item in selected
    }
    for name in planned:
        reason = protection_reason(
            selected_kinds.get(package_base(name), protection_kind), name)
        if reason:
            protected_items.append(f"{name} ({reason})")
    has_dependents = any(
        report.direct_dependents or report.root_paths for report in reports)
    uncertain_kinds = {
        "APT", "DNF", "YUM", "Zypper", "RPM", "Pacman", "RPM-OSTree",
        "Homebrew", "Snap", "Standalone",
    }
    if (protected_items or has_dependents
            or any(name not in orphans for name in additional)):
        level = "HIGH"
    elif orphans or any(item.role == "dependency" for item in selected):
        level = "CAUTION"
    elif not preview_available and any(
            item.kind in uncertain_kinds for item in selected):
        level = "UNKNOWN"
    else:
        level = "SAFE"
    notes.append(
        "This plan is a snapshot; the package manager's final transaction remains authoritative."
    )
    return RemovalPlan(
        selected, reports, planned or [item.ident for item in selected],
        additional, orphans, level, preview_available, protected_items, notes,
    )


def show_dependency_reports(reports: list[DependencyReport]) -> None:
    for report in reports:
        item = report.target
        print(f"\n{display(item.name)} [{display(item.kind)}]")
        print(f"  Installation role: {display(item.role)}")
        if report.direct_dependents:
            print("  Directly required by: "
                  + ", ".join(display(name) for name in report.direct_dependents[:12]))
            if len(report.direct_dependents) > 12:
                print(f"  …and {len(report.direct_dependents) - 12} more")
        if report.root_paths:
            print("  Root causes:")
            for path in report.root_paths:
                print("    " + " → ".join(display(node) for node in path))
        if not report.complete:
            print("  Dependency explanation may be incomplete.")
        if report.note:
            print(f"  Note: {display(report.note)}")


def show_removal_plan(plan: RemovalPlan) -> None:
    print("\nDependency and removal plan")
    print(f"  Impact: {plan.level}")
    show_dependency_reports(plan.reports)
    print("\n  Planned removals:")
    root_names = {
        path[0] for report in plan.reports for path in report.root_paths if path
    }
    for name in plan.planned_removals:
        if name in plan.orphan_removals:
            suffix = " (unused dependency)"
        elif package_base(name) in root_names:
            suffix = " (explicit root application)"
        elif name in plan.additional_removals:
            suffix = " (additional dependent package)"
        else:
            suffix = ""
        print(f"    {display(name)}{suffix}")
    if plan.protected_items:
        print("  Protected or critical packages:")
        for item in plan.protected_items:
            print(f"    {display(item)}")
    if not plan.additional_removals:
        print("  No additional package removals were found.")
    for note in plan.notes:
        print(f"  Note: {display(note)}")


def choose(matches: list[Match]) -> list[Match]:
    print(f"\nFound {len(matches)} likely installed option{'s' if len(matches) != 1 else ''}:\n")
    for index, item in enumerate(matches, 1):
        role = (item.role if item.role == "dependency"
                else "role unknown" if item.role == "unknown" else "")
        details = " · ".join(
            display(value) for value in (item.version, item.scope, role) if value)
        print(f"  {index:>2}. {display(item.name)}  [{display(item.kind)}]"
              f"{'  ' + details if details else ''}")
        if item.ident != item.name:
            print(f"      {display(item.ident)}")
        if item.provides:
            print(f"      provides command: {display(item.provides)}")
        if item.archive:
            print(f"      matched package archive: {display(item.archive)}")
            if (item.archive_version and item.version
                    and item.archive_version != item.version):
                print(
                    f"      warning: archive version {display(item.archive_version)}; "
                    f"installed version {display(item.version)}"
                )
        if item.kind == "Standalone":
            print("      note: only this executable can be identified automatically")
    print("\nChoose numbers separated by commas, “a” for all, or Enter to cancel.")
    while True:
        raw = input("> ").strip().casefold()
        if not raw:
            return []
        if raw in {"a", "all"}:
            return matches
        try:
            indexes = {int(part.strip()) for part in raw.split(",")}
        except ValueError:
            print("That selection was not understood; try again.", file=sys.stderr)
            continue
        if not indexes or min(indexes) < 1 or max(indexes) > len(matches):
            print("Selection is out of range; try again.", file=sys.stderr)
            continue
        return [item for index, item in enumerate(matches, 1) if index in indexes]


def data_keys(selected: Iterable[Match]) -> set[str]:
    keys: set[str] = set()
    for item in selected:
        values = (item.name, item.ident, Path(item.ident).stem)
        for value in values:
            simple = norm(value)
            if len(simple) >= 3:
                keys.add(simple)
            tail = norm(value.rsplit(".", 1)[-1])
            if len(tail) >= 3:
                keys.add(tail)
            versionless = norm(re.sub(
                r"[-_. ]v?\d+(?:[-_.]\d+)*.*$", "", value,
                flags=re.IGNORECASE,
            ))
            if len(versionless) >= 3:
                keys.add(versionless)
    return keys


def xdg_dir(variable: str, fallback: Path) -> Path:
    configured = os.environ.get(variable)
    if not configured:
        return fallback
    path = Path(configured).expanduser()
    return path if path.is_absolute() else fallback


def user_data_roots() -> list[Path]:
    home = Path.home()
    return [
        xdg_dir("XDG_CONFIG_HOME", home / ".config"),
        xdg_dir("XDG_CACHE_HOME", home / ".cache"),
        xdg_dir("XDG_DATA_HOME", home / ".local/share"),
        xdg_dir("XDG_STATE_HOME", home / ".local/state"),
    ]


def find_user_data(selected: list[Match]) -> list[Path]:
    keys = data_keys(selected)
    roots = user_data_roots()
    paths: set[Path] = set()
    for root in roots:
        if not root.is_dir():
            continue
        try:
            for child in root.iterdir():
                child_key = norm(child.name)
                if child_key in keys and (child.is_dir() or child.is_symlink()):
                    paths.add(child)
        except OSError:
            pass
    for item in selected:
        if item.kind == "Snap":
            candidate = Path.home() / "snap" / item.ident
            if candidate.exists():
                paths.add(candidate)
    data_home = xdg_dir("XDG_DATA_HOME", Path.home() / ".local/share")
    applications = data_home / "applications"
    if applications.is_dir():
        selected_files = {
            str(item.path) for item in selected
            if item.path and item.kind in {"AppImage", "Standalone"}
        }
        manager_owned_files = {
            str(item.path) for item in selected
            if item.path and item.kind == "Gear Lever"
        }
        try:
            for desktop_file in applications.glob("*.desktop"):
                matches_name = norm(desktop_file.stem) in keys
                references_file = False
                manager_owned = False
                if selected_files or manager_owned_files:
                    try:
                        if desktop_file.stat().st_size <= 1024 * 1024:
                            content = desktop_file.read_text(
                                encoding="utf-8", errors="replace")
                            references_file = any(
                                target in content for target in selected_files)
                            manager_owned = any(
                                target in content for target in manager_owned_files)
                    except OSError:
                        pass
                if manager_owned:
                    continue
                if matches_name or references_file:
                    paths.add(desktop_file)
        except OSError:
            pass
    icons = data_home / "icons"
    if icons.is_dir():
        try:
            for icon in icons.glob("hicolor/*/apps/*"):
                if icon.is_file() and norm(icon.stem) in keys:
                    paths.add(icon)
        except OSError:
            pass
    return sorted(paths)


def privileged(command: list[str]) -> list[str]:
    if os.geteuid() == 0:
        return command
    for helper in ("sudo", "doas"):
        if shutil.which(helper):
            return [helper] + command
    raise RuntimeError(
        f"{command[0]} needs administrator privileges, but neither sudo nor doas is installed"
    )


def uninstall_command(item: Match, remove_data: bool) -> list[str]:
    if item.kind == "Flatpak":
        command = ["flatpak", "uninstall", "-y", f"--{item.scope}"]
        if remove_data:
            command.append("--delete-data")
        return command + [item.ident]
    if item.kind == "Snap":
        command = ["snap", "remove"]
        if remove_data:
            command.append("--purge")
        return privileged(command + [item.ident])
    if item.kind == "APT":
        action = "purge" if remove_data else "remove"
        return privileged(["apt-get", action, item.ident])
    if item.kind == "DNF":
        manager = "dnf5" if shutil.which("dnf5") else "dnf"
        return privileged([manager, "remove", item.ident])
    if item.kind == "RPM-OSTree":
        return privileged(["rpm-ostree", "uninstall", item.ident])
    if item.kind == "Zypper":
        return privileged(["zypper", "remove", item.ident])
    if item.kind == "YUM":
        return privileged(["yum", "remove", item.ident])
    if item.kind == "RPM":
        return privileged(["rpm", "-e", item.ident])
    if item.kind == "Pacman":
        return privileged(["pacman", "-R", item.ident])
    if item.kind in {"Homebrew", "Homebrew Cask"}:
        command = ["brew", "uninstall"]
        if item.kind == "Homebrew Cask":
            command.append("--cask")
        return command + [item.ident]
    if item.kind == "Cargo":
        return ["cargo", "uninstall", item.ident]
    if item.kind == "Pipx":
        command = ["pipx", "uninstall"]
        if item.scope == "system":
            command.append("--global")
            return privileged(command + [item.ident])
        return command + [item.ident]
    if item.kind == "NPM":
        command = ["npm", "uninstall", "--global", item.ident]
        return command if item.scope == "user" else privileged(command)
    if item.kind == "Nix":
        return ["nix", "profile", "remove", item.ident]
    if item.kind == "Gear Lever" and item.path:
        command = gearlever_command()
        if not command:
            raise RuntimeError("Gear Lever is no longer available")
        return command + ["--remove", str(item.path), "--yes"]
    if item.kind == "AppImage" and item.path:
        command = ["rm", "--", str(item.path)]
        return command if os.access(item.path.parent, os.W_OK) else privileged(command)
    if item.kind == "Standalone" and item.path:
        command = ["rm", "--", str(item.path)]
        return command if os.access(item.path.parent, os.W_OK) else privileged(command)
    raise ValueError(f"Unsupported package kind: {item.kind}")


def yes(prompt: str) -> bool:
    try:
        return input(prompt).strip().casefold() in {"y", "yes"}
    except EOFError:
        return False


def preflight_file(item: Match) -> str | None:
    if item.kind not in {"AppImage", "Gear Lever", "Standalone"} or not item.path:
        return None
    path = item.path
    if not path.is_absolute():
        return "target path is not absolute"
    if not path.exists() and not path.is_symlink():
        return "target no longer exists"
    if path.is_dir() and not path.is_symlink():
        return "target unexpectedly became a directory"
    if item.kind == "Standalone":
        current = shutil.which(item.name)
        if not current or Path(current).absolute() != path:
            return "the command resolved to a different path since it was selected"
    return None


def remove_paths(paths: list[Path]) -> bool:
    ok = True
    allowed_roots = [root.resolve() for root in user_data_roots()]
    allowed_roots.append((Path.home() / "snap").resolve())
    for path in paths:
        try:
            resolved_parent = path.parent.resolve()
            if not any(
                resolved_parent == root or root in resolved_parent.parents
                for root in allowed_roots
            ):
                raise ValueError("path is outside the approved app-data locations")
            if path.is_symlink() or path.is_file():
                path.unlink()
            elif path.is_dir():
                shutil.rmtree(path)
            else:
                print(f"  Already removed {display(path)}")
                continue
            print(f"  Removed {display(path)}")
        except (OSError, ValueError) as error:
            ok = False
            print(f"  Could not remove {display(path)}: {display(error)}", file=sys.stderr)
    return ok


def run_uninstall(
        query: str, show_dependencies: bool = False,
        plan_only: bool = False, why_only: bool = False,
) -> int:
    print(f"Searching installed apps for “{display(query)}”…")
    matches = annotate_roles(find_matches(query))
    matches, hidden_dependencies = filter_dependency_matches(
        matches, query, show_dependencies or why_only)
    if hidden_dependencies:
        print(
            f"Hidden {hidden_dependencies} fuzzy dependency match"
            f"{'es' if hidden_dependencies != 1 else ''}; "
            "use --show-dependencies to include them."
        )
    if not matches:
        if is_package_archive_query(query):
            print(
                "No installed package matched this archive. "
                "The downloaded archive itself was not removed."
            )
        else:
            print("No likely installed apps found.")
        return 1
    try:
        selected = choose(matches)
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return 130
    if not selected:
        print("Nothing selected.")
        return 0

    if why_only:
        show_dependency_reports([dependency_report(item) for item in selected])
        return 0

    for item in selected:
        error = preflight_file(item)
        if error:
            print(f"Cannot safely remove {display(item.name)}: {error}.",
                  file=sys.stderr)
            return 1

    plan = build_removal_plan(selected)
    show_removal_plan(plan)
    if plan_only:
        print("\nPlan only; nothing was changed.")
        return 0

    paths = find_user_data(selected)
    remove_data = False
    if paths or any(item.kind in {"Flatpak", "Snap", "APT"} for item in selected):
        print("\nAlso remove app data and saved configuration?")
        if paths:
            for path in paths:
                print(f"  {display(path)}")
        if any(item.kind == "APT" for item in selected):
            print("  APT will also purge package-managed system configuration.")
        print("This cannot be undone.")
        remove_data = yes("Remove app data? [y/N] ")

    try:
        commands = [uninstall_command(item, remove_data) for item in selected]
    except RuntimeError as error:
        print(display(error) + ".", file=sys.stderr)
        return 1
    print("\nReady to run:")
    for command in commands:
        print("  " + display(shlex.join(command)))
    if remove_data and paths:
        print(f"  and remove {len(paths)} user-data path{'s' if len(paths) != 1 else ''}")
    if plan.level in {"HIGH", "UNKNOWN"}:
        expected = ("REMOVE " + selected[0].ident if len(selected) == 1
                    else "REMOVE ALL")
        try:
            confirmation = input(
                f"\n{plan.level.title()}-impact transaction. "
                f"Type “{expected}” to continue: "
            ).strip()
        except EOFError:
            confirmation = ""
        if confirmation != expected:
            print("Cancelled.")
            return 0
    elif not yes("\nContinue? [y/N] "):
        print("Cancelled.")
        return 0

    failed = False
    for item, command in zip(selected, commands):
        print(f"\nRemoving {display(item.name)} ({display(item.kind)})…")
        try:
            result = subprocess.run(command, check=False)
        except OSError as error:
            print(f"Could not run {display(command[0])}: {display(error)}", file=sys.stderr)
            failed = True
            continue
        if result.returncode:
            print(f"Removal failed with exit code {result.returncode}.", file=sys.stderr)
            failed = True
    if remove_data and paths:
        if failed:
            print("\nApp data was kept because an uninstall command failed.")
        elif not remove_paths(paths):
            failed = True
    print("\nFinished." if not failed else "\nFinished with errors.")
    return 1 if failed else 0


def self_uninstall() -> int:
    located = shutil.which(sys.argv[0])
    target = Path(located if located else sys.argv[0]).absolute()
    if not target.is_file():
        print("Cannot locate the installed executable.", file=sys.stderr)
        return 1
    print(f"This will remove uninstall itself:\n  {display(target)}")
    if not yes("Continue? [y/N] "):
        print("Cancelled.")
        return 0
    command = ["rm", "--", str(target)]
    try:
        if not os.access(target.parent, os.W_OK):
            command = privileged(command)
        return subprocess.run(command, check=False).returncode
    except (OSError, RuntimeError) as error:
        print(f"Could not remove uninstall: {display(error)}", file=sys.stderr)
        return 1


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="uninstall",
        description="Find and safely uninstall Linux apps, however they were installed.",
    )
    parser.add_argument("app", nargs="?", help="app name to find")
    parser.add_argument("--self-uninstall", action="store_true",
                        help="remove this command from the system")
    parser.add_argument("--show-dependencies", action="store_true",
                        help="include fuzzy matches installed as dependencies")
    parser.add_argument("--why", action="store_true",
                        help="explain why the selected package is installed; change nothing")
    parser.add_argument("--plan", action="store_true",
                        help="show dependency and transaction impact; change nothing")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    args = parser.parse_args()
    if os.geteuid() == 0 and os.environ.get("SUDO_USER") not in {None, "", "root"}:
        print("Run uninstall without sudo; it requests privilege only when needed.",
              file=sys.stderr)
        return 2
    if args.self_uninstall:
        return self_uninstall()
    if not args.app:
        parser.print_help()
        return 2
    if norm(args.app) == "uninstall":
        return self_uninstall()
    return run_uninstall(
        args.app, show_dependencies=args.show_dependencies,
        plan_only=args.plan, why_only=args.why,
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nCancelled.", file=sys.stderr)
        raise SystemExit(130)
