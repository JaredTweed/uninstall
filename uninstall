def dnf_group_install_reason(target: str) -> str:
    record = dnf_install_record(target)
    transaction = (
        f"DNF transaction {record.transaction_id}: "
        f"{compact_history_command(record.command)}"
        if record else ""
    )
    if not record:
        return "installed as part of a package group"
    if record.reason.casefold() != "group":
        generic = "installed as part of a package group"
        return f"{generic}; {transaction}" if transaction else generic

    recorded_groups = set(record.groups)
    memberships = [
        (group_id, name)
        for group_id, name in dnf_group_memberships(target)
        if group_id in recorded_groups
    ]
    if len(memberships) != 1:
        generic = "installed as part of a package group"
        return f"{generic}; {transaction}" if transaction else generic

    group_id, group_name = memberships[0]
    environments: list[str] = []
    for environment_id in record.environments:
        environment_name, environment_groups = dnf_environment_details(
            environment_id)
        if group_id not in environment_groups:
            continue
        if (environment_name
                and not environment_name.casefold().endswith("environment")):
            environment_name += " Environment"
        environments.append(environment_name or environment_id)

    group = f"{group_name} ({group_id})"
    if len(environments) == 1:
        cause = f"installed through {environments[0]} \u2192 {group}"
    else:
        cause = f"installed as part of {group}"
    return f"{cause}; {transaction}" if transaction else cause


@lru_cache(maxsize=128)
def xbps_reverse_dependencies(target: str) -> tuple[bool, set[str]]:
