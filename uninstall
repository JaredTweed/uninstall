@lru_cache(maxsize=1)
def opkg_provider_map() -> dict[str, set[str]]:
    providers: dict[str, set[str]] = defaultdict(set)
    for record in opkg_inventory():
        providers[record.ident].add(record.ident)
        for capability in record.provides:
            name = dependency_name(capability)
            if name:
                providers[name].add(record.ident)
    return dict(providers)


@lru_cache(maxsize=1)
def opkg_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    inventory = opkg_inventory()
    if not inventory:
        return {}, False
    providers = opkg_provider_map()
    reverse: dict[str, set[str]] = defaultdict(set)
    for record in inventory:
        for raw_dependency in record.depends:
            for alternative in raw_dependency.split("|"):
                capability = dependency_name(alternative.strip())
                for provider in providers.get(capability, set()):
                    if provider != record.ident:
                        reverse[provider].add(record.ident)
    return dict(reverse), True


