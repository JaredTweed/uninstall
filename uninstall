@lru_cache(maxsize=None)  # noqa: UP033 -- functools.cache requires Python 3.9.
def explicit_names_for_kind(kind: str) -> set[str]:
    if kind == "APT" and shutil.which("apt-mark"):
        ok, names = command_lines(["apt-mark", "showmanual"])
        return {package_base(name) for name in names} if ok else set()
    if kind == "DNF":
        reasons_ok, reasons = dnf_install_reasons()
        if reasons_ok:
            return {
                name for name, reason in reasons.items()
                if reason.casefold() in {
                    "user", "external", "external user", "group"}
            }
        manager = dnf_binary() or "dnf"
        command = ([manager, "repoquery", "--userinstalled",
                    "--queryformat=%{name}\\n"]
                   if manager == "dnf5" else
                   [manager, "repoquery", "--installed", "--userinstalled",
                    "--qf", "%{name}\\n"])
        ok, names = command_lines(command)
        return names if ok else set()
    if kind == "Pacman" and shutil.which("pacman"):
        ok, names = command_lines(["pacman", "-Qqe"])
        return names if ok else set()
    if kind == "APK":
        return set(apk_explicit_causes())
    if kind == "OPKG":
        return {
            record.ident for record in opkg_inventory()
            if record.origin == "explicit"
        }
    if kind == "XBPS":
        ok, names = xbps_manual_packages()
        return names if ok else set()
    if kind == "Portage":
        return set(portage_world())
    if kind == "Eopkg":
        ok, automatic = eopkg_automatic_packages()
        return (
            {record.ident for record in eopkg_inventory()} - set(automatic)
            if ok else set()
        )
    if kind == "Swupd":
        return {
            record.ident for record in swupd_inventory()
            if record.origin == "explicit"
        }
    if kind == "Homebrew" and shutil.which("brew"):
        ok, names = command_lines([
            "brew", "list", "--formula", "--installed-on-request",
        ])
        return names if ok else set()
    if kind == "Zypper" and shutil.which("zypper"):
        ok, names = zypper_userinstalled()
        return names if ok else set()
    if kind == "YUM" and shutil.which("yum"):
        ok, names = command_lines([
            "yum", "repoquery", "--installed", "--userinstalled",
            "--qf", "%{name}\\n",
        ])
        return names if ok else set()
    if kind == "RPM-OSTree":
        ok, names = rpm_ostree_layered_packages()
        return names if ok else set()
    return set()


def dependency_report(item: Match) -> DependencyReport:
    target = package_base(item.ident)
    reverse: dict[str, set[str]] = {}
    all_reverse: dict[str, set[str]] = {}
    relation_map: dict[tuple[str, str], set[str]] = {}
    complete = False
    note = ""
    if item.kind in {
            "DNF", "YUM", "Zypper", "RPM", "RPM-OSTree", "URPMI",
            "APT-RPM"} and shutil.which("rpm"):
        reverse, all_reverse, relation_map, complete = rpm_dependency_graph()
        note = (
            "Paths use current RPM metadata; complex conditional "
            "dependencies can be ambiguous."
        )
    elif item.kind == "APT" and shutil.which("dpkg-query"):
        reverse, complete = apt_reverse_graph()
        note = "Paths use current APT metadata; alternatives can be ambiguous."
    elif item.kind == "Pacman" and shutil.which("pacman"):
        reverse, complete = pacman_reverse_graph()
    elif item.kind == "APK" and shutil.which("apk"):
        reverse, complete = apk_reverse_graph()
        note = "Paths use the current APK installed database and world file."
    elif item.kind == "OPKG" and shutil.which("opkg"):
        reverse, complete = opkg_reverse_graph()
        note = "Paths use the current OPKG status database."
    elif item.kind == "XBPS" and shutil.which("xbps-query"):
        return xbps_dependency_report(item)
    elif item.kind == "Eopkg" and shutil.which("eopkg"):
        return eopkg_dependency_report(item)
    elif item.kind == "Swupd" and shutil.which("swupd"):
        return swupd_dependency_report(item)
    elif item.kind == "Homebrew" and shutil.which("brew"):
        direct_ok, direct = command_lines([
            "brew", "uses", "--installed", item.ident,
        ])
        recursive_ok, recursive = command_lines([
            "brew", "uses", "--installed", "--recursive", item.ident,
        ])
        explicit = explicit_names_for_kind(item.kind)
        roots = sorted(recursive.intersection(explicit))[:8]
        return DependencyReport(
            item, sorted(direct), [[root, "...", target] for root in roots],
            direct_ok and recursive_ok,
            "Homebrew reports recursive root causes without exact path edges.",
        )
    elif item.kind == "Gear Lever":
        return DependencyReport(
            item, [], [], True,
            "Gear Lever manages this installation as a single AppImage.",
        )
    elif item.kind in {
            "Flatpak", "AppImage", "Standalone", "Cargo", "Pipx", "NPM", "Nix",
            "Nix Legacy", "Guix", "Homebrew Cask"}:
        return DependencyReport(
            item, [], [], True,
            "This is a top-level or self-contained installation; "
            "no system-package dependency path applies.",
        )
    else:
        return DependencyReport(
            item, [], [], False,
            "This installation method does not expose a system dependency graph.",
        )
    explicit = explicit_names_for_kind(item.kind)
    paths, paths_complete = root_paths(target, reverse, explicit)
    relationship_paths: list[tuple[list[str], list[str]]] = []
    relationship_paths_complete = True
    weak_relations: list[tuple[str, str]] = []
    if relation_map:
        all_paths, relationship_paths_complete = relationship_root_paths(
            target, all_reverse, relation_map, explicit)
        relationship_paths = [
            path for path in all_paths
            if any(relation != "requires" for relation in path[1])
        ]
        for dependent in sorted(all_reverse.get(target, set())):
            for relation in sorted(
                    relation_map.get((target, dependent), set()) - {"requires"}):
                weak_relations.append((dependent, relation))
    if not explicit and item.kind in {
            "APT", "DNF", "Pacman", "APK", "OPKG", "XBPS", "Portage", "YUM",
            "Zypper", "RPM", "RPM-OSTree", "Swupd"}:
        paths_complete = False
        note = (note + " Installation-reason metadata was unavailable.").strip()
    return DependencyReport(
        target=item,
        direct_dependents=sorted(reverse.get(target, set())),
        root_paths=paths,
        complete=complete and paths_complete and relationship_paths_complete,
        note=note,
        weak_relations=weak_relations,
        relationship_paths=relationship_paths,
        history_reason=(
            dnf_history_reason(target) if item.kind == "DNF" else ""),
    )


def compact_dependency_cause(report: DependencyReport) -> str:
    causes: list[str] = []
    for nodes, relations in report.relationship_paths:
        if len(nodes) == 2 and relations:
            parent = display(nodes[0])
            relation = relations[0]
            if relation in {"requires", "recommends", "suggests"}:
                causes.append(f"{parent} {relation} it")
                continue
            if relation == "is supplemented by":
                causes.append(f"it supplements {parent}")
                continue
            if relation == "is enhanced by":
                causes.append(f"it enhances {parent}")
                continue
        causes.append(
            "dependency path " + render_relationship_path(nodes, relations))
    for path in report.root_paths:
        if len(path) == 2:
            causes.append(f"{display(path[0])} requires it")
        else:
            causes.append("required through " + " -> ".join(
                display(node) for node in path))
    if not causes and report.direct_dependents:
        names = ", ".join(display(name) for name in report.direct_dependents[:3])
        causes.append(f"required directly by {names}")
    if not causes and report.weak_relations:
        dependent, relation = report.weak_relations[0]
        causes.append(f"{display(dependent)} {display(relation)} it")
    causes = list(dict.fromkeys(causes))
    if len(causes) > 2:
        return f"{causes[0]} and {causes[1]} (+{len(causes) - 2} other roots)"
    return " and ".join(causes)


def compact_history_command(command: str, limit: int = 180) -> str:
    """Keep retained installer commands useful without flooding one line."""
    command = " ".join(command.split())
    if len(command) <= limit:
        return command
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = []
    manager_index = next((
        index for index, token in enumerate(tokens)
        if Path(token).name in {
            "apt", "apt-get", "dnf", "dnf5", "yum", "pacman", "zypper"}
    ), None)
    if manager_index is not None:
        manager = Path(tokens[manager_index]).name
        tail = tokens[manager_index + 1:]
        action_index = next((
            index for index, token in enumerate(tail)
            if token in {"install", "in", "-S"}
        ), None)
        if action_index is not None:
            action = tail[action_index]
            candidates = tail[action_index + 1:]
            group_targets = [
                token for token in candidates if token.startswith("@")]
            target = next((
                token for token in group_targets
                if "environment" in token.casefold()
            ), group_targets[0] if group_targets else "")
            if not target:
                target = next((
                    token for token in candidates
                    if token and not token.startswith("-")
                ), "")
            if target:
                return (
                    f"{manager} {action} {target} "
                    "(original command abbreviated)"
                )
    suffix = "… (original command abbreviated)"
    return command[:max(1, limit - len(suffix))].rstrip() + suffix


def recorded_event(
        source: str, event: tuple[str, str] | None,
) -> str:
    if not event:
        return f"{source}; original installation event unavailable"
    date, command = event
    when = f" on {date}" if date else ""
    return f"{source}; recorded{when}: {compact_history_command(command)}"


def read_history_file(path: Path) -> str:
    try:
        if path.suffix == ".gz":
            with gzip.open(
                    path, "rt", encoding="utf-8",
                    errors="replace") as stream:
                return stream.read()
        if path.suffix == ".xz":
            with lzma.open(
                    path, "rt", encoding="utf-8",
                    errors="replace") as stream:
                return stream.read()
        if path.suffix == ".zst":
            return capture(["zstd", "--decompress", "--stdout", "--", str(path)])
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def parse_apt_history(
        text: str, target: str,
) -> list[tuple[str, str]]:
    events: list[tuple[str, str]] = []
    package_pattern = re.compile(
        rf"(?<![A-Za-z0-9+.-]){re.escape(package_base(target))}"
        r"(?::[A-Za-z0-9_-]+)?\s+\(",
    )
    for block in re.split(r"\n\s*\n", text):
        fields: dict[str, str] = {}
        current_key = ""
        for line in block.splitlines():
            if ": " in line and not line[0].isspace():
                current_key, value = line.split(": ", 1)
                fields[current_key] = value.strip()
            elif current_key and line[:1].isspace():
                fields[current_key] += " " + line.strip()
        package_lines = " ".join(
            fields.get(key, "")
            for key in ("Install", "Reinstall", "Upgrade")
        )
        command = fields.get("Commandline", "")
        if command and package_pattern.search(package_lines):
            events.append((fields.get("Start-Date", ""), command))
    return events


@lru_cache(maxsize=64)
def apt_history_event(target: str) -> tuple[str, str] | None:
    return apt_history_index().get(package_base(target))


@lru_cache(maxsize=1)
def apt_history_index() -> dict[str, tuple[str, str]]:
    lifecycle: list[tuple[str, int, str, str, str]] = []
    try:
        paths = list(Path("/var/log/apt").glob("history.log*"))
    except OSError:
        paths = []
    sequence = 0
    for path in paths:
        text = read_history_file(path)
        for block in re.split(r"\n\s*\n", text):
            fields: dict[str, str] = {}
            current_key = ""
            for line in block.splitlines():
                if ": " in line and line and not line[0].isspace():
                    current_key, value = line.split(": ", 1)
                    fields[current_key] = value.strip()
                elif current_key and line[:1].isspace():
                    fields[current_key] += " " + line.strip()
            command = fields.get("Commandline", "")
            if not command:
                continue
            date = fields.get("Start-Date", "")
            for field_name, action in (
                    ("Install", "install"), ("Reinstall", "reinstall"),
                    ("Upgrade", "upgrade"), ("Remove", "remove"),
                    ("Purge", "remove")):
                for match in re.finditer(
                        r"(?:^|,\s*)([A-Za-z0-9+.-]+)"
                        r"(?::[A-Za-z0-9_-]+)?\s+\(",
                        fields.get(field_name, "")):
                    lifecycle.append((
                        date, sequence, match.group(1), action, command,
                    ))
                    sequence += 1
    retained: dict[str, tuple[str, str]] = {}
    for date, _sequence, package, action, command in sorted(lifecycle):
        if action == "remove":
            retained.pop(package, None)
        elif action == "install" or (
                action == "reinstall" and package not in retained):
            retained.setdefault(package, (date, command))
    return retained


def parse_pacman_history(
        text: str, target: str,
) -> tuple[str, str] | None:
    current_command = ""
    target_pattern = re.compile(
        rf"\[ALPM\] installed {re.escape(package_base(target))} \(")
    for line in text.splitlines():
        if "[PACMAN] Running " in line:
            current_command = line.split("[PACMAN] Running ", 1)[1].strip("'")
        if target_pattern.search(line):
            date = line[1:line.find("]")] if line.startswith("[") else ""
            command = current_command or f"installed {package_base(target)}"
            return date, command
    return None


@lru_cache(maxsize=64)
def pacman_history_event(target: str) -> tuple[str, str] | None:
    return pacman_history_index().get(package_base(target))


@lru_cache(maxsize=1)
def pacman_history_index() -> dict[str, tuple[str, str]]:
    try:
        paths = list(Path("/var/log").glob("pacman.log*"))
    except OSError:
        return {}
    lifecycle: list[tuple[str, int, str, str, str]] = []
    pattern = re.compile(
        r"\[ALPM\] (installed|reinstalled|removed|upgraded) ([^ ]+) \(")
    sequence = 0
    for path in paths:
        current_command = ""
        for line in read_history_file(path).splitlines():
            if "[PACMAN] Running " in line:
                current_command = line.split(
                    "[PACMAN] Running ", 1)[1].strip("'")
            match = pattern.search(line)
            if not match:
                continue
            action = match.group(1)
            package = package_base(match.group(2))
            date = line[1:line.find("]")] if line.startswith("[") else ""
            lifecycle.append((
                date, sequence, package, action,
                current_command or f"{action} {package}",
            ))
            sequence += 1
    retained: dict[str, tuple[str, str]] = {}
    for date, _sequence, package, action, command in sorted(lifecycle):
        if action == "removed":
            retained.pop(package, None)
        elif action == "installed" or (
                action == "reinstalled" and package not in retained):
            retained.setdefault(package, (date, command))
    return retained


def parse_zypper_history(
        text: str, target: str,
) -> tuple[str, str] | None:
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        if (len(fields) >= 7 and fields[1].casefold() == "install"
                and package_base(fields[2]) == package_base(target)):
            repository = fields[6].strip()
            detail = (
                f"installed from {repository}"
                if repository else f"installed {package_base(target)}"
            )
            return fields[0].strip(), detail
    return None


@lru_cache(maxsize=64)
def zypper_history_event(target: str) -> tuple[str, str] | None:
    return zypper_history_index().get(package_base(target))


@lru_cache(maxsize=1)
def zypper_history_index() -> dict[str, tuple[str, str]]:
    try:
        paths = list(Path("/var/log/zypp").glob("history*"))
    except OSError:
        return {}
    lifecycle: list[tuple[str, int, str, str, str]] = []
    sequence = 0
    for path in paths:
        for line in read_history_file(path).splitlines():
            if not line or line.startswith("#"):
                continue
            fields = line.split("|")
            if len(fields) < 3 or fields[1].casefold() not in {
                    "install", "remove", "uninstall"}:
                continue
            package = package_base(fields[2])
            action = fields[1].casefold()
            repository = fields[6].strip() if len(fields) >= 7 else ""
            detail = (
                f"installed from {repository}"
                if repository else f"installed {package}"
            )
            lifecycle.append((
                fields[0].strip(), sequence, package, action, detail,
            ))
            sequence += 1
    retained: dict[str, tuple[str, str]] = {}
    for date, _sequence, package, action, detail in sorted(lifecycle):
        if action in {"remove", "uninstall"}:
            retained.pop(package, None)
        else:
            retained.setdefault(package, (date, detail))
    return retained


def parse_legacy_rpm_history_info(
        text: str, target: str,
) -> str:
    command = ""
    package_seen = False
    target_pattern = re.compile(
        rf"(?<![A-Za-z0-9+.-]){re.escape(package_base(target))}"
        r"(?:[.-][A-Za-z0-9_+~:-]+)*")
    for line in text.splitlines():
        key, separator, value = line.partition(":")
        if separator and key.strip().casefold() in {
                "command line", "commandline"}:
            command = value.strip()
        if re.search(r"(?i)\binstall(?:ed)?\b", line) \
                and target_pattern.search(line):
            package_seen = True
    return command if package_seen else ""


@lru_cache(maxsize=128)
def legacy_rpm_history_event(
        manager: str, target: str,
) -> tuple[str, str] | None:
    output = capture([manager, "-q", "history", "list", target])
    transaction_ids: set[int] = set()
    for line in output.splitlines():
        first = line.split("|", 1)[0].strip().lstrip("*")
        if first.isdigit():
            transaction_ids.add(int(first))
    for transaction_id in sorted(transaction_ids):
        command = parse_legacy_rpm_history_info(
            capture([
                manager, "-q", "history", "info", str(transaction_id),
            ]),
            target,
        )
        if command:
            return str(transaction_id), command
    return None


@lru_cache(maxsize=64)
def flatpak_history_entries(
        scope: str, installation: str = "",
) -> tuple[dict[str, object], ...]:
    scope_option = (
        f"--installation={installation}" if installation else f"--{scope}")
    try:
        history = json.loads(capture([
            "flatpak", "history", scope_option, "--json",
        ]))
    except (json.JSONDecodeError, TypeError):
        history = []
    return tuple(
        entry for entry in history
        if isinstance(entry, dict)
    ) if isinstance(history, list) else ()


@lru_cache(maxsize=64)
def flatpak_install_evidence(
        ident: str, scope: str, installation: str = "",
) -> tuple[str, str]:
    origin = next((
        item.origin for item in flatpak_inventory(scope, installation)
        if item.ident == ident
    ), "")
    if not origin:
        scope_option = (
            f"--installation={installation}" if installation else f"--{scope}")
        origin = capture([
            "flatpak", "info", scope_option, "--show-origin", ident,
        ]).strip()
    event: dict[str, object] | None = None
    for entry in flatpak_history_entries(scope, installation):
        if entry.get("application") != ident:
            continue
        change = str(entry.get("change", "")).casefold()
        if change == "uninstall":
            event = None
        elif change == "deploy install":
            event = entry
    if event:
        remote = str(event.get("remote") or origin)
        time = str(event.get("time") or "")
        detail = f"Flatpak history{f' {time}' if time else ''}: install {ident}"
        return remote, detail
    return origin, ""


@lru_cache(maxsize=64)
def snap_install_evidence(ident: str) -> tuple[str, str, str]:
    info = capture(["snap", "info", ident])
    tracking = ""
    publisher = ""
    for line in info.splitlines():
        key, separator, value = line.partition(":")
        if not separator:
            continue
        if key.strip().casefold() == "tracking":
            tracking = value.strip()
        elif key.strip().casefold() == "publisher":
            publisher = value.strip()
    change = ""
    for line in snap_changes():
        fields = line.split(maxsplit=4)
        if (
                len(fields) == 5
                and ident.casefold() in fields[4].casefold()
                and re.search(r"\binstall\b", fields[4], flags=re.IGNORECASE)
        ):
            change = f"snap change {fields[0]}: {fields[4]}"
            break
    return tracking, publisher, change


@lru_cache(maxsize=1)
def snap_changes() -> tuple[str, ...]:
    return tuple(capture(["snap", "changes"]).splitlines()[1:])


@lru_cache(maxsize=64)
def homebrew_install_evidence(
        kind: str, ident: str,
) -> tuple[str, bool | None]:
    retained = homebrew_installed_metadata().get((kind, ident))
    if retained:
        return retained[1], retained[2]
    try:
        payload = json.loads(capture(["brew", "info", "--json=v2", ident]))
    except (json.JSONDecodeError, TypeError):
        return "", None
    key = "casks" if kind == "Homebrew Cask" else "formulae"
    entries = payload.get(key, []) if isinstance(payload, dict) else []
    if not isinstance(entries, list) or not entries:
        return "", None
    details = entries[0] if isinstance(entries[0], dict) else {}
    tap = str(details.get("tap") or "")
    installed = details.get("installed", [])
    requested: bool | None = None
    if isinstance(installed, list) and installed:
        latest = installed[-1] if isinstance(installed[-1], dict) else {}
        raw_requested = latest.get("installed_on_request")
        if isinstance(raw_requested, bool):
            requested = raw_requested
    return tap, requested


def nix_profile_paths() -> tuple[str, ...]:
    paths = [""]
    candidates = [
        Path.home() / ".local/state/nix/profiles",
        Path("/nix/var/nix/profiles/per-user") / os.environ.get("USER", ""),
    ]
    for directory in candidates:
        try:
            children = list(directory.iterdir())
        except OSError:
            continue
        for child in children[:128]:
            if child.name.endswith("-link") or child.name == "profile":
                paths.append(str(child.absolute()))
    return tuple(dict.fromkeys(paths))


@lru_cache(maxsize=128)
def nix_profile_metadata(profile: str = "") -> dict[str, dict[str, object]]:
    command = ["nix", "profile", "list"]
    if profile:
        command.extend(["--profile", profile])
    command.append("--json")
    try:
        payload = json.loads(capture(command))
    except (json.JSONDecodeError, TypeError):
        return {}
    elements = payload.get("elements", payload) if isinstance(payload, dict) else {}
    return {
        ident: metadata for ident, metadata in elements.items()
        if isinstance(ident, str) and isinstance(metadata, dict)
    } if isinstance(elements, dict) else {}


