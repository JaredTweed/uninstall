@synchronized_lru_cache(maxsize=1)
def swupd_inventory() -> tuple[PackageRecord, ...]:
    if not shutil.which("swupd"):
        return ()
    code, output = capture_any([
        "swupd", "bundle-list", "--status", "--quiet",
    ], timeout=30)
    if code != 0:
        return ()
    records: list[PackageRecord] = []
    for line in output.splitlines():
        raw = line.strip()
        if not raw:
            continue
        name, separator, status = raw.partition(":")
        if not name.strip():
            continue
        retained_status = status.casefold() if separator else "installed"
        if "installed" not in retained_status:
            continue
        role = (
            "explicit" if "explicitly installed" in retained_status
            else "dependency"
        )
        records.append(PackageRecord(name.strip(), origin=role))
    return tuple(records)


