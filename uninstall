@lru_cache(maxsize=1)
def pacman_reverse_graph() -> tuple[dict[str, set[str]], bool]:
    inventory = pacman_inventory()
    if not inventory:
        return {}, False
    reverse: dict[str, set[str]] = defaultdict(set)
    for record in inventory:
        package = record.get("Name", "")
        required_by = record.get("Required By", "")
        if not package or required_by == "None":
            continue
        for dependent in required_by.split():
            reverse[package].add(dependent)
    return dict(reverse), True


def root_paths(
        target: str, reverse: dict[str, set[str]], explicit: set[str],
        max_roots: int = 8, max_depth: int = 10,
) -> tuple[list[list[str]], bool]:
    roots: list[list[str]] = []
    queue: deque[list[str]] = deque([[target]])
    visited_depth: dict[str, int] = {target: 0}
    complete = True
    while queue and len(roots) < max_roots:
        path = queue.popleft()
        node = path[-1]
        depth = len(path) - 1
        for dependent in sorted(reverse.get(node, set())):
            if dependent in path:
                continue
            next_path = path + [dependent]
            if dependent in explicit and dependent != target:
                roots.append(list(reversed(next_path)))
                if len(roots) >= max_roots:
                    complete = not queue
                    break
            elif depth + 1 < max_depth:
                previous = visited_depth.get(dependent)
                if previous is None or depth + 1 <= previous:
                    visited_depth[dependent] = depth + 1
                    queue.append(next_path)
            else:
                complete = False
    if queue:
        complete = False
    return roots, complete


def relationship_root_paths(
        target: str, reverse: dict[str, set[str]],
        relations: dict[tuple[str, str], set[str]], explicit: set[str],
) -> tuple[list[tuple[list[str], list[str]]], bool]:
    paths, complete = root_paths(target, reverse, explicit)
    priority = {
        "requires": 0,
        "recommends": 1,
        "suggests": 2,
        "is supplemented by": 3,
        "is enhanced by": 4,
    }
    detailed: list[tuple[list[str], list[str]]] = []
    for nodes in paths:
        labels: list[str] = []
        # itertools.pairwise is unavailable on the supported Python 3.8.
        for parent, child in zip(nodes, nodes[1:]):  # noqa: RUF007
            choices = relations.get((child, parent), {"related to"})
            labels.append(min(
                choices, key=lambda value: priority.get(value, 99)))
        detailed.append((nodes, labels))
    return detailed, complete


_DNF_HISTORY_DETAILS: dict[int, dict[str, object]] = {}
_DNF_INSTALL_RECORDS: dict[str, DnfInstallRecord | None] = {}
_DNF_HISTORY_LOCK = Lock()


def dnf_history_transactions(
        transaction_ids: Iterable[int],
) -> dict[int, dict[str, object]]:
    requested = tuple(dict.fromkeys(transaction_ids))
    missing = [
        transaction_id for transaction_id in requested
        if transaction_id not in _DNF_HISTORY_DETAILS
    ]
    if missing:
        try:
            details = json.loads(capture([
                "dnf5", "history", "info",
                *(str(transaction_id) for transaction_id in missing),
                "--json",
            ]))
        except (json.JSONDecodeError, TypeError):
            details = []
        if isinstance(details, list):
            for detail in details:
                if (isinstance(detail, dict)
                        and isinstance(detail.get("id"), int)):
                    _DNF_HISTORY_DETAILS[detail["id"]] = detail
    return {
        transaction_id: _DNF_HISTORY_DETAILS[transaction_id]
        for transaction_id in requested
        if transaction_id in _DNF_HISTORY_DETAILS
    }


@lru_cache(maxsize=64)
def dnf_history_transaction(transaction_id: int) -> dict[str, object] | None:
    return dnf_history_transactions((transaction_id,)).get(transaction_id)


def prefetch_dnf_install_records(targets: Iterable[str]) -> None:
    requested = tuple(dict.fromkeys(package_base(target) for target in targets))
    unresolved = [
        target for target in requested if target not in _DNF_INSTALL_RECORDS
    ]
    if not unresolved or not shutil.which("dnf5"):
        return
    with _DNF_HISTORY_LOCK:
        unresolved = [
            target for target in unresolved
            if target not in _DNF_INSTALL_RECORDS
        ]
        if not unresolved:
            return
        try:
            transactions = json.loads(capture([
                "dnf5", "history", "list",
                "--contains-pkgs=" + ",".join(unresolved), "--json",
            ]))
        except (json.JSONDecodeError, TypeError):
            transactions = []
        valid = [
            transaction for transaction in transactions
            if isinstance(transaction, dict)
            and isinstance(transaction.get("id"), int)
        ] if isinstance(transactions, list) else []
        summaries = {
            transaction["id"]: transaction for transaction in valid
        }
        details = dnf_history_transactions(summaries)
        unresolved_set = set(unresolved)
        lifecycle: dict[str, DnfInstallRecord] = {}
        for transaction_id in sorted(details):
            detail = details[transaction_id]
            packages = detail.get("packages", [])
            if not isinstance(packages, list):
                continue
            raw_groups = detail.get("groups", [])
            raw_environments = detail.get("environments", [])
            groups = tuple(
                str(group.get("group"))
                for group in raw_groups
                if isinstance(group, dict)
                and str(group.get("action", "")).casefold() == "install"
                and isinstance(group.get("group"), str)
            ) if isinstance(raw_groups, list) else ()
            environments = tuple(
                str(environment.get("environment"))
                for environment in raw_environments
                if isinstance(environment, dict)
                and str(
                    environment.get("action", "")).casefold() == "install"
                and isinstance(environment.get("environment"), str)
            ) if isinstance(raw_environments, list) else ()
            for package in packages:
                if not isinstance(package, dict):
                    continue
                raw_name = package.get("name")
                nevra = package.get("nevra", "")
                match = (
                    re.match(r"^(.*)-\d+:", nevra)
                    if isinstance(nevra, str) else None
                )
                target = (
                    package_base(str(raw_name)) if raw_name else
                    match.group(1) if match else ""
                )
                if target not in unresolved_set:
                    continue
                action = str(package.get("action", "")).casefold()
                if action in {"remove", "removed", "erase", "erased"}:
                    lifecycle.pop(target, None)
                    continue
                if action not in {
                        "install", "installed", "reinstall", "reinstalled"}:
                    continue
                if target in lifecycle and action in {"reinstall", "reinstalled"}:
                    continue
                summary = summaries.get(transaction_id, {})
                command = str(
                    detail.get("description")
                    or summary.get("command_line")
                    or "unknown command"
                )
                lifecycle.setdefault(target, DnfInstallRecord(
                    transaction_id,
                    command,
                    str(package.get("reason") or "unknown reason"),
                    groups,
                    environments,
                    str(package.get("repository") or ""),
                ))
        _DNF_INSTALL_RECORDS.update(lifecycle)
        for target in unresolved:
            _DNF_INSTALL_RECORDS.setdefault(target, None)


@lru_cache(maxsize=64)
def dnf_install_record(target: str) -> DnfInstallRecord | None:
    target = package_base(target)
    prefetch_dnf_install_records((target,))
    return _DNF_INSTALL_RECORDS.get(target)


@lru_cache(maxsize=64)
def dnf_history_reason(target: str) -> str:
